<Page x:Class="UnifiedPhotoBooth.AppStartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UnifiedPhotoBooth"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="AppStartPage">

    <Grid Background="Black">
        <!-- Главный контейнер для центрирования содержимого -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="800" Height="400">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Кнопка Photo -->
            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="btnTakePhoto" Width="200" Height="200" 
                        Click="BtnTakePhoto_Click"
                        Style="{x:Null}"
                        Background="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse Fill="{TemplateBinding Background}" 
                                        Stroke="Transparent" 
                                        StrokeThickness="0"/>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Camera Icon -->
                                    <Viewbox Width="80" Height="80">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="Black" 
                                                  Data="M12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"/>
                                            <Path Fill="Black" 
                                                  Data="M4,5H7L9,3H15L17,5H20A2,2 0 0,1 22,7V19A2,2 0 0,1 20,21H4A2,2 0 0,1 2,19V7A2,2 0 0,1 4,5Z"/>
                                            <Path Fill="White" 
                                                  Data="M12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16Z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F0F0"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#E0E0E0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
                <!-- Подпись Photo -->
                <TextBlock Text="Photo" 
                          Foreground="White" 
                          FontSize="28" 
                          FontWeight="Normal"
                          HorizontalAlignment="Center" 
                          Margin="0,30,0,0"/>
            </StackPanel>
            
            <!-- Кнопка Gallery -->
            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="btnGallery" Width="200" Height="200" 
                        Click="BtnGallery_Click"
                        Style="{x:Null}"
                        Background="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse Fill="{TemplateBinding Background}" 
                                        Stroke="Transparent" 
                                        StrokeThickness="0"/>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Gallery Icon -->
                                    <Viewbox Width="80" Height="80">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="Black" 
                                                  Data="M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2M6,20H15L12,16L9,19L6,16V20Z"/>
                                            <Rectangle Width="16" Height="12" Canvas.Left="4" Canvas.Top="6" Fill="Transparent" Stroke="Black" StrokeThickness="1.5"/>
                                            <Rectangle Width="12" Height="8" Canvas.Left="6" Canvas.Top="8" Fill="Transparent" Stroke="Black" StrokeThickness="1"/>
                                            <Rectangle Width="8" Height="5" Canvas.Left="8" Canvas.Top="10" Fill="Transparent" Stroke="Black" StrokeThickness="0.8"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F0F0"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#E0E0E0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
                <!-- Подпись Gallery -->
                <TextBlock Text="Gallery" 
                          Foreground="White" 
                          FontSize="28" 
                          FontWeight="Normal"
                          HorizontalAlignment="Center" 
                          Margin="0,30,0,0"/>
            </StackPanel>
        </Grid>
        
        <!-- Информация о событии в нижней части экрана -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,50">
            <TextBlock x:Name="txtEventName" 
                      Text="Current Event" 
                      Foreground="#888888" 
                      FontSize="18" 
                      HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>