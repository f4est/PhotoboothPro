<Window x:Class="UnifiedPhotoBooth.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UnifiedPhotoBooth"
        mc:Ignorable="d"
        Title="AI Photo Booth Pro" Height="720" Width="1280" 
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="Black">
        
    <Window.Resources>
        <!-- Стиль для кнопок меню -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2A2A2A" Offset="0"/>
                        <GradientStop Color="#1E1E1E" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="10,5,10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="#444444">
                            <ContentPresenter HorizontalAlignment="Left" 
                                            VerticalAlignment="Center" 
                                            Margin="15,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#3A3A3A" Offset="0"/>
                                            <GradientStop Color="#2E2E2E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00BFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#1A1A1A" Offset="0"/>
                                            <GradientStop Color="#0E0E0E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Стиль для активной кнопки меню -->
        <Style x:Key="ActiveMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00BFFF" Offset="0"/>
                        <GradientStop Color="#0099CC" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель в стиле AI Photo Booth Pro -->
        <Border x:Name="sidePanel" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1A1A1A" Offset="0"/>
                    <GradientStop Color="#2A2A2A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Заголовок приложения -->
                <StackPanel Grid.Row="0" Margin="20,30,20,20">
                    <TextBlock Text="AI Photo Booth Pro" 
                              FontSize="24" 
                              FontWeight="Bold" 
                              Foreground="White" 
                              HorizontalAlignment="Left"/>
                    <TextBlock Text="Professional Photo Solution" 
                              FontSize="12" 
                              Foreground="#00BFFF" 
                              HorizontalAlignment="Left"
                              Margin="0,5,0,0"/>
                </StackPanel>
                
                <!-- Разделитель -->
                <Rectangle Grid.Row="1" Height="1" Fill="#444444" Margin="20,0"/>
                
                <!-- Список разделов настроек -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" Margin="0,20,0,0">
                    <StackPanel>
                        <!-- Event Management -->
                        <Button x:Name="btnEventsSection" 
                                Style="{StaticResource MenuButtonStyle}"
                                Click="BtnSettingsSection_Click" 
                                Tag="Events">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎪" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Event Management" FontSize="16"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Camera Settings -->
                        <Button x:Name="btnCameraSection" 
                                Style="{StaticResource MenuButtonStyle}"
                                Click="BtnSettingsSection_Click" 
                                Tag="Camera">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📷" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Camera Settings" FontSize="16"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Photo Booth -->
                        <Button x:Name="btnPhotoBoothSection" 
                                Style="{StaticResource MenuButtonStyle}"
                                Click="BtnSettingsSection_Click" 
                                Tag="PhotoBooth">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📸" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Photo Booth" FontSize="16"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Video Booth -->
                        <Button x:Name="btnVideoBoothSection" 
                                Style="{StaticResource MenuButtonStyle}"
                                Click="BtnSettingsSection_Click" 
                                Tag="VideoBooth">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎥" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Video Booth" FontSize="16"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Print Settings -->
                        <Button x:Name="btnPrinterSection" 
                                Style="{StaticResource MenuButtonStyle}"
                                Click="BtnSettingsSection_Click" 
                                Tag="Printer">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨️" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Print Settings" FontSize="16"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- QR Code -->
                        <Button x:Name="btnQrCodeSection" 
                                Style="{StaticResource MenuButtonStyle}"
                                Click="BtnSettingsSection_Click" 
                                Tag="QrCode">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📱" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="QR Code Settings" FontSize="16"/>
                            </StackPanel>
                        </Button>

                         <!-- Position Setup -->
                         <Button x:Name="btnPositionSetup"
                                 Style="{StaticResource MenuButtonStyle}"
                                 Click="BtnOpenPositionSetup_Click">
                             <StackPanel Orientation="Horizontal">
                                 <TextBlock Text="🧩" FontSize="18" Margin="0,0,10,0"/>
                                 <TextBlock Text="Position Setup" FontSize="16"/>
                             </StackPanel>
                         </Button>
                    </StackPanel>
                </ScrollViewer>
                
                <!-- Разделитель перед кнопкой запуска -->
                <Rectangle Grid.Row="3" Height="1" Fill="#444444" Margin="20,20"/>
                
                <!-- Кнопка запуска приложения -->
                <Button x:Name="btnStartApp" 
                        Grid.Row="4"
                        Content="Start the App" 
                        FontSize="18" 
                        FontWeight="Bold"
                        Height="60"
                        Margin="20,20,20,30"
                        Cursor="Hand"
                        Click="BtnStartApp_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00BFFF" Offset="0"/>
                            <GradientStop Color="#0099CC" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    CornerRadius="15"
                                    BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                VerticalAlignment="Center"/>
                                <Border.Effect>
                                    <DropShadowEffect Color="#00BFFF" 
                                                      Direction="270" 
                                                      ShadowDepth="0" 
                                                      BlurRadius="10" 
                                                      Opacity="0.5"/>
                                </Border.Effect>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#33CCFF" Offset="0"/>
                                                <GradientStop Color="#00AADD" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#0088BB" Offset="0"/>
                                                <GradientStop Color="#006699" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground>
                        <SolidColorBrush Color="White"/>
                    </Button.Foreground>
                </Button>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <Border Grid.Column="1" Background="#F5F5F5">
            <Grid>
                <!-- Основной фрейм для контента настроек -->
                <Frame x:Name="MainFrame" 
                       NavigationUIVisibility="Hidden" 
                       Background="Transparent"/>
                       
                <!-- Область для кликов для выхода из полноэкранного режима -->
                <Rectangle x:Name="CornerClickArea" 
                          HorizontalAlignment="Right" 
                          VerticalAlignment="Top"
                          Width="100" 
                          Height="100" 
                          Fill="Transparent" 
                          Visibility="Collapsed"
                          MouseLeftButtonDown="CornerClickArea_MouseLeftButtonDown"/>
            </Grid>
        </Border>
    </Grid>
</Window>