<Page x:Class="UnifiedPhotoBooth.AppLauncherPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UnifiedPhotoBooth"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="AppLauncher">

    <Grid Background="#212121">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Заголовок -->
        <TextBlock Text="Выберите действие" Grid.Row="0" 
                   FontSize="36" FontWeight="Bold" Foreground="White"
                   HorizontalAlignment="Center" Margin="0,40,0,40"/>
        
        <!-- Кнопки действий -->
        <WrapPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="btnPhoto" Margin="30" Width="250" Height="250" Click="BtnPhoto_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="15"/>
                    </Style>
                </Button.Resources>
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4CAF50" Offset="0"/>
                        <GradientStop Color="#2E7D32" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <StackPanel>
                    <TextBlock Text="📷" FontSize="100" HorizontalAlignment="Center"/>
                    <TextBlock Text="Сделать фото" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            
            <Button x:Name="btnGallery" Margin="30" Width="250" Height="250" Click="BtnGallery_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="15"/>
                    </Style>
                </Button.Resources>
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#9C27B0" Offset="0"/>
                        <GradientStop Color="#6A1B9A" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <StackPanel>
                    <TextBlock Text="🖼️" FontSize="100" HorizontalAlignment="Center"/>
                    <TextBlock Text="Галерея" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </WrapPanel>
        
        <!-- Нижняя панель информации -->
        <TextBlock x:Name="txtEventName" Grid.Row="2" 
                   Text="Событие: не выбрано" 
                   FontSize="18" FontWeight="Bold" Foreground="#CCCCCC"
                   HorizontalAlignment="Center" Margin="0,20,0,40"/>
    </Grid>
</Page>