<Page x:Class="UnifiedPhotoBooth.PhotoBoothPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UnifiedPhotoBooth"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Фотобудка">

    <Grid Background="Black">
        <!-- Полноэкранный предпросмотр камеры -->
        <Image x:Name="imgPreview" Stretch="UniformToFill"/>
        
        <!-- Результирующая фотография (показывается после съемки) -->
        <Image x:Name="imgResult" Stretch="UniformToFill" Visibility="Collapsed"/>
        
        <!-- Таймер обратного отсчета -->
        <Grid x:Name="gridCountdown" Visibility="Collapsed">
            <Ellipse Width="300" Height="300" 
                     Fill="Black" 
                     Opacity="0.7"
                     HorizontalAlignment="Center" 
                     VerticalAlignment="Center"/>
            <Border Width="250" Height="250" 
                    BorderBrush="#00BFFF" 
                    BorderThickness="8" 
                    CornerRadius="125"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <TextBlock x:Name="txtCountdown" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center"
                          FontSize="120" 
                          FontWeight="Bold" 
                          Foreground="White"
                          Text="3"/>
            </Border>
        </Grid>
        
        <!-- QR-код (показывается после всех фотографий) -->
        <Grid x:Name="gridQrCode" Visibility="Collapsed">
            <Rectangle Fill="Black" Opacity="0.8"/>
            <Border Background="White" 
                    CornerRadius="20" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Padding="40">
                <StackPanel>
                    <TextBlock Text="Отсканируйте QR-код для получения фотографий" 
                              FontSize="24" 
                              FontWeight="Bold"
                              Foreground="Black"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,20"/>
                    <Image x:Name="imgQrCode" 
                           Width="300" 
                           Height="300" 
                           HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtQrCodeUrl" 
                              FontSize="16" 
                              Margin="0,20,0,0" 
                              Foreground="#666666"
                              HorizontalAlignment="Center"
                              TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Скрытая кнопка для начала съемки (на весь экран) -->
        <Button x:Name="btnStartShooting" 
                Background="Transparent" 
                BorderThickness="0"
                Click="BtnStartShooting_Click"
                Cursor="Hand"
                Visibility="Visible">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <!-- Индикатор "нажмите для начала" -->
                        <StackPanel HorizontalAlignment="Center" 
                                   VerticalAlignment="Bottom" 
                                   Margin="0,0,0,100">
                            <TextBlock Text="Нажмите в любое место экрана для начала съемки" 
                                      FontSize="28" 
                                      FontWeight="Bold"
                                      Foreground="White" 
                                      HorizontalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" Direction="320" ShadowDepth="3" Opacity="0.8"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="📸" 
                                      FontSize="60" 
                                      HorizontalAlignment="Center"
                                      Margin="0,20,0,0">
                    <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" Direction="320" ShadowDepth="3" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>
                        </StackPanel>
        </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        
        <!-- Кнопка возврата к главному экрану (появляется после QR-кода) -->
        <Border Background="#00BFFF" 
                CornerRadius="15"
                HorizontalAlignment="Center" 
                VerticalAlignment="Bottom"
                Margin="0,0,0,50"
                Visibility="Collapsed"
                x:Name="btnBackToMenuBorder">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="320" ShadowDepth="5" Opacity="0.5"/>
            </Border.Effect>
            <Button x:Name="btnBackToMenu" 
                    Content="Вернуться к главному меню" 
                    FontSize="24" 
                    FontWeight="Bold"
                    Background="Transparent" 
                    Foreground="White"
                    BorderThickness="0"
                    Padding="30,15"
                    Click="BtnBackToMenu_Click"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Button.Template>
                    </Button>
        </Border>
    </Grid>
</Page> 