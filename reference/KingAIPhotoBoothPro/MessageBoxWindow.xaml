<Window
	x:Class="KingAIPhotoBoothPro.MessageBoxWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:KingAIPhotoBoothPro" xmlns:math="http://hexinnovation.com/math"
	ResizeMode="NoResize"
	AllowsTransparency="True"
	Title="MessageBoxWindow"
	Height="2560"
	Width="1440"
	Topmost="True"
	Background="#80000000"
	WindowStyle="None"
	WindowStartupLocation="CenterScreen"
	WindowState="Maximized"
	Loaded="Window_Loaded"
	Unloaded="Window_Unloaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<math:MathConverter
				x:Key="math" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="WindowGrid">
		<Grid
			Name="mainGrid"
			Row="1"
			Width="{Binding ElementName=WindowGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.35}"
			Height="{Binding ElementName=mainGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.7}">
			<Border
				Name="borderSmooth"
				Background="#FFFFFF"
				Margin="15"
				CornerRadius="{DynamicResource BannerCornerRadius}">
				<UIElement.Effect>
					<DropShadowEffect
						Opacity="0.25"
						BlurRadius="20"
						ShadowDepth="10" />
				</UIElement.Effect>
			</Border>
			<Grid
				Margin="10">
				<Grid.RowDefinitions>
					<RowDefinition
						Height="2*" />
					<RowDefinition
						Height="5*" />
					<RowDefinition
						Height="3*" />
					<RowDefinition
						Height="8*" />
					<RowDefinition
						Height="5*" />
					<RowDefinition
						Height="1*" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="1*" />
					<ColumnDefinition
						Width="10*" />
					<ColumnDefinition
						Width="1*" />
				</Grid.ColumnDefinitions>
				<Image
					Name="iconImage"
					Grid.Row="1"
					Grid.Column="1"
					Source="/Images/Error.png"
					Margin="{Binding ElementName=SingleGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*.02}" />
				<Viewbox
					Grid.Row="2"
					Grid.Column="1">
					<TextBlock
						Name="txtTitle"
						Grid.Row="2"
						Grid.Column="1"
						FontFamily="{DynamicResource PromptBold}"
						FontWeight="Bold"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						TextAlignment="Center"
						FontSize="{DynamicResource FontSizeHeading2}">Thank you for your request.<LineBreak />We are unable to continue the process.</TextBlock>
				</Viewbox>
				<ScrollViewer
					Grid.Column="1"
					Grid.Row="3">
					<TextBox
						Name="txtDesc"
						Grid.Column="1"
						Grid.Row="3"
						Margin="5"
						TextWrapping="Wrap"
						HorizontalAlignment="Center"
						VerticalAlignment="Top"
						TextAlignment="Center"
						FontSize="{DynamicResource FontSizeTextRegular}"
						FontFamily="{DynamicResource PromptRegular}"
						BorderThickness="0"
						IsReadOnly="True" />
				</ScrollViewer>
				<Grid
					Name="SingleGrid"
					Visibility="Visible"
					Row="4"
					Column="1">
					<Button
						Name="btnSingle"
						x:Uid="0"
						Grid.Row="4"
						Grid.Column="1"
						BorderThickness="0"
						VerticalAlignment="Stretch"
						FontSize="{DynamicResource FontSizeButtonPrimary}"
						Content="Try Again"
						Height="{DynamicResource UIInputHeight}"
						Foreground="#FFFFFFFF"
						FontFamily="{StaticResource MontserratRegular}"
						Background="{DynamicResource UIBlueButton}"
						Width="{Binding ElementName=SingleGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*.4}"
						Click="btn_Click">
						<UIElement.Effect>
							<DropShadowEffect
								Opacity="0.25"
								BlurRadius="20"
								ShadowDepth="10" />
						</UIElement.Effect>
						<FrameworkElement.Style>
							<Style
								TargetType="{x:Type Button}">
								<Setter
									Property="Background"
									Value="#FFFFFFFF" />
								<Setter
									Property="Template">
									<Setter.Value>
										<ControlTemplate
											TargetType="{x:Type Button}">
											<Border
												Background="{TemplateBinding Background}"
												CornerRadius="{DynamicResource BannerCornerRadius}">
												<ContentPresenter
													HorizontalAlignment="Center"
													VerticalAlignment="Center" />
											</Border>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
								<Style.Triggers>
									<Trigger
										Property="UIElement.IsMouseOver"
										Value="True">
										<Setter
											Property="UIElement.Opacity"
											Value="0.7" />
									</Trigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
					</Button>
				</Grid>
				<Grid
					Name="MultiGrid"
					Visibility="Hidden"
					Row="4"
					Column="1"
					Height="{DynamicResource UIInputHeight}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="1*" />
						<ColumnDefinition
							Width="1*" />
					</Grid.ColumnDefinitions>
					<Button
						Name="btnMulti1"
						x:Uid="0"
						BorderThickness="2"
						VerticalAlignment="Stretch"
						FontSize="{DynamicResource FontSizeButtonPrimary}"
						Margin="10,0,10,0"
						Content="Cancel"
						Foreground="{DynamicResource UIBlueButton}"
						FontFamily="{StaticResource MontserratRegular}"
						BorderBrush="{DynamicResource UIBlueButton}"
						Click="btn_Click">
						<UIElement.Effect>
							<DropShadowEffect
								Opacity="0.25"
								BlurRadius="20"
								ShadowDepth="10" />
						</UIElement.Effect>
						<FrameworkElement.Style>
							<Style
								TargetType="{x:Type Button}">
								<Setter
									Property="Background"
									Value="#FFFFFFFF" />
								<Setter
									Property="Template">
									<Setter.Value>
										<ControlTemplate
											TargetType="{x:Type Button}">
											<Border
												Background="{TemplateBinding Background}"
												BorderThickness="{TemplateBinding BorderThickness}"
												BorderBrush="{DynamicResource UIBlueButton}"
												CornerRadius="{DynamicResource BannerCornerRadius}">
												<ContentPresenter
													HorizontalAlignment="Center"
													VerticalAlignment="Center" />
											</Border>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
								<Style.Triggers>
									<Trigger
										Property="UIElement.IsMouseOver"
										Value="True">
										<Setter
											Property="Background"
											Value="#333B82F6" />
									</Trigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
					</Button>
					<Button
						Name="btnMulti2"
						x:Uid="1"
						Grid.Column="1"
						VerticalAlignment="Stretch"
						FontSize="{DynamicResource FontSizeButtonPrimary}"
						Margin="10,0,10,0"
						Content="Cancel"
						Foreground="{DynamicResource UIBlueButton}"
						FontFamily="{StaticResource MontserratRegular}"
						BorderThickness="2"
						Click="btn_Click">
						<UIElement.Effect>
							<DropShadowEffect
								Opacity="0.25"
								BlurRadius="20"
								ShadowDepth="10" />
						</UIElement.Effect>
						<FrameworkElement.Style>
							<Style
								TargetType="{x:Type Button}">
								<Setter
									Property="Background"
									Value="#FFFFFFFF" />
								<Setter
									Property="Template">
									<Setter.Value>
										<ControlTemplate
											TargetType="{x:Type Button}">
											<Border
												Background="{TemplateBinding Background}"
												BorderThickness="{TemplateBinding BorderThickness}"
												BorderBrush="{DynamicResource UIBlueButton}"
												CornerRadius="{DynamicResource BannerCornerRadius}">
												<ContentPresenter
													HorizontalAlignment="Center"
													VerticalAlignment="Center" />
											</Border>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
								<Style.Triggers>
									<Trigger
										Property="UIElement.IsMouseOver"
										Value="True">
										<Setter
											Property="Background"
											Value="#333B82F6" />
									</Trigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
					</Button>
				</Grid>
				<Image
					Name="refImage"
					x:Uid="2"
					Visibility="Hidden"
					Grid.RowSpan="8"
					Grid.ColumnSpan="3"
					Opacity="0.2"
					Source="/Images/MessageBoxPrefabRef.png"
					Stretch="Fill">
					<UIElement.OpacityMask>
						<VisualBrush
							Visual="{Binding ElementName=borderSmooth}" />
					</UIElement.OpacityMask>
				</Image>
			</Grid>
		</Grid>
	</Grid>
</Window>
