<Window
	x:Class="KingAIPhotoBoothPro.UpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:math="http://hexinnovation.com/math" xmlns:local="clr-namespace:KingAIPhotoBoothPro" xmlns:class="clr-namespace:KingAIPhotoBoothPro.Class"
	WindowStartupLocation="CenterScreen"
	WindowStyle="none"
	ResizeMode="NoResize"
	Title="UpdateWindow"
	Height="600"
	Width="1000"
	Topmost="True"
	AllowsTransparency="True"
	Background="#00FFFFFF"
	Loaded="Window_Loaded"
	Unloaded="Window_Unloaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<math:MathConverter
				x:Key="math" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="mainGrid"
		MaxHeight="{Binding ElementName=mainGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.6}">
		<Border
			Name="borderBackground"
			BorderBrush="{DynamicResource AppUIColorLight}"
			BorderThickness="5"
			Background="{DynamicResource AppUIColor}"
			CornerRadius="20" />
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="1*" />
				<RowDefinition
					Height="1*" />
				<RowDefinition
					Height="1*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="1*" />
				<ColumnDefinition
					Width="1*" />
				<ColumnDefinition
					Width="1*" />
			</Grid.ColumnDefinitions>
			<Image
				Name="backgroundDImage"
				Grid.Column="1"
				Grid.Row="1"
				Source="/Images/downloadCloud.png"
				Stretch="Uniform" />
		</Grid>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="10*" />
				<ColumnDefinition
					Width="163*" />
				<ColumnDefinition
					Width="27*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="47*" />
				<RowDefinition
					Height="7*" />
				<RowDefinition
					Height="6*" />
				<RowDefinition
					Height="7*" />
			</Grid.RowDefinitions>
			<Grid
				Row="1"
				Column="1">
				<Label
					Name="UIText"
					Foreground="#FFFFFFFF"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					FontSize="{DynamicResource FontSizeTextRegular}">Downloading...</Label>
			</Grid>
			<Grid
				Column="2"
				Row="2">
				<Label
					Name="UILoadingPercent"
					Foreground="#FFFFFFFF"
					Grid.Column="1"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontSize="{DynamicResource FontSizeTextRegular}">%0</Label>
			</Grid>
			<ProgressBar
				Name="progressForDownload"
				Grid.Row="2"
				Grid.Column="1"
				Margin="3" />
		</Grid>
	</Grid>
</Window>
