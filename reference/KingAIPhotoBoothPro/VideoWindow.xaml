<Window
	x:Class="KingAIPhotoBoothPro.VideoWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:KingAIPhotoBoothPro" xmlns:wpf="clr-namespace:Vlc.DotNet.Wpf;assembly=Vlc.DotNet.Wpf" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
	Title="VideoWindow"
	Height="450"
	Width="800"
	Topmost="True"
	WindowStartupLocation="CenterScreen"
	WindowStyle="ToolWindow"
	Loaded="Window_Loaded">
	<Grid
		Background="#FF000000">
		<xctk:RangeSlider
			Minimum="0"
			Maximum="100"
			Step="1"
			LowerValue="10"
			HigherValue="20" />
	</Grid>
</Window>
