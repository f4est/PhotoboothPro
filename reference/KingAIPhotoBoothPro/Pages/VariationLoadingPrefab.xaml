<Page
	x:Class="KingAIPhotoBoothPro.Pages.VariationLoadingPrefab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages" xmlns:math="http://hexinnovation.com/math"
	Name="pageMain"
	Title="VariationLoadingPrefab">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<math:MathConverter
				x:Key="math" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="gridMain"
		MaxHeight="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*.9}">
		<Image
			Name="imgBackground"
			Source="/Images/loadingsquare.png"
			Stretch="UniformToFill"
			VerticalAlignment="Center"
			HorizontalAlignment="Center" />
		<Border
			Name="borderSmooth"
			Margin="-2"
			BorderThickness="10"
			Background="{DynamicResource UILightOverlay}"
			CornerRadius="{DynamicResource UICornerRadius}">
			<Border.BorderBrush>
				<LinearGradientBrush
					EndPoint="0.5,1"
					StartPoint="0.5,0">
					<GradientStop
						Color="White"
						Offset="0" />
					<GradientStop
						Color="#FFD5D5D5"
						Offset="1" />
				</LinearGradientBrush>
			</Border.BorderBrush>
		</Border>
		<StackPanel
			Orientation="Vertical"
			VerticalAlignment="Center">
			<TextBlock
				Name="txtTitle"
				Style="{DynamicResource SectionHeadingTextStyle}"
				Foreground="#FFFFFFFF"
				HorizontalAlignment="Center" />
			<ProgressBar
				Name="progressBar"
				Style="{StaticResource ProgressBarStyle}"
				Value="90"
				Width="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.8}"
				Height="{Binding ElementName=progressBar, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.1}" />
			<TextBlock
				Name="txtStatus"
				Style="{DynamicResource TextStylePropertyTitle}"
				Foreground="#FFFFFFFF"
				HorizontalAlignment="Center"
				Visibility="Collapsed" />
		</StackPanel>
	</Grid>
</Page>
