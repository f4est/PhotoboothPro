<Window
	x:Class="KingAIPhotoBoothPro.Pages.SecondWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages"
	Title="SecondWindow"
	Height="450"
	Width="800">
	<Grid
		Name="mainGrid">
		<Image
			Name="FullScreenImage"
			Source="/Images/LoginPage/ActivationKingBG.jpg"
			Stretch="UniformToFill"
			VerticalAlignment="Center"
			HorizontalAlignment="Center"
			MouseLeftButtonDown="FullScreenImage_MouseLeftButtonDown" />
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="1*" />
				<RowDefinition
					Height="1*" />
				<RowDefinition
					Height="1*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="1*" />
				<ColumnDefinition
					Width="1*" />
				<ColumnDefinition
					Width="1*" />
				<ColumnDefinition
					Width="1*" />
			</Grid.ColumnDefinitions>
			<Grid
				Name="gridSecondQR"
				Row="3"
				Column="3"
				VerticalAlignment="Center"
				Visibility="Hidden"
				Width="{Binding ElementName=mainGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.15}"
				Height="{Binding ElementName=mainGrid, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.25}">
				<Grid.RowDefinitions>
					<RowDefinition
						Height="{Binding ElementName=gridSecondQR, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.9}" />
					<RowDefinition
						Height="1*" />
				</Grid.RowDefinitions>
				<Border
					Background="#70000000"
					CornerRadius="{DynamicResource BannerCornerRadius}" />
				<Image
					Name="QRCodeImage"
					Stretch="Uniform"
					VerticalAlignment="Center"
					HorizontalAlignment="Center"
					Source="/Images/SharingPage/qr-code-for-scanning-free-vector.jpg"
					Margin="{Binding ElementName=mainGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.010+1}" />
			</Grid>
		</Grid>
	</Grid>
</Window>
