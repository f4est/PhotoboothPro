<Page
	x:Class="KingAIPhotoBoothPro.Pages.DSLR" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:converter="clr-namespace:KingAIPhotoBoothPro.Class" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages" xmlns:class="clr-namespace:KingAIPhotoBoothPro.Class" xmlns:math="http://hexinnovation.com/math" xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
	Focusable="True"
	Title="DSLR"
	Loaded="Page_Loaded"
	Unloaded="Page_Unloaded"
	PreviewKeyDown="Page_KeyDown"
	SizeChanged="Page_SizeChanged">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Style
				TargetType="{x:Type local:HomeButton}"
				x:Key="CustomButtonStyle">
				<Setter
					Property="Background">
					<Setter.Value>
						<ImageBrush
							Stretch="Uniform"
							ImageSource="{Binding ButtonImageSource, RelativeSource={RelativeSource TemplatedParent}}">
							<Brush.RelativeTransform>
								<TransformGroup>
									<ScaleTransform
										CenterX="0.5"
										CenterY="0.5" />
									<SkewTransform
										CenterX="0.5"
										CenterY="0.5" />
									<RotateTransform
										CenterX="0.5"
										CenterY="0.5" />
									<TranslateTransform
										X="0" />
								</TransformGroup>
							</Brush.RelativeTransform>
						</ImageBrush>
					</Setter.Value>
				</Setter>
				<Setter
					Property="FontFamily"
					Value="{StaticResource PromptExtraLight}" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type local:HomeButton}">
							<Border
								Background="{TemplateBinding Background}"
								BorderThickness="0">
								<ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
				<Style.Triggers>
					<Trigger
						Property="UIElement.IsMouseOver"
						Value="True">
						<Setter
							Property="UIElement.Opacity"
							Value="0.7" />
					</Trigger>
					<Trigger
						Property="IsEnabled"
						Value="False">
						<Setter
							Property="Background"
							Value="#FF808080" />
					</Trigger>
				</Style.Triggers>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="gridMain"
		Background="#00FFFFFF">
		<Image
			Name="BackgroundImage" />
		<Grid
			Name="gridF11Warning"
			Opacity="1"
			Visibility="Visible">
			<Border
				BorderBrush="#FFFFFFFF"
				CornerRadius="20"
				Background="#707070"
				VerticalAlignment="Top"
				Margin="50"
				Width="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.3+1}"
				Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.04+1}">
				<TextBlock
					VerticalAlignment="Center"
					HorizontalAlignment="Center"
					TextAlignment="Center"
					Foreground="#FFFFFFFF"
					FontFamily="{StaticResource PromptRegular}"
					FontSize="{DynamicResource FontSizeTextRegular}">Press F11 or click top-right corner 5 times<LineBreak />to return to the Settings</TextBlock>
			</Border>
		</Grid>
		<Grid
			Name="gridQRCode"
			Visibility="Collapsed"
			VerticalAlignment="Bottom"
			Margin="50"
			Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*.16}"
			Width="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*.11}">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="2*" />
				<RowDefinition
					Height="1*" />
			</Grid.RowDefinitions>
			<Border
				Margin="0"
				Grid.ColumnSpan="3"
				Grid.RowSpan="4"
				Background="#AA111111"
				BorderBrush="#FFFFFFFF"
				BorderThickness="5"
				CornerRadius="10" />
			<Border
				Name="qrBackBorder"
				Margin="10"
				Grid.Row="0"
				Background="#FFFFFFFF"
				CornerRadius="5"
				VerticalAlignment="Top"
				Grid.RowSpan="2"
				Height="{Binding ElementName=qrBackBorder, Path=ActualWidth}">
				<Image
					Source="/Images/QR.png"
					Grid.Row="1"
					Grid.Column="1"
					Margin="{Binding ElementName=gridMain, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.001}" />
			</Border>
			<TextBlock
				x:XmlAttributeProperties.XmlSpace="preserve"
				Name="txtScanQR"
				Grid.Row="2"
				TextAlignment="Center"
				Foreground="#FFFFFFFF"
				FontFamily="{StaticResource PromptRegular}"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Grid.Column="1"
				FontSize="{DynamicResource FontSizeTextSmall}">Scan with your 
camera to control from 
your phone</TextBlock>
		</Grid>
		<Grid
			Name="NameSurnameGrid"
			Visibility="Visible"
			VerticalAlignment="Stretch">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="2*" />
				<ColumnDefinition
					Width="9*" />
				<ColumnDefinition
					Width="2*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="2*" />
				<RowDefinition
					Height="1*" />
				<RowDefinition
					Height="20*" />
				<RowDefinition
					Height="1*" />
			</Grid.RowDefinitions>
			<Grid
				Name="NametInputField"
				Visibility="Visible"
				Column="1"
				Row="1">
				<Border
					Name="borderbtnAIImage"
					Style="{DynamicResource BorderInputStyle}" />
				<TextBox
					Name="PromptBox"
					x:Uid="2"
					BorderThickness="0.1"
					HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Center"
					VerticalContentAlignment="Center"
					VerticalAlignment="Center"
					Foreground="#002C3A"
					TextAlignment="Center"
					FontFamily="{StaticResource MontserratRegular}"
					TextWrapping="Wrap"
					AcceptsReturn="True"
					FontSize="{DynamicResource FontSizeHeading2}"
					Padding="10,0,0,0"
					Background="#00FFFFFF"
					Visibility="Visible"
					Height="{Binding ElementName=PromptInputField, Path=ActualHeight}"
					Width="{Binding ElementName=PromptInputField, Path=ActualWidth}"
					TextChanged="PromptBox_TextChanged"
					LostFocus="PromptBox_LostFocus">
					<UIElement.OpacityMask>
						<VisualBrush
							Visual="{Binding ElementName=borderbtnAIImage}" />
					</UIElement.OpacityMask>
				</TextBox>
				<Button
					Name="PromptBoxPlaceholder"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					HorizontalContentAlignment="Center"
					Foreground="#88002C3A"
					FontFamily="{StaticResource PromptRegular}"
					FontSize="{DynamicResource FontSizeHeading2}"
					Content="Name and Surname"
					RenderTransformOrigin="0.,0.5"
					Background="#00FFFFFF"
					BorderBrush="#00707070"
					Width="{Binding ElementName=NametInputField, Path=ActualWidth}"
					Height="{Binding ElementName=NametInputField, Path=ActualHeight}"
					Click="PromptBoxPlaceholder_Click">
					<UIElement.RenderTransform>
						<TransformGroup>
							<ScaleTransform />
							<SkewTransform />
							<RotateTransform />
							<TranslateTransform />
						</TransformGroup>
					</UIElement.RenderTransform>
					<FrameworkElement.Style>
						<Style
							TargetType="{x:Type Button}">
							<Setter
								Property="Background"
								Value="#00FFFFFF" />
							<Setter
								Property="Template">
								<Setter.Value>
									<ControlTemplate
										TargetType="{x:Type Button}">
										<Border
											Background="{TemplateBinding Background}">
											<ContentPresenter
												HorizontalAlignment="Center"
												Margin="0,0,0,0"
												VerticalAlignment="Center" />
										</Border>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
							<Style.Triggers>
								<Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
									<Setter
										Property="Background"
										Value="#FFA0A0A0" />
								</Trigger>
							</Style.Triggers>
						</Style>
					</FrameworkElement.Style>
				</Button>
			</Grid>
		</Grid>
		<Grid
			Name="gridPreviewBackground"
			Visibility="Hidden">
			<Image
				Name="gridPreviewBackgroundImage"
				Stretch="UniformToFill"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				RenderTransformOrigin="0.5,0.5">
				<UIElement.RenderTransform>
					<ScaleTransform
						x:Name="LiveViewScaleTransform"
						ScaleX="-1" />
				</UIElement.RenderTransform>
			</Image>
		</Grid>
		<Grid
			Name="gridButtons"
			HorizontalAlignment="Center"
			VerticalAlignment="Center">
			<UniformGrid
				Rows="1">
				<StackPanel
					Name="gridPhoto"
					Grid.Column="0"
					Orientation="Vertical"
					VerticalAlignment="Center"
					Height="{Binding ElementName=Selection1Path, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*1}">
					<Grid
						Height="{Binding ElementName=gridButtons, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.25}">
						<Button
							Name="PhotoButton"
							Grid.ColumnSpan="3"
							FontFamily="{StaticResource PromptExtraLight}"
							Click="PhotoButton_Click">
							<Control.Background>
								<ImageBrush
									x:Name="PhotoButtonBrush"
									ImageSource="/Images/CameraShadow.png"
									Stretch="Uniform">
									<Brush.Transform>
										<TransformGroup>
											<ScaleTransform />
											<SkewTransform />
											<RotateTransform />
											<TranslateTransform
												X="0" />
										</TransformGroup>
									</Brush.Transform>
									<Brush.RelativeTransform>
										<TransformGroup>
											<ScaleTransform
												CenterY="0.5"
												CenterX="0.5" />
											<SkewTransform
												CenterX="0.5"
												CenterY="0.5" />
											<RotateTransform
												CenterX="0.5"
												CenterY="0.5" />
											<TranslateTransform
												X="0" />
										</TransformGroup>
									</Brush.RelativeTransform>
								</ImageBrush>
							</Control.Background>
							<FrameworkElement.Style>
								<Style
									TargetType="{x:Type Button}">
									<Setter
										Property="Background"
										Value="#FFFFFFFF" />
									<Setter
										Property="Template">
										<Setter.Value>
											<ControlTemplate
												TargetType="{x:Type Button}">
												<Border
													Background="{TemplateBinding Background}">
													<ContentPresenter
														HorizontalAlignment="Center"
														VerticalAlignment="Center" />
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<Style.Triggers>
										<Trigger
											Property="UIElement.IsMouseOver"
											Value="True">
											<Setter
												Property="UIElement.Opacity"
												Value="0.7" />
										</Trigger>
										<Trigger
											Property="IsEnabled"
											Value="False">
											<Setter
												Property="Background"
												Value="#FF808080" />
										</Trigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
						</Button>
						<Image
							Name="IconLoadingBackground1"
							Source="/Images/ButtonBlackOverlay.png"
							Stretch="Uniform"
							Opacity="0.7"
							Grid.ColumnSpan="3" />
						<Grid
							Name="LoadingContainerPhoto"
							Column="1"
							Visibility="Collapsed">
							<lottie:LottieAnimationView
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								AutoPlay="True"
								FileName="Animations/LoadingPill.json"
								RepeatCount="-1"
								Width="{Binding ElementName=LoadingContainerPhoto, Path=ActualWidth}"
								Height="{Binding ElementName=LoadingContainerPhoto, Path=ActualHeight}" />
						</Grid>
					</Grid>
					<TextBlock
						Name="PhotoButtonLabel"
						Grid.ColumnSpan="3"
						FontFamily="{StaticResource MontserratSemiBold}"
						FontSize="{DynamicResource FontSizeDisplay2}"
						Foreground="#FFFFFFFF"
						VerticalAlignment="Bottom"
						HorizontalAlignment="Center"
						Text="PHOTO" />
				</StackPanel>
				<StackPanel
					Name="gridVideo"
					Grid.Column="0"
					Orientation="Vertical"
					VerticalAlignment="Center"
					Visibility="Visible">
					<Grid
						Height="{Binding ElementName=gridButtons, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.25}">
						<Button
							Name="VideoButton"
							Grid.ColumnSpan="3"
							BorderThickness="0"
							Click="VideoButton_Click">
							<Control.Background>
								<ImageBrush
									x:Name="VideoButtonBrush"
									ImageSource="/Images/VideoShadow.png"
									Stretch="Uniform" />
							</Control.Background>
							<FrameworkElement.Style>
								<Style
									TargetType="{x:Type Button}">
									<Setter
										Property="Background"
										Value="#FFFFFFFF" />
									<Setter
										Property="Template">
										<Setter.Value>
											<ControlTemplate
												TargetType="{x:Type Button}">
												<Border
													Background="{TemplateBinding Background}">
													<ContentPresenter
														HorizontalAlignment="Center"
														VerticalAlignment="Center" />
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<Style.Triggers>
										<Trigger
											Property="UIElement.IsMouseOver"
											Value="True">
											<Setter
												Property="UIElement.Opacity"
												Value="0.7" />
										</Trigger>
										<Trigger
											Property="IsEnabled"
											Value="False">
											<Setter
												Property="Background"
												Value="#FF808080" />
										</Trigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
						</Button>
						<Image
							Name="IconLoadingBackground2"
							Source="/Images/ButtonBlackOverlay.png"
							Stretch="Uniform"
							Opacity="0.7"
							Grid.ColumnSpan="3" />
						<Grid
							Name="LoadingContainerVideo"
							Column="1"
							Visibility="Collapsed">
							<lottie:LottieAnimationView
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								AutoPlay="True"
								FileName="Animations/LoadingPill.json"
								RepeatCount="-1"
								Width="{Binding ElementName=LoadingContainerVideo, Path=ActualWidth}"
								Height="{Binding ElementName=LoadingContainerVideo, Path=ActualHeight}" />
						</Grid>
					</Grid>
					<TextBlock
						Name="VideoButtonLabel"
						Grid.ColumnSpan="3"
						FontFamily="{StaticResource MontserratSemiBold}"
						FontSize="{DynamicResource FontSizeDisplay2}"
						Foreground="#FFFFFFFF"
						VerticalAlignment="Bottom"
						HorizontalAlignment="Center"
						Text="Video" />
				</StackPanel>
				<StackPanel
					Name="gridImport"
					Grid.Column="0"
					Orientation="Vertical"
					VerticalAlignment="Center"
					Visibility="Visible">
					<Grid
						Height="{Binding ElementName=gridButtons, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.25}">
						<Button
							Name="ImportyButton"
							Grid.ColumnSpan="3"
							FontFamily="{StaticResource PromptExtraLight}"
							Click="ImportButton_Click">
							<Control.Background>
								<ImageBrush
									x:Name="ImportyButtonBrush"
									ImageSource="/Images/ImportIcon.png"
									Stretch="Uniform">
									<Brush.Transform>
										<TransformGroup>
											<ScaleTransform />
											<SkewTransform />
											<RotateTransform />
											<TranslateTransform
												X="0" />
										</TransformGroup>
									</Brush.Transform>
									<Brush.RelativeTransform>
										<TransformGroup>
											<ScaleTransform
												CenterY="0.5"
												CenterX="0.5" />
											<SkewTransform
												CenterX="0.5"
												CenterY="0.5" />
											<RotateTransform
												CenterX="0.5"
												CenterY="0.5" />
											<TranslateTransform
												X="0" />
										</TransformGroup>
									</Brush.RelativeTransform>
								</ImageBrush>
							</Control.Background>
							<FrameworkElement.Style>
								<Style
									TargetType="{x:Type Button}">
									<Setter
										Property="Background"
										Value="#FFFFFFFF" />
									<Setter
										Property="Template">
										<Setter.Value>
											<ControlTemplate
												TargetType="{x:Type Button}">
												<Border
													Background="{TemplateBinding Background}">
													<ContentPresenter
														HorizontalAlignment="Center"
														VerticalAlignment="Center" />
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<Style.Triggers>
										<Trigger
											Property="UIElement.IsMouseOver"
											Value="True">
											<Setter
												Property="UIElement.Opacity"
												Value="0.7" />
										</Trigger>
										<Trigger
											Property="IsEnabled"
											Value="False">
											<Setter
												Property="Background"
												Value="#FF808080" />
										</Trigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
						</Button>
					</Grid>
					<TextBlock
						Name="ImportButtonLabel"
						Grid.ColumnSpan="3"
						FontFamily="{StaticResource MontserratSemiBold}"
						FontSize="{DynamicResource FontSizeDisplay2}"
						Foreground="#FFFFFFFF"
						VerticalAlignment="Bottom"
						HorizontalAlignment="Center"
						Text="Import" />
				</StackPanel>
				<StackPanel
					Name="gridGallery"
					Grid.Column="0"
					Orientation="Vertical"
					VerticalAlignment="Center"
					Visibility="Visible">
					<Grid
						Height="{Binding ElementName=gridButtons, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.25}">
						<Button
							Name="GalleryButton"
							Grid.ColumnSpan="3"
							FontFamily="{StaticResource PromptExtraLight}"
							Click="GalleryButton_Click">
							<Control.Background>
								<ImageBrush
									x:Name="GalleryButtonBrush"
									ImageSource="/Images/GalleryIcon.png"
									Stretch="Uniform">
									<Brush.Transform>
										<TransformGroup>
											<ScaleTransform />
											<SkewTransform />
											<RotateTransform />
											<TranslateTransform
												X="0" />
										</TransformGroup>
									</Brush.Transform>
									<Brush.RelativeTransform>
										<TransformGroup>
											<ScaleTransform
												CenterY="0.5"
												CenterX="0.5" />
											<SkewTransform
												CenterX="0.5"
												CenterY="0.5" />
											<RotateTransform
												CenterX="0.5"
												CenterY="0.5" />
											<TranslateTransform
												X="0" />
										</TransformGroup>
									</Brush.RelativeTransform>
								</ImageBrush>
							</Control.Background>
							<FrameworkElement.Style>
								<Style
									TargetType="{x:Type Button}">
									<Setter
										Property="Background"
										Value="#FFFFFFFF" />
									<Setter
										Property="Template">
										<Setter.Value>
											<ControlTemplate
												TargetType="{x:Type Button}">
												<Border
													Background="{TemplateBinding Background}">
													<ContentPresenter
														HorizontalAlignment="Center"
														VerticalAlignment="Center" />
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<Style.Triggers>
										<Trigger
											Property="UIElement.IsMouseOver"
											Value="True">
											<Setter
												Property="UIElement.Opacity"
												Value="0.7" />
										</Trigger>
										<Trigger
											Property="IsEnabled"
											Value="False">
											<Setter
												Property="Background"
												Value="#FF808080" />
										</Trigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
						</Button>
					</Grid>
					<TextBlock
						Name="GalleryButtonLabel"
						Grid.ColumnSpan="3"
						FontFamily="{StaticResource MontserratSemiBold}"
						FontSize="{DynamicResource FontSizeDisplay2}"
						Foreground="#FFFFFFFF"
						VerticalAlignment="Bottom"
						HorizontalAlignment="Center"
						Text="Gallery" />
				</StackPanel>
			</UniformGrid>
		</Grid>
		<Grid
			Name="loadingGifGrid"
			Background="#FF000000"
			Opacity="0.8"
			ColumnSpan="5"
			RowSpan="5"
			Visibility="Collapsed">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="1*" />
				<ColumnDefinition
					Width="1*" />
				<ColumnDefinition
					Width="1*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="1*" />
				<RowDefinition
					Height="1*" />
				<RowDefinition
					Height="1*" />
			</Grid.RowDefinitions>
			<Grid
				Name="LoadingContainer"
				Row="1"
				Column="1">
				<lottie:LottieAnimationView
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					AutoPlay="True"
					FileName="Animations/LoadingPill.json"
					RepeatCount="-1"
					Width="{Binding ElementName=LoadingContainer, Path=ActualWidth}"
					Height="{Binding ElementName=LoadingContainer, Path=ActualHeight}" />
			</Grid>
			<TextBlock
				Name="LoadingGifText"
				Grid.Row="2"
				Grid.Column="1"
				FontSize="{DynamicResource FontSizeDisplay1}"
				TextWrapping="Wrap"
				Text="Loading..."
				Foreground="#FFF5F5F5"
				HorizontalAlignment="Center"
				VerticalAlignment="Center" />
		</Grid>
		<Grid
			Name="PaymentGrid"
			ColumnSpan="5"
			RowSpan="5"
			Visibility="Collapsed">
			<Panel.Background>
				<ImageBrush
					ImageSource="/Images/Payment/PhotoPaymentWaiting.jpg"
					Stretch="UniformToFill" />
			</Panel.Background>
			<Grid
				Name="MainPaymentPage">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="1*" />
					<ColumnDefinition
						Width="3*" />
					<ColumnDefinition
						Width="1*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="1*" />
					<RowDefinition
						Height="2*" />
				</Grid.RowDefinitions>
				<Grid
					ColumnSpan="5">
					<StackPanel>
						<Grid
							Height="100" />
						<TextBlock
							Name="MainPaymentTitle"
							Text="Pick Your Fun!"
							Background="#00FFFFFF"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Foreground="#FFFFFFFF"
							TextAlignment="Center"
							Margin="0,0,0,0"
							FontFamily="{StaticResource MontserratBold}"
							FontSize="{DynamicResource FontSizeDisplay1}" />
						<Grid
							Height="20" />
						<TextBlock
							Name="MainPaymentText"
							Text="Choose how you want your photos — and how many!"
							Background="#00FFFFFF"
							HorizontalAlignment="Center"
							VerticalAlignment="Bottom"
							Foreground="#FFFFFFFF"
							TextAlignment="Center"
							Margin="0,0,0,20"
							FontFamily="{StaticResource MontserratRegular}"
							FontSize="{DynamicResource FontSizeHeading2}" />
					</StackPanel>
				</Grid>
				<StackPanel
					Orientation="Vertical"
					Grid.Column="1"
					Grid.Row="1">
					<Grid
						Height="50" />
					<Grid
