<Page
	x:Class="KingAIPhotoBoothPro.Pages.GoProVideo" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages" xmlns:class="clr-namespace:KingAIPhotoBoothPro.Class" xmlns:math="http://hexinnovation.com/math" xmlns:wpf="clr-namespace:Vlc.DotNet.Wpf;assembly=Vlc.DotNet.Wpf" xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
	Title="GoProVideo"
	Loaded="Page_Loaded"
	Unloaded="Page_Unloaded"
	SizeChanged="Page_SizeChanged">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<math:MathConverter
				x:Key="math" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="gridMain"
		Background="#00FFFFFF">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="24*" />
			<RowDefinition
				Height="126*" />
			<RowDefinition
				Height="24*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="16*" />
			<ColumnDefinition
				Width="50*" />
			<ColumnDefinition
				Width="16*" />
		</Grid.ColumnDefinitions>
		<Grid
			Row="1">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="2*" />
				<RowDefinition
					Height="8*" />
			</Grid.RowDefinitions>
			<Button
				Name="CancelButton"
				IsDefault="True"
				Content="CANCEL"
				Foreground="#FFFFFFFF"
				FontFamily="{StaticResource MontserratBold}"
				FontWeight="Bold"
				FontSize="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.015+1}"
				Click="CancelButton_Click">
				<Control.Background>
					<ImageBrush
						x:Name="CancelBrush"
						Stretch="Uniform"
						ImageSource="/Images/CancelButton.png" />
				</Control.Background>
				<FrameworkElement.Style>
					<Style
						TargetType="{x:Type Button}">
						<Setter
							Property="Background"
							Value="#FFFFFFFF" />
						<Setter
							Property="Template">
							<Setter.Value>
								<ControlTemplate
									TargetType="{x:Type Button}">
									<Border
										Background="{TemplateBinding Background}">
										<ContentPresenter
											HorizontalAlignment="Center"
											VerticalAlignment="Center" />
									</Border>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
						<Style.Triggers>
							<Trigger
								Property="UIElement.IsMouseOver"
								Value="True">
								<Setter
									Property="UIElement.Opacity"
									Value="0.7" />
							</Trigger>
						</Style.Triggers>
					</Style>
				</FrameworkElement.Style>
			</Button>
		</Grid>
		<Grid
			Name="PhotoPanel"
			Row="1"
			Column="1"
			Visibility="Visible"
			Margin="0,10,0,0">
			<Image
				Source="/Images/PreviewScreen/PhotoResultShadow.png"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				Stretch="Fill"
				Margin="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=-x/38.4+1}" />
			<wpf:VlcControl
				Name="LiveViewImagePlayer"
				Margin="10"
				BorderBrush="#FFFFFFFF"
				BorderThickness="1"
				Grid.Column="0"
				Background="#FF000000" />
			<Border
				Name="borderLoginSmooth"
				Margin="-5"
				BorderThickness="10"
				CornerRadius="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.0130+1}">
				<Border.BorderBrush>
					<LinearGradientBrush
						EndPoint="0.5,1"
						StartPoint="0.5,0">
						<GradientStop
							Color="White"
							Offset="0" />
						<GradientStop
							Color="#FFD5D5D5"
							Offset="1" />
					</LinearGradientBrush>
				</Border.BorderBrush>
			</Border>
			<Grid
				Visibility="Visible"
				Row="1"
				Column="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="139*" />
					<ColumnDefinition
						Width="117*" />
					<ColumnDefinition
						Width="139*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="117*" />
					<RowDefinition
						Height="139*" />
					<RowDefinition
						Height="117*" />
				</Grid.RowDefinitions>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="4*" />
						<ColumnDefinition
							Width="5*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="4*" />
						<RowDefinition
							Height="7*" />
					</Grid.RowDefinitions>
					<Grid
						Name="RecordingContainer"
						VerticalAlignment="Center"
						HorizontalAlignment="Center"
						Margin="15,15,0,0">
						<lottie:LottieAnimationView
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							AutoPlay="True"
							FileName="Animations/Record.json"
							RepeatCount="-1"
							Width="{Binding ElementName=RecordingContainer, Path=ActualWidth}"
							Height="{Binding ElementName=RecordingContainer, Path=ActualHeight}" />
					</Grid>
				</Grid>
				<Grid
					Name="CountDownGrid"
					Column="1"
					Row="1">
					<Grid
						Name="CountdownContainer"
						Row="1"
						Column="1"
						HorizontalAlignment="Center"
						VerticalAlignment="Center">
						<lottie:LottieAnimationView
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							AutoPlay="True"
							FileName="Animations/LoadingDots.json"
							RepeatCount="-1"
							Width="{Binding ElementName=CountdownContainer, Path=ActualWidth}"
							Height="{Binding ElementName=CountdownContainer, Path=ActualHeight}" />
					</Grid>
					<TextBlock
						Name="countDownText"
						Grid.Row="1"
						Grid.Column="1"
						Foreground="#FFFFFFFF"
						HorizontalAlignment="Center"
						VerticalAlignment="Top"
						Text="10"
						FontSize="{Binding ElementName=gridMain, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.18+1}" />
				</Grid>
			</Grid>
			<Grid
				Name="WaitingGrid"
				Visibility="Hidden">
				<Border
					Margin="0"
					Background="#99000000"
					CornerRadius="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.012+1}">
					<Border.BorderBrush>
						<LinearGradientBrush
							EndPoint="0.5,1"
							StartPoint="0.5,0">
							<GradientStop
								Color="Black"
								Offset="0" />
							<GradientStop
								Color="Black"
								Offset="1" />
						</LinearGradientBrush>
					</Border.BorderBrush>
				</Border>
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="1*" />
						<RowDefinition
							Height="1*" />
						<RowDefinition
							Height="1*" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="1*" />
						<ColumnDefinition
							Width="1*" />
						<ColumnDefinition
							Width="1*" />
					</Grid.ColumnDefinitions>
					<Grid
						Name="WaitingContainer"
						Row="1"
						Column="1">
						<lottie:LottieAnimationView
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							AutoPlay="True"
							FileName="Animations/LoadingPill.json"
							RepeatCount="-1"
							Width="{Binding ElementName=WaitingContainer, Path=ActualWidth}"
							Height="{Binding ElementName=WaitingContainer, Path=ActualHeight}" />
					</Grid>
				</Grid>
			</Grid>
		</Grid>
		<Button
			Name="EmergencyStopButton"
			Grid.RowSpan="3"
			Grid.Column="1"
			Margin="0,0,0,10"
			Height="120"
			VerticalAlignment="Bottom"
			Content=""
			Foreground="#FFFFFFFF"
			FontFamily="{StaticResource MontserratBold}"
			FontWeight="Bold"
			FontSize="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.015+1}"
			Click="EmergencyStopButton_Click">
			<Control.Background>
				<ImageBrush
					x:Name="StopBrush"
					Stretch="Uniform"
					ImageSource="/Images/EmergencyStop.png" />
			</Control.Background>
			<FrameworkElement.Style>
				<Style
					TargetType="{x:Type Button}">
					<Setter
						Property="Background"
						Value="#FFFFFFFF" />
					<Setter
						Property="Template">
						<Setter.Value>
							<ControlTemplate
								TargetType="{x:Type Button}">
								<Border
									Background="{TemplateBinding Background}">
									<ContentPresenter
										HorizontalAlignment="Center"
										VerticalAlignment="Center" />
								</Border>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
					<Style.Triggers>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								Property="UIElement.Opacity"
								Value="0.7" />
						</Trigger>
					</Style.Triggers>
				</Style>
			</FrameworkElement.Style>
		</Button>
	</Grid>
</Page>
