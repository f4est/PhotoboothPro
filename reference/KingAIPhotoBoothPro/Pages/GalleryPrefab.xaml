<Page
	x:Class="KingAIPhotoBoothPro.Pages.GalleryPrefab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages" xmlns:math="http://hexinnovation.com/math" xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
	Name="GalleryPrefaba"
	Title="GalleryPrefab"
	Unloaded="Page_Unloaded"
	Loaded="Page_Loaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<math:MathConverter
				x:Key="math" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="gridMain">
		<Border
			Name="mask"
			CornerRadius="{DynamicResource UICornerRadius}"
			Background="#FFFFFFFF" />
		<Image
			Name="GalleryImage"
			Source="/Images/Samples/PartyOldManMask.jpg"
			Stretch="UniformToFill"
			VerticalAlignment="Center"
			HorizontalAlignment="Center">
			<UIElement.OpacityMask>
				<VisualBrush
					Visual="{Binding ElementName=mask}" />
			</UIElement.OpacityMask>
		</Image>
		<Grid
			Name="gridLoading"
			Background="{DynamicResource UILightOverlay}"
			Visibility="Collapsed">
			<lottie:LottieAnimationView
				Grid.Row="0"
				Grid.Column="1"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				AutoPlay="True"
				FileName="Animations/LoadingPill.json"
				RepeatCount="-1"
				Width="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*1}"
				Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*1}" />
		</Grid>
		<Border
			Name="borderSmooth"
			Margin="-2"
			BorderThickness="10"
			CornerRadius="{DynamicResource UICornerRadius}">
			<Border.BorderBrush>
				<LinearGradientBrush
					EndPoint="0.5,1"
					StartPoint="0.5,0">
					<GradientStop
						Color="White"
						Offset="0" />
					<GradientStop
						Color="#FFD5D5D5"
						Offset="1" />
				</LinearGradientBrush>
			</Border.BorderBrush>
		</Border>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="1*" />
				<ColumnDefinition
					Width="1*" />
				<ColumnDefinition
					Width="1*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="1*" />
				<RowDefinition
					Height="1*" />
				<RowDefinition
					Height="1*" />
			</Grid.RowDefinitions>
			<Image
				Name="videoIcon"
				Grid.Row="1"
				Grid.Column="1"
				Source="/Images/videoIcon.png"
				Opacity="0.5" />
		</Grid>
		<Button
			Name="PhotoButton"
			BorderThickness="0"
			Margin="0,0,0,0"
			Click="PhotoButton_Click">
			<UIElement.OpacityMask>
				<ImageBrush
					ImageSource="{Binding ElementName=GalleryImage}" />
			</UIElement.OpacityMask>
			<Control.Background>
				<ImageBrush
					x:Name="PhotoButtonBrush"
					ImageSource="{Binding ElementName=GalleryImage}">
					<Brush.Transform>
						<TransformGroup>
							<ScaleTransform />
							<SkewTransform />
							<RotateTransform />
							<TranslateTransform
								X="0" />
						</TransformGroup>
					</Brush.Transform>
					<Brush.RelativeTransform>
						<TransformGroup>
							<ScaleTransform
								CenterY="0.5"
								CenterX="0.5" />
							<SkewTransform
								CenterX="0.5"
								CenterY="0.5" />
							<RotateTransform
								CenterX="0.5"
								CenterY="0.5" />
							<TranslateTransform
								X="0" />
						</TransformGroup>
					</Brush.RelativeTransform>
				</ImageBrush>
			</Control.Background>
			<FrameworkElement.Style>
				<Style
					TargetType="{x:Type Button}">
					<Setter
						Property="Background"
						Value="#FFFFFFFF" />
					<Setter
						Property="Template">
						<Setter.Value>
							<ControlTemplate
								TargetType="{x:Type Button}">
								<Border
									Background="{TemplateBinding Background}">
									<ContentPresenter
										HorizontalAlignment="Center"
										VerticalAlignment="Center" />
								</Border>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
					<Style.Triggers>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								Property="UIElement.Opacity"
								Value="0.5" />
						</Trigger>
					</Style.Triggers>
				</Style>
			</FrameworkElement.Style>
		</Button>
		<Button
			Name="CloseButton"
			HorizontalAlignment="Right"
			VerticalAlignment="Top"
			Margin="10"
			Foreground="#FFFFFFFF"
			FontFamily="{StaticResource MontserratSemiBold}"
			FontSize="{DynamicResource FontSizeButtonPrimary}"
			Visibility="Collapsed"
			Width="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.166}"
			Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.166}"
			Click="DeleteButton_Click">
			<UIElement.Effect>
				<DropShadowEffect
					Opacity="0.25"
					BlurRadius="20"
					ShadowDepth="10" />
			</UIElement.Effect>
			<FrameworkElement.Style>
				<Style
					TargetType="{x:Type Button}">
					<Setter
						Property="Background"
						Value="#FFFFFFFF" />
					<Setter
						Property="Template">
						<Setter.Value>
							<ControlTemplate
								TargetType="{x:Type Button}">
								<Border
									Background="#00FFFFFF"
									CornerRadius="{Binding Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.5+1, RelativeSource={RelativeSource Self}}">
									<ContentPresenter
										HorizontalAlignment="Center"
										VerticalAlignment="Center" />
								</Border>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
					<Style.Triggers>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								Property="UIElement.Opacity"
								Value="0.7" />
						</Trigger>
					</Style.Triggers>
				</Style>
			</FrameworkElement.Style>
			<ContentControl.Content>
				<Image
					Source="/Images/closeIcon.png"
					Stretch="UniformToFill"
					VerticalAlignment="Center"
					HorizontalAlignment="Center" />
			</ContentControl.Content>
		</Button>
	</Grid>
</Page>
