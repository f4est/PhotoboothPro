<local:SettingsSubPage
	x:Class="KingAIPhotoBoothPro.Pages.ActivationKing.PrinterPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:localUI="clr-namespace:KingAIPhotoBoothPro.Class.UI" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages.ActivationKing" xmlns:math="http://hexinnovation.com/math" xmlns:class="clr-namespace:KingAIPhotoBoothPro.Class"
	Loaded="Page_Loaded"
	Title="PrinterPage">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<math:MathConverter
				x:Key="math" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="gridMain">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="0" />
			<RowDefinition
				Height="1*" />
			<RowDefinition
				Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.02+1}" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="150*" />
			<ColumnDefinition
				Width="2662*" />
			<ColumnDefinition
				Width="128*" />
		</Grid.ColumnDefinitions>
		<Grid
			Row="1"
			Column="1">
			<ScrollViewer
				Name="ScrollViewMain"
				VerticalScrollBarVisibility="Auto"
				HorizontalScrollBarVisibility="Disabled">
				<i:Interaction.Behaviors>
					<localUI:ScrollViewerDragBehavior />
				</i:Interaction.Behaviors>
				<StackPanel
					Orientation="Vertical"
					Margin="0,0,20,0">
					<Grid
						Name="SharingSettingsGrid"
						Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.23}">
						<class:SectionTemplate
							Template="{StaticResource SectionTemplateKey}"
							Content="Sharing Options"
							Background="#FFFFFFFF"
							BorderBrush="#BABFC5"
							Grid.RowSpan="5"
							Grid.ColumnSpan="5" />
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition
									Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.0757+1}" />
								<RowDefinition
									Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.194+1}" />
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="80*" />
								<ColumnDefinition
									Width="2574*" />
							</Grid.ColumnDefinitions>
							<Grid
								Row="1"
								Column="1">
								<Grid
									Row="1">
									<Grid.RowDefinitions>
										<RowDefinition
											Height="80*" />
										<RowDefinition
											Height="73*" />
										<RowDefinition
											Height="48*" />
										<RowDefinition
											Height="80*" />
										<RowDefinition
											Height="82*" />
										<RowDefinition
											Height="60*" />
										<RowDefinition
											Height="122*" />
									</Grid.RowDefinitions>
									<Grid
										Row="1" />
									<Grid
										Row="0">
										<Grid.ColumnDefinitions>
											<ColumnDefinition
												Width="305*" />
											<ColumnDefinition
												Width="60*" />
											<ColumnDefinition
												Width="520*" />
											<ColumnDefinition
												Width="60*" />
											<ColumnDefinition
												Width="607*" />
											<ColumnDefinition
												Width="60*" />
											<ColumnDefinition
												Width="325*" />
											<ColumnDefinition
												Width="60*" />
											<ColumnDefinition
												Width="325*" />
											<ColumnDefinition
												Width="20*" />
										</Grid.ColumnDefinitions>
										<Frame
											Name="PrintCheckFrame"
											Grid.Column="0" />
										<Frame
											Name="DirectPrintCheckFrame"
											Grid.Column="2" />
										<Frame
											Name="UseWindowsSettingsFrame"
											Grid.Column="4" />
										<Frame
											Name="AutoPrintFrame"
											Grid.Column="6" />
									</Grid>
									<Grid
										Row="2">
										<Grid.ColumnDefinitions>
											<ColumnDefinition
												Width="30*" />
											<ColumnDefinition
												Width="530*" />
											<ColumnDefinition
												Width="60*" />
											<ColumnDefinition
												Width="520*" />
											<ColumnDefinition
												Width="60*" />
											<ColumnDefinition
												Width="607*" />
											<ColumnDefinition
												Width="60*" />
											<ColumnDefinition
												Width="325*" />
											<ColumnDefinition
												Width="60*" />
											<ColumnDefinition
												Width="100*" />
											<ColumnDefinition
												Width="20*" />
										</Grid.ColumnDefinitions>
										<Frame
											Name="ForceLandscapeFrame"
											Grid.Column="1" />
										<Frame
											Name="ForcePortraitFrame"
											Grid.Column="3" />
										<Frame
											Name="UseDefaultPrintSettingsFrame"
											Grid.Column="5" />
									</Grid>
									<Grid
										Row="4">
										<Grid.ColumnDefinitions>
											<ColumnDefinition
												Width="64*" />
											<ColumnDefinition
												Width="24*" />
											<ColumnDefinition
												Width="1688*" />
											<ColumnDefinition
												Width="806*" />
										</Grid.ColumnDefinitions>
										<Grid
											Column="0">
											<Path
												Data="{StaticResource InfoIcon}"
												Stroke="#82868C"
												Stretch="Uniform"
												StrokeThickness="0"
												Fill="{DynamicResource UIWarningColor}"
												VerticalAlignment="Center"
												HorizontalAlignment="Center"
												Width="{Binding ElementName=PrintNumberAdd, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.3+1}" />
										</Grid>
										<TextBlock
											Grid.Column="2"
											Grid.ColumnSpan="3"
											HorizontalAlignment="Left"
											Foreground="{DynamicResource UIGray}"
											Style="{DynamicResource TextStyleInfo}"
											Text="When you switch the toggles on, the settings of the related share option will appear." />
									</Grid>
								</Grid>
							</Grid>
						</Grid>
					</Grid>
					<Grid
						Height="20" />
					<Grid
						Name="PrintSettingsGrid"
						Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.65+1}">
						<class:SectionTemplate
							Template="{StaticResource SectionTemplateKey}"
							Content="Print Settings"
							Background="#FFFFFFFF"
							BorderBrush="#BABFC5"
							Grid.RowSpan="5"
							Grid.ColumnSpan="5" />
						<Grid
							Margin="0,20,0,0">
							<Grid.RowDefinitions>
								<RowDefinition
									Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.06}" />
								<RowDefinition
									Height="1*" />
								<RowDefinition
									Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.02+1}" />
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="1*" />
								<ColumnDefinition
									Width="26*" />
								<ColumnDefinition
									Width="1*" />
							</Grid.ColumnDefinitions>
							<Grid
								Row="1"
								Column="1">
								<Grid.RowDefinitions>
									<RowDefinition
										Height="2*" />
									<RowDefinition
										Height="1*" />
									<RowDefinition
										Height="12*" />
								</Grid.RowDefinitions>
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="1*" />
									<ColumnDefinition
										Width="6*" />
									<ColumnDefinition
										Width="3*" />
									<ColumnDefinition
										Width="6*" />
								</Grid.ColumnDefinitions>
								<Frame
									Name="printerComboBoxFrame"
									Grid.Column="1" />
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition
											Width="1*" />
										<ColumnDefinition
											Width="1*" />
										<ColumnDefinition
											Width="1*" />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition
											Height="1*" />
										<RowDefinition
											Height="1*" />
										<RowDefinition
											Height="1*" />
									</Grid.RowDefinitions>
									<Image
										Name="PrinterStatusImage"
										Grid.Column="1"
										Grid.Row="1"
										Source="/Images/IconBackground.png"
										HorizontalAlignment="Left"
										VerticalAlignment="Center"
										Margin="0"
										Stretch="Uniform"
										Opacity="1" />
								</Grid>
								<Grid
									Column="2"
									ColumnSpan="2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition
											Width="1*" />
										<ColumnDefinition
											Width="1*" />
									</Grid.ColumnDefinitions>
									<Frame
										Name="printerLimitFrame"
										Grid.Column="0" />
									<Frame
										Name="printerEachPhotoLimitFrame"
										Grid.Column="1" />
								</Grid>
								<Grid
									Row="2"
									ColumnSpan="4">
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition
												Height="1*" />
											<RowDefinition
												Height="1*" />
											<RowDefinition
												Height="1*" />
										</Grid.RowDefinitions>
										<Grid.ColumnDefinitions>
											<ColumnDefinition
												Width="1*" />
											<ColumnDefinition
												Width="1*" />
											<ColumnDefinition
												Width="1*" />
										</Grid.ColumnDefinitions>
										<Frame
											Name="SliderTopFrame"
											Margin="0"
											Grid.Column="1" />
										<Frame
											Name="SliderBottomFrame"
											Margin="0"
											Grid.Column="1"
											Grid.Row="2" />
										<Frame
											Name="SliderLeftFrame"
											Margin="0"
											Grid.Row="1" />
										<Frame
											Name="SliderRightFrame"
											Margin="0"
											Grid.Row="1"
											Grid.Column="2" />
										<Grid
											Background="#ffeeeeee"
											ClipToBounds="True"
											Row="1"
											Column="1">
											<Image
												Name="CanvasForPrint"
												Stretch="Fill" />
											<Image
												Name="CanvasForOverlay"
												Source="/Images/overlay.png"
												Stretch="Fill"
												HorizontalAlignment="Center"
												VerticalAlignment="Center" />
										</Grid>
									</Grid>
								</Grid>
							</Grid>
						</Grid>
					</Grid>
					<Grid
						Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.03+1}" />
				</StackPanel>
			</ScrollViewer>
		</Grid>
	</Grid>
</local:SettingsSubPage>
