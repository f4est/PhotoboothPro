<local:SettingsSubPage
	x:Class="KingAIPhotoBoothPro.Pages.ActivationKing.AIEffectPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages.ActivationKing" xmlns:localUI="clr-namespace:KingAIPhotoBoothPro.Class.UI" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:class="clr-namespace:KingAIPhotoBoothPro.Class" xmlns:math="http://hexinnovation.com/math" xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
	Loaded="Page_Loaded"
	Unloaded="Page_Unloaded"
	Title="AIEffectPage">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<math:MathConverter
				x:Key="math" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="gridMain">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="0" />
			<RowDefinition
				Height="1*" />
			<RowDefinition
				Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.02+1}" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="150*" />
			<ColumnDefinition
				Width="2662*" />
			<ColumnDefinition
				Width="128*" />
		</Grid.ColumnDefinitions>
		<Grid
			Row="1"
			Column="1">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.065}" />
				<RowDefinition
					Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.0}" />
				<RowDefinition
					Height="1*" />
				<RowDefinition
					Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.02+1}" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="80*" />
				<ColumnDefinition
					Width="2512*" />
				<ColumnDefinition
					Width="30*" />
			</Grid.ColumnDefinitions>
			<class:SectionTemplate
				Template="{StaticResource SectionTemplateKey}"
				Content="AI Effects"
				Background="#FFFFFFFF"
				BorderBrush="#BABFC5"
				Grid.RowSpan="5"
				Grid.ColumnSpan="5" />
			<ScrollViewer
				Name="scrollPanel"
				Grid.Row="2"
				Grid.Column="1"
				VerticalScrollBarVisibility="Auto">
				<i:Interaction.Behaviors>
					<localUI:ScrollViewerDragBehavior />
				</i:Interaction.Behaviors>
				<WrapPanel
					Name="AIEffectPrefabStackPanel"
					Orientation="Horizontal"
					ItemWidth="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.28}"
					ItemHeight="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.3}" />
			</ScrollViewer>
			<Grid
				Name="loadingGifGrid"
				Column="1"
				Row="2"
				Visibility="Hidden"
				Background="#FFFFFFFF">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="1*" />
					<ColumnDefinition
						Width="1*" />
					<ColumnDefinition
						Width="1*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="1*" />
					<RowDefinition
						Height="1*" />
					<RowDefinition
						Height="1*" />
				</Grid.RowDefinitions>
				<Grid
					Name="LoadingContainer"
					Row="1"
					Column="1">
					<lottie:LottieAnimationView
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						AutoPlay="True"
						FileName="Animations/LoadingPill.json"
						RepeatCount="-1"
						Width="{Binding ElementName=LoadingContainer, Path=ActualWidth}"
						Height="{Binding ElementName=LoadingContainer, Path=ActualHeight}" />
				</Grid>
				<TextBlock
					Name="loadingText"
					Grid.Row="0"
					Grid.Column="0"
					TextWrapping="Wrap"
					Text=""
					Foreground="#FF000000"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontSize="{Binding ActualWidth, ConverterParameter=x*0.05, Converter={StaticResource math}, ElementName=loadingGifGrid}" />
			</Grid>
		</Grid>
	</Grid>
</local:SettingsSubPage>
