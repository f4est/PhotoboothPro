<activationking:SettingsSubPage
	x:Class="KingAIPhotoBoothPro.Pages.DashboardPage" xmlns:activationking="clr-namespace:KingAIPhotoBoothPro.Pages.ActivationKing" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:class="clr-namespace:KingAIPhotoBoothPro.Class" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages" xmlns:math="http://hexinnovation.com/math" xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
	activationking:Loaded="Page_Loaded"
	Title="DashboardPage">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<math:MathConverter
				x:Key="math" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="gridMain">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.22+1}" />
			<RowDefinition
				Height="1*" />
			<RowDefinition
				Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.1355+1}" />
		</Grid.RowDefinitions>
		<Grid
			Row="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="150*" />
				<ColumnDefinition
					Width="2662*" />
				<ColumnDefinition
					Width="128*" />
			</Grid.ColumnDefinitions>
			<Grid
				Name="Properties"
				Row="1"
				Column="1"
				Margin="0,40,0,0">
				<Border
					Name="borderLoginSmooth"
					Grid.RowSpan="10"
					Grid.ColumnSpan="10"
					Background="#FFFFFFFF"
					CornerRadius="{DynamicResource SectionCornerRadius}"
					Opacity="1">
					<UIElement.Effect>
						<DropShadowEffect
							Opacity="0.25"
							BlurRadius="20"
							ShadowDepth="10" />
					</UIElement.Effect>
				</Border>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="12*" />
						<ColumnDefinition
							Width="14*" />
					</Grid.ColumnDefinitions>
					<Grid
						Column="0">
						<Grid.RowDefinitions>
							<RowDefinition
								Height="3*" />
							<RowDefinition
								Height="1*" />
						</Grid.RowDefinitions>
						<Image
							Grid.Row="0"
							Source="/Images/banner_image.png"
							Margin="0,-40,0,0">
							<UIElement.Effect>
								<DropShadowEffect
									Opacity="0.25"
									BlurRadius="20"
									ShadowDepth="10" />
							</UIElement.Effect>
						</Image>
					</Grid>
					<Grid
						Column="1">
						<Grid.RowDefinitions>
							<RowDefinition
								Height="60*" />
							<RowDefinition
								Height="70*" />
							<RowDefinition
								Height="0*" />
							<RowDefinition
								Height="150*" />
							<RowDefinition
								Height="0*" />
							<RowDefinition
								Height="100*" />
							<RowDefinition
								Height="60*" />
						</Grid.RowDefinitions>
						<TextBlock
							Grid.Row="1"
							FontFamily="{StaticResource PromptBold}"
							FontSize="{DynamicResource FontSizeHeading3}"
							Foreground="#FF707070"
							VerticalAlignment="Bottom"
							Grid.RowSpan="2">Welcome <TextBlock
								Name="UserNameLabel"
								Foreground="{DynamicResource AppUIColorLight}">Utku</TextBlock></TextBlock>
						<TextBlock
							VerticalAlignment="Center"
							Grid.Row="3"
							FontFamily="{StaticResource PromptMedium}"
							LineHeight="1"
							FontSize="{DynamicResource FontSizeTextRegular}"
							Foreground="#FF707270">Thank you for choosing Activation King products.<LineBreak />Your <TextBlock
								Name="txtSoftwareName">03.02.2022</TextBlock> software licence is valid till <TextBlock
								Name="ThankLicenceLabel"
								Foreground="{StaticResource UIGreenButton}"
								FontWeight="ExtraBold">03.02.2022</TextBlock></TextBlock>
						<Grid
							Row="5"
							RowSpan="1">
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="7*" />
								<ColumnDefinition
									Width="2*" />
								<ColumnDefinition
									Width="12*" />
								<ColumnDefinition
									Width="10*" />
							</Grid.ColumnDefinitions>
							<Button
								Name="LogOutButton"
								Content="Logout"
								Foreground="#FFFFFFFF"
								FontFamily="{StaticResource PromptMedium}"
								FontSize="{DynamicResource FontSizeButtonPrimary}"
								Click="LogOutButton_Click">
								<UIElement.Effect>
									<DropShadowEffect
										Opacity="0.25"
										BlurRadius="20"
										ShadowDepth="10" />
								</UIElement.Effect>
								<FrameworkElement.Style>
									<Style
										TargetType="{x:Type Button}">
										<Setter
											Property="Background"
											Value="#FFFFFFFF" />
										<Setter
											Property="Template">
											<Setter.Value>
												<ControlTemplate
													TargetType="{x:Type Button}">
													<Border
														Background="#EC2D30"
														CornerRadius="{Binding Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.5+1, RelativeSource={RelativeSource Self}}">
														<ContentPresenter
															HorizontalAlignment="Center"
															VerticalAlignment="Center" />
													</Border>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
										<Style.Triggers>
											<Trigger
												Property="UIElement.IsMouseOver"
												Value="True">
												<Setter
													Property="UIElement.Opacity"
													Value="0.7" />
											</Trigger>
										</Style.Triggers>
									</Style>
								</FrameworkElement.Style>
							</Button>
							<Button
								Name="DiscoverButton"
								Grid.Column="2"
								BorderThickness="0"
								Content="Discover More"
								Foreground="#FFFFFFFF"
								FontFamily="{StaticResource PromptMedium}"
								FontSize="{DynamicResource FontSizeButtonPrimary}"
								Click="DiscoverButton_Click">
								<UIElement.Effect>
									<DropShadowEffect
										Opacity="0.25"
										BlurRadius="20"
										ShadowDepth="10" />
								</UIElement.Effect>
								<FrameworkElement.Style>
									<Style
										TargetType="{x:Type Button}">
										<Setter
											Property="Template">
											<Setter.Value>
												<ControlTemplate
													TargetType="{x:Type Button}">
													<Border
														Name="borderCreateButton"
														Background="#3B82F6"
														CornerRadius="{Binding Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.5+1, RelativeSource={RelativeSource Self}}">
														<ContentPresenter
															HorizontalAlignment="Center"
															VerticalAlignment="Center" />
													</Border>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
										<Style.Triggers>
											<Trigger
												Property="UIElement.IsMouseOver"
												Value="True">
												<Setter
													Property="UIElement.Opacity"
													Value="0.7" />
											</Trigger>
										</Style.Triggers>
									</Style>
								</FrameworkElement.Style>
							</Button>
						</Grid>
					</Grid>
				</Grid>
			</Grid>
		</Grid>
		<Grid
			Name="AICreditsGrid"
			Row="2">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="121*" />
				<RowDefinition
					Height="48*" />
				<RowDefinition
					Height="192*" />
				<RowDefinition
					Height="160*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="150*" />
				<ColumnDefinition
					Width="2662*" />
				<ColumnDefinition
					Width="128*" />
			</Grid.ColumnDefinitions>
			<Grid
				Name="AICreditsHeaderGrid"
				Row="0"
				Column="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="955*" />
					<ColumnDefinition
						Width="1553*" />
				</Grid.ColumnDefinitions>
				<Grid
					Column="0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="400*" />
						<ColumnDefinition
							Width="50*" />
						<ColumnDefinition
							Width="300*" />
					</Grid.ColumnDefinitions>
					<TextBlock
						Grid.Column="0"
						Text="AI Credits"
						FontSize="{DynamicResource FontSizeHeading1}"
						FontFamily="{StaticResource PromptMedium}"
						Foreground="#707270"
						HorizontalAlignment="Left"
						VerticalAlignment="Center" />
					<Grid
						Name="CreditStatusMainGrid"
						Column="2">
						<Grid.RowDefinitions>
							<RowDefinition
								Height="10*" />
							<RowDefinition
								Height="60*" />
							<RowDefinition
								Height="10*" />
						</Grid.RowDefinitions>
						<Grid
							Row="1">
							<Border
								Name="CreditStatusBackgroundBorder"
								Background="#C0E5D1"
								CornerRadius="{DynamicResource UICornerRadius}">
								<TextBlock
									Name="CreditStatusText"
									FontFamily="{StaticResource PromptBold}"
									FontSize="{DynamicResource FontSizeTextSmall}"
									Text="Enough Credit"
									VerticalAlignment="Center"
									HorizontalAlignment="Center"
									Foreground="#0C9D61" />
							</Border>
						</Grid>
					</Grid>
				</Grid>
			</Grid>
			<Grid
				Name="CreditsCountsGrid"
				Row="2"
				Column="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="995*" />
					<ColumnDefinition
						Width="188*" />
					<ColumnDefinition
						Width="705*" />
					<ColumnDefinition
						Width="21*" />
					<ColumnDefinition
						Width="705*" />
				</Grid.ColumnDefinitions>
				<Grid
					Name="TotalCreditsGrid"
					Visibility="Collapsed">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="48*" />
						<ColumnDefinition
							Width="120*" />
						<ColumnDefinition
							Width="48*" />
						<ColumnDefinition
							Width="401*" />
						<ColumnDefinition
							Width="48*" />
						<ColumnDefinition
							Width="319*" />
						<ColumnDefinition
							Width="48*" />
					</Grid.ColumnDefinitions>
					<Border
						Name="TotalCreditsGridBorder"
						Grid.RowSpan="10"
						Grid.ColumnSpan="10"
						Background="#FFFFFFFF"
						CornerRadius="{DynamicResource SectionCornerRadius}"
						Opacity="1">
						<UIElement.Effect>
							<DropShadowEffect
								Opacity="0.25"
								BlurRadius="20"
								ShadowDepth="10" />
						</UIElement.Effect>
					</Border>
					<Grid
						Name="TotalCreditsIconGrid"
						Column="1"
						Margin="0,0,1,0">
						<Grid.RowDefinitions>
							<RowDefinition
								Height="36*" />
							<RowDefinition
								Height="120*" />
							<RowDefinition
								Height="36*" />
						</Grid.RowDefinitions>
						<Grid
							Row="1">
							<Border
								Background="#FE9B0E"
								Width="{Binding ElementName=TotalCreditsIconPath, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.8}"
								Height="{Binding ElementName=TotalCreditsIconPath, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.8}" />
							<Path
								Name="TotalCreditsIconPath"
								Data="{StaticResource TotalCreditsIcon}"
								Fill="#FFEAB3"
								Stroke="#00FFFFFF"
								Stretch="Uniform"
								StrokeThickness="2"
								VerticalAlignment="Center"
								HorizontalAlignment="Center" />
						</Grid>
					</Grid>
					<Grid
						Name="TotalCreditsTextGrid"
						Column="3"
						HorizontalAlignment="left"
						VerticalAlignment="Center">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="1*" />
							<ColumnDefinition
								Width="1*" />
						</Grid.ColumnDefinitions>
						<Viewbox
							Stretch="Uniform"
							Grid.Column="0">
							<TextBlock
								Name="AICreditsCountText"
								Text="+ 0"
								FontSize="{DynamicResource FontSizeHeading2}"
								FontFamily="{StaticResource PromptBold}"
								Foreground="#707270"
								VerticalAlignment="Center"
								HorizontalAlignment="Center" />
						</Viewbox>
						<Viewbox
							Stretch="Uniform"
							Grid.Column="1">
							<TextBlock
								Text=" Credit Left"
								FontSize="{DynamicResource FontSizeTextRegular}"
								FontFamily="{StaticResource PromptMedium}"
								Foreground="#707270"
								VerticalAlignment="Center"
								HorizontalAlignment="Center" />
						</Viewbox>
					</Grid>
					<Grid
						Name="BuyNowGrid"
						Column="5">
						<Grid.RowDefinitions>
							<RowDefinition
								Height="48*" />
							<RowDefinition
								Height="96*" />
							<RowDefinition
								Height="48*" />
						</Grid.RowDefinitions>
						<Button
							Name="BuyNowButton"
							Grid.Row="1"
							Style="{StaticResource ButtonWithoutStyle}"
							Click="BuyNowButton_Click">
							<Grid
								Width="{Binding ElementName=BuyNowButton, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*1}"
								Height="{Binding ElementName=BuyNowButton, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*1}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="18*" />
									<ColumnDefinition
										Width="67*" />
									<ColumnDefinition
										Width="14*" />
									<ColumnDefinition
										Width="175*" />
									<ColumnDefinition
										Width="21*" />
								</Grid.ColumnDefinitions>
								<Border
									Name="BackgroundBorder"
									Background="#3B82F6"
									Grid.ColumnSpan="5"
									CornerRadius="{DynamicResource UICornerRadius}" />
								<Border
									Name="BuyNowIconPathBorder"
									Background="#FFFFFFFF"
									Grid.Column="1"
									Margin="3" />
								<Path
									Name="BuyNowIconPath"
									Grid.Column="1"
									Data="{StaticResource TotalCreditsIcon}"
									Fill="#3B82F6"
									Stroke="#00FFFFFF"
									Stretch="Uniform"
									StrokeThickness="2"
									VerticalAlignment="Center"
									HorizontalAlignment="Center" />
								<Viewbox
									Stretch="Uniform"
									Grid.Column="3">
									<TextBlock
										Text="Buy Now"
										Foreground="#FFFFFFFF"
										FontFamily="{StaticResource MontserratBold}"
										FontSize="{DynamicResource FontSizeTextTitle}"
										VerticalAlignment="Center"
										HorizontalAlignment="Center" />
								</Viewbox>
							</Grid>
						</Button>
					</Grid>
				</Grid>
				<Grid
					Name="FaceSwapCostGrid"
					Column="2">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="48*" />
						<ColumnDefinition
							Width="80*" />
						<ColumnDefinition
							Width="24*" />
						<ColumnDefinition
							Width="244*" />
						<ColumnDefinition
							Width="48*" />
						<ColumnDefinition
							Width="210*" />
						<ColumnDefinition
							Width="48*" />
					</Grid.ColumnDefinitions>
					<Border
						Name="FaceSwapCostGridBackgroundBorder"
						Grid.RowSpan="10"
						Grid.ColumnSpan="10"
						Background="#E3E6EB"
						CornerRadius="{DynamicResource SectionCornerRadius}"
						Opacity="1">
						<UIElement.Effect>
							<DropShadowEffect
								Opacity="0.25"
								BlurRadius="20"
								ShadowDepth="10" />
						</UIElement.Effect>
					</Border>
					<Grid
						Name="FaceSwapIconGrid"
						Column="1">
						<Border
							Background="#C329B4"
							Width="{Binding ElementName=FaceSwapIconPath, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.8}"
							Height="{Binding ElementName=FaceSwapIconPath, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.8}" />
						<Path
							Name="FaceSwapIconPath"
							Data="{StaticResource FaceSwapIcon}"
							Fill="#FFC5F9"
							Stroke="#00FFFFFF"
							Stretch="Uniform"
							StrokeThickness="2"
							VerticalAlignment="Center"
							HorizontalAlignment="Center" />
					</Grid>
					<Grid
						Column="3">
						<Grid.RowDefinitions>
							<RowDefinition
								Height="60*" />
							<RowDefinition
								Height="73*" />
							<RowDefinition
								Height="59*" />
						</Grid.RowDefinitions>
						<TextBlock
							Grid.Row="1"
							Text="Face Swap"
							VerticalAlignment="Center"
							HorizontalAlignment="Left"
							FontFamily="{StaticResource PromptBold}"
							FontSize="{DynamicResource FontSizeTextTitle}"
							Foreground="#707270" />
					</Grid>
					<Grid
						Column="5">
						<Grid.RowDefinitions>
							<RowDefinition
								Height="66*" />
							<RowDefinition
								Height="60*" />
							<RowDefinition
								Height="66*" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="Auto" />
							<ColumnDefinition
								Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Name="FaceSwapCredit"
							Grid.Row="1"
							Text="-1 Credit"
							VerticalAlignment="Center"
							HorizontalAlignment="Left"
							FontFamily="{StaticResource PromptMedium}"
							FontSize="{DynamicResource FontSizeTextRegular}"
							Foreground="#707270" />
						<Grid
							Column="1"
							Row="1">
							<Border
								Background="#3A70E2"
								Width="{Binding ElementName=FaceSwapCostIcon, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.8}"
								Height="{Binding ElementName=FaceSwapCostIcon, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.8}" />
							<Path
								Name="FaceSwapCostIcon"
								Grid.Column="1"
								Grid.Row="1"
								Data="{StaticResource TotalCreditsIcon}"
								Fill="#E3E6EB"
								Stroke="#00FFFFFF"
								Stretch="Uniform"
								StrokeThickness="2"
								VerticalAlignment="Center"
								HorizontalAlignment="Center" />
						</Grid>
					</Grid>
				</Grid>
				<Grid
					Name="AIPromptCostGrid"
					Column="4">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="48*" />
						<ColumnDefinition
							Width="80*" />
						<ColumnDefinition
							Width="24*" />
						<ColumnDefinition
							Width="244*" />
						<ColumnDefinition
							Width="48*" />
						<ColumnDefinition
							Width="210*" />
						<ColumnDefinition
							Width="48*" />
					</Grid.ColumnDefinitions>
					<Border
						Name="AIPromptCostGridBackgroundBorder"
						Grid.RowSpan="10"
						Grid.ColumnSpan="10"
						Background="#E3E6EB"
						CornerRadius="{DynamicResource SectionCornerRadius}"
						Opacity="1">
						<UIElement.Effect>
							<DropShadowEffect
								Opacity="0.25"
								BlurRadius="20"
								ShadowDepth="10" />
						</UIElement.Effect>
					</Border>
					<Grid
						Name="AIPromptIconGrid"
						Column="1">
						<Border
							Background="#FE632F"
							Width="{Binding ElementName=FaceSwapIconPath, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.8}"
							Height="{Binding ElementName=FaceSwapIconPath, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.8}" />
						<Path
							Name="AIPromptIconPath"
							Data="{StaticResource AIPromptIcon}"
							Fill="#FFE1D6"
							Stroke="#00FFFFFF"
							Stretch="Uniform"
							StrokeThickness="2"
							VerticalAlignment="Center"
							HorizontalAlignment="Center" />
					</Grid>
					<Grid
						Column="3">
						<Grid.RowDefinitions>
							<RowDefinition
								Height="60*" />
							<RowDefinition
								Height="73*" />
							<RowDefinition
								Height="59*" />
						</Grid.RowDefinitions>
						<TextBlock
							Grid.Row="1"
							Text="AI Prompt"
							VerticalAlignment="Center"
							HorizontalAlignment="Left"
							FontFamily="{StaticResource PromptBold}"
							FontSize="{DynamicResource FontSizeTextTitle}"
							Foreground="#707270" />
					</Grid>
					<Grid
						Column="5">
						<Grid.RowDefinitions>
							<RowDefinition
								Height="66*" />
							<RowDefinition
								Height="60*" />
							<RowDefinition
								Height="66*" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="Auto" />
							<ColumnDefinition
								Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Name="AIPrompCredit"
							Grid.Row="1"
							Text="-10 Credit"
							VerticalAlignment="Center"
							HorizontalAlignment="Left"
							FontFamily="{StaticResource PromptMedium}"
							FontSize="{DynamicResource FontSizeTextRegular}"
							Foreground="#707270" />
						<Grid
							Column="1"
							Row="1">
							<Border
								Background="#3A70E2"
								Width="{Binding ElementName=FaceSwapCostIcon, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.8}"
								Height="{Binding ElementName=FaceSwapCostIcon, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.8}" />
							<Path
								Name="AIPromptCostIcon"
								Grid.Column="1"
								Grid.Row="1"
								Data="{StaticResource TotalCreditsIcon}"
								Fill="#E3E6EB"
								Stroke="#00FFFFFF"
								Stretch="Uniform"
								StrokeThickness="2"
								VerticalAlignment="Center"
								HorizontalAlignment="Center" />
						</Grid>
					</Grid>
				</Grid>
				<Grid
					Name="loadingGifGrid"
					Visibility="Visible"
					ColumnSpan="5">
					<Border
						CornerRadius="20"
						Background="#FF000000"
						Opacity="0.5" />
					<Grid
						Name="LoadingDotsContainer">
						<lottie:LottieAnimationView
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							AutoPlay="True"
							FileName="Animations/LoadingDots.json"
							RepeatCount="-1"
							Width="{Binding ElementName=LoadingDotsContainer, Path=ActualWidth}"
							Height="{Binding ElementName=LoadingDotsContainer, Path=ActualHeight}" />
					</Grid>
				</Grid>
			</Grid>
		</Grid>
	</Grid>
</activationking:SettingsSubPage>
