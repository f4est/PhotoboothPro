<activationking:SettingsSubPage
	x:Class="KingAIPhotoBoothPro.Pages.EventManagementPage" xmlns:activationking="clr-namespace:KingAIPhotoBoothPro.Pages.ActivationKing" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:class="clr-namespace:KingAIPhotoBoothPro.Class" xmlns:localUI="clr-namespace:KingAIPhotoBoothPro.Class.UI" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:behaviors="clr-namespace:KingAIPhotoBoothPro.Pages.Behaviors" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages" xmlns:class1="clr-namespace:KingAIPhotoBoothPro.Class" xmlns:math="http://hexinnovation.com/math" xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
	activationking:Loaded="Page_Loaded"
	activationking:Unloaded="SettingsSubPage_Unloaded"
	Title="EventManagementPage">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<math:MathConverter
				x:Key="math" />
			<Style
				TargetType="{x:Type Thumb}"
				x:Key="CustomThumbStyle">
				<Setter
					Property="Background"
					Value="#FFADD8E6" />
				<Style.Triggers>
					<Trigger
						Property="UIElement.IsMouseOver"
						Value="True">
						<Setter
							Property="Background"
							Value="#FF00008B" />
					</Trigger>
				</Style.Triggers>
			</Style>
			<Style
				TargetType="{x:Type ScrollBar}"
				x:Key="CustomVerticalScrollBar">
				<Setter
					Property="Width"
					Value="15" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type ScrollBar}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition
										Height="Auto" />
									<RowDefinition
										Height="*" />
									<RowDefinition
										Height="Auto" />
								</Grid.RowDefinitions>
								<RepeatButton
									Grid.Row="0"
									Height="16"
									Command="ScrollBar.LineUpCommand"
									Content="M 0 4 L 8 4 L 4 0 Z" />
								<Track
									Name="PART_Track"
									Grid.Row="1">
									<Track.Thumb>
										<Thumb
											Style="{StaticResource CustomThumbStyle}" />
									</Track.Thumb>
								</Track>
								<RepeatButton
									Grid.Row="2"
									Height="16"
									Command="ScrollBar.LineDownCommand"
									Content="M 0 0 L 4 4 L 8 0 Z" />
							</Grid>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="gridMain"
		Background="#00FFFFFF">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="0" />
			<RowDefinition
				Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.26+1}" />
			<RowDefinition
				Height="20" />
			<RowDefinition
				Height="1*" />
			<RowDefinition
				Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.02+1}" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="150*" />
			<ColumnDefinition
				Width="2662*" />
			<ColumnDefinition
				Width="128*" />
		</Grid.ColumnDefinitions>
		<Image
			Visibility="Collapsed"
			Source="/Images/Templates/Event Settings.png"
			Grid.RowSpan="10"
			Grid.ColumnSpan="10"
			Opacity="0.3" />
		<Grid
			Row="1"
			Column="1"
			MinHeight="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.26+1}">
			<Frame
				Name="EventFrame"
				Source="/Pages/ActivationKing/CurrentEventPage.xaml"
				NavigationUIVisibility="Hidden" />
			<Grid
				Name="EventLoadingGrid"
				Visibility="Collapsed">
				<Border
					Background="#F0F2F8"
					Grid.ColumnSpan="10"
					Grid.RowSpan="10" />
				<Grid
					Name="LoadingContainer"
					VerticalAlignment="Center"
					HorizontalAlignment="Center"
					Width="{Binding ElementName=EventFrame, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.33+1}"
					Height="{Binding ElementName=EventFrame, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.33+1}">
					<lottie:LottieAnimationView
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						AutoPlay="True"
						FileName="Animations/LoadingDots.json"
						RepeatCount="-1"
						Width="{Binding ElementName=LoadingContainer, Path=ActualWidth}"
						Height="{Binding ElementName=LoadingContainer, Path=ActualHeight}" />
				</Grid>
			</Grid>
		</Grid>
		<Grid
			Name="gridFrame"
			Row="3"
			Column="1"
			Visibility="Hidden"
			MinHeight="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.2}">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="{Binding ElementName=gridFrame, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.075+1}" />
				<RowDefinition
					Height="{Binding ElementName=gridFrame, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.0+1}" />
				<RowDefinition
					Height="{Binding ElementName=gridFrame, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.0+1}" />
				<RowDefinition
					Height="*" />
				<RowDefinition
					Height="{Binding ElementName=gridFrame, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.05+1}" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="88*" />
				<ColumnDefinition
					Width="1474*" />
				<ColumnDefinition
					Width="48*" />
				<ColumnDefinition
					Width="32*" />
				<ColumnDefinition
					Width="932*" />
				<ColumnDefinition
					Width="88*" />
			</Grid.ColumnDefinitions>
			<class1:SectionTemplate
				Template="{StaticResource SectionTemplateKey}"
				Content="Event Archive"
				Background="#FFFFFFFF"
				BorderBrush="#BABFC5"
				Grid.RowSpan="15"
				Grid.ColumnSpan="6" />
			<StackPanel
				Name="infoGrid"
				Orientation="Horizontal"
				HorizontalAlignment="Right"
				Grid.Row="0"
				Grid.Column="2"
				Grid.ColumnSpan="3">
				<Path
					Name="infoImage"
					Grid.Column="0"
					Stretch="Uniform"
					Fill="{DynamicResource UIGray}"
					MaxHeight="{DynamicResource CheckBoxHeight}"
					VerticalAlignment="Center">
					<Path.Data>
						<GeometryGroup>
							<Geometry>M0.5 30C0.5 13.7072 13.7072 0.5 30 0.5C46.2928 0.5 59.5 13.7072 59.5 30C59.5 46.292 46.294 59.4987 30.0023 59.5C25.0095 59.5075 20.1005 58.2424 15.7372 55.8283L3.67461 58.0746C3.18849 58.1651 2.68899 58.0103 2.33934 57.6606C1.98969 57.311 1.83482 56.8115 1.92535 56.3254L4.17163 44.263C1.83138 40.0361 0.5 35.169 0.5 30ZM30 3.5C15.364 3.5 3.5 15.3641 3.5 30C3.5 34.8283 4.79063 39.3551 7.04456 43.2485C7.22402 43.5585 7.28662 43.9224 7.22105 44.2746L5.27494 54.725L15.7254 52.7789C16.0774 52.7134 16.4412 52.7759 16.7511 52.9552C20.7769 55.2841 25.3469 56.507 29.9977 56.5L30 56.5C44.6359 56.5 56.5 44.6359 56.5 30C56.5 15.3641 44.6359 3.5 30 3.5Z</Geometry>
							<Geometry>M30 13.5C31.3807 13.5 32.5 14.6193 32.5 16L32.5 17C32.5 18.3807 31.3807 19.5 30 19.5C28.6193 19.5 27.5 18.3807 27.5 17L27.5 16C27.5 14.6193 28.6193 13.5 30 13.5Z</Geometry>
							<Geometry>M30 23.5C31.3807 23.5 32.5 24.6193 32.5 26L32.5 43C32.5 44.3807 31.3807 45.5 30 45.5C28.6193 45.5 27.5 44.3807 27.5 43L27.5 26C27.5 24.6193 28.6193 23.5 30 23.5Z</Geometry>
						</GeometryGroup>
					</Path.Data>
				</Path>
				<TextBlock
					Margin="10,0,0,0"
					Grid.Column="2"
					FontFamily="{StaticResource PromptRegular}"
					FontSize="{DynamicResource FontSizeTextSmall}"
					Foreground="#82868C"
					VerticalAlignment="Center"
					HorizontalAlignment="Left">You can re-use past events from the Event Archive.</TextBlock>
			</StackPanel>
			<ScrollViewer
				Name="ScrollEventArchive"
				Grid.Row="3"
				Grid.Column="1"
				Grid.ColumnSpan="4"
				VerticalScrollBarVisibility="Hidden">
				<i:Interaction.Behaviors>
					<localUI:ScrollViewerDragBehavior />
					<behaviors:ScrollViewerBottomBehavior
						x:Name="scrollBehavior"
						Threshold="1" />
				</i:Interaction.Behaviors>
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<Style
							TargetType="{x:Type ScrollBar}"
							x:Key="CustomVerticalScrollBar">
							<Setter
								Property="Template">
								<Setter.Value>
									<ControlTemplate
										TargetType="{x:Type ScrollBar}">
										<Grid>
											<Grid.RowDefinitions>
												<RowDefinition
													Height="Auto" />
												<RowDefinition
													Height="*" />
												<RowDefinition
													Height="Auto" />
											</Grid.RowDefinitions>
											<RepeatButton
												Grid.Row="0"
												Height="16"
												Content="▲"
												Command="ScrollBar.LineUpCommand" />
											<Track
												Name="PART_Track"
												Grid.Row="1">
												<Track.DecreaseRepeatButton>
													<RepeatButton
														Command="ScrollBar.PageUpCommand" />
												</Track.DecreaseRepeatButton>
												<Track.Thumb>
													<Thumb
														Width="12"
														Background="#FF808080" />
												</Track.Thumb>
												<Track.IncreaseRepeatButton>
													<RepeatButton
														Command="ScrollBar.PageDownCommand" />
												</Track.IncreaseRepeatButton>
											</Track>
											<RepeatButton
												Grid.Row="2"
												Height="16"
												Content="▼"
												Command="ScrollBar.LineDownCommand" />
										</Grid>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
						<Style
							TargetType="{x:Type ScrollBar}"
							BasedOn="{StaticResource {x:Type ScrollBar}}"
							x:Key="CustomHorizontalScrollBar">
							<Setter
								Property="Template">
								<Setter.Value>
									<ControlTemplate
										TargetType="{x:Type ScrollBar}">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition
													Width="Auto" />
												<ColumnDefinition
													Width="*" />
												<ColumnDefinition
													Width="Auto" />
											</Grid.ColumnDefinitions>
											<RepeatButton
												Grid.Column="0"
												Width="16"
												Content="◄"
												Command="ScrollBar.LineLeftCommand" />
											<Track
												Name="PART_Track"
												Grid.Column="1">
												<Track.DecreaseRepeatButton>
													<RepeatButton
														Command="ScrollBar.PageLeftCommand" />
												</Track.DecreaseRepeatButton>
												<Track.Thumb>
													<Thumb
														Height="12"
														Background="#FF808080" />
												</Track.Thumb>
												<Track.IncreaseRepeatButton>
													<RepeatButton
														Command="ScrollBar.PageRightCommand" />
												</Track.IncreaseRepeatButton>
											</Track>
											<RepeatButton
												Grid.Column="2"
												Width="16"
												Content="►"
												Command="ScrollBar.LineRightCommand" />
										</Grid>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</ResourceDictionary>
				</FrameworkElement.Resources>
				<StackPanel
					Name="EventList"
					Orientation="Vertical" />
			</ScrollViewer>
		</Grid>
	</Grid>
</activationking:SettingsSubPage>
