													<ContentPresenter
														HorizontalAlignment="Center"
														VerticalAlignment="Center" />
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<Setter
										Property="Foreground"
										Value="{DynamicResource AppUIColor}" />
									<Style.Triggers>
										<Trigger
											Property="UIElement.IsMouseOver"
											Value="True">
											<Setter
												Property="UIElement.Opacity"
												Value="0.7" />
										</Trigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
						</Button>
					</Grid>
				</Grid>
			</Grid>
		</Grid>
	</Grid>
</Page>
