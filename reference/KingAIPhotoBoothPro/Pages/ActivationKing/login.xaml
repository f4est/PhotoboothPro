<Page
	x:Class="KingAIPhotoBoothPro.Pages.Login" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages" xmlns:class="clr-namespace:KingAIPhotoBoothPro.Class" xmlns:math="http://hexinnovation.com/math" xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
	Title="Login"
	Loaded="Login_Loaded"
	Unloaded="Page_Unloaded"
	SizeChanged="Page_SizeChanged"
	KeyDown="Page_KeyDown">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<math:MathConverter
				x:Key="math" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="gridMain">
		<Image
			Source="/Images/LoginPage/ActivationKingBG.jpg"
			Stretch="UniformToFill"
			HorizontalAlignment="Center" />
		<Image
			Name="logo"
			HorizontalAlignment="Left"
			VerticalAlignment="Top"
			Source="/Images/Logo.png"
			Grid.Row="0"
			Grid.Column="0"
			Margin="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.03}"
			Width="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.11+1}"
			Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.09+1}" />
		<Grid
			Name="gridLayout">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="43*" />
				<RowDefinition
					Height="112*"
					MinHeight="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.33}" />
				<RowDefinition
					Height="43*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="21*" />
				<ColumnDefinition
					Width="47*" />
				<ColumnDefinition
					Width="21*" />
			</Grid.ColumnDefinitions>
			<Grid
				Name="LoginPanel"
				Row="1"
				Column="1"
				Visibility="Visible">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="1*" />
					<ColumnDefinition
						Width="1*" />
				</Grid.ColumnDefinitions>
				<Border
					Background="#FFFFFFFF"
					CornerRadius="10"
					Grid.ColumnSpan="2">
					<UIElement.Effect>
						<DropShadowEffect
							Opacity="0.5"
							BlurRadius="40"
							ShadowDepth="10" />
					</UIElement.Effect>
				</Border>
				<Border
					Name="leftPanelCover"
					VerticalAlignment="Stretch"
					Grid.Column="0"
					Background="#FF0000FF"
					CornerRadius="10"
					Visibility="Visible"
					Loaded="leftPanelCover_Loaded" />
				<Grid
					Name="LeftGroup"
					Margin="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.026+1}">
					<Grid.RowDefinitions>
						<RowDefinition
							Height="10*" />
						<RowDefinition
							Height="20*" />
						<RowDefinition
							Height="20*" />
						<RowDefinition
							Height="20*" />
						<RowDefinition
							Height="17*" />
						<RowDefinition
							Height="10*" />
						<RowDefinition
							Height="13*" />
						<RowDefinition
							Height="10*" />
					</Grid.RowDefinitions>
					<Viewbox
						Grid.Row="1">
						<TextBlock
							Name="TitleApp"
							Text="DSLRPHOTOBOOTH"
							VerticalAlignment="Center"
							HorizontalAlignment="Left"
							Foreground="#FFFFFFFF"
							FontSize="{DynamicResource FontSizeDisplay1}"
							FontFamily="{StaticResource PromptMedium}" />
					</Viewbox>
					<TextBlock
						Name="TitleAppVersion"
						Grid.Row="2"
						Margin="5,0,0,0"
						Text="v1.0.0.0"
						VerticalAlignment="Top"
						HorizontalAlignment="Left"
						Foreground="#FFFFFFFF"
						FontSize="{DynamicResource FontSizeTextTitle}"
						FontFamily="{StaticResource PromptMedium}" />
					<TextBlock
						Name="TitleAppDesc"
						TextWrapping="WrapWithOverflow"
						Text="This software enables you to handle your event photos and videos with an all in one solution."
						Grid.Row="2"
						Grid.RowSpan="2"
						VerticalAlignment="Center"
						HorizontalAlignment="Left"
						Foreground="#FFFFFFFF"
						FontSize="{DynamicResource FontSizeTextSmall}"
						FontFamily="{StaticResource PromptMedium}" />
					<Grid
						Row="4">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="1*" />
							<ColumnDefinition
								Width="1*" />
						</Grid.ColumnDefinitions>
						<Button
							Name="MoreInfoButton"
							FontSize="20"
							Margin="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.003+1}"
							Click="MoreInfoButton_Click">
							<UIElement.Effect>
								<DropShadowEffect
									Opacity="0.25"
									BlurRadius="20"
									ShadowDepth="10" />
							</UIElement.Effect>
							<FrameworkElement.Style>
								<Style
									TargetType="{x:Type Button}">
									<Setter
										Property="Background"
										Value="#FFFFFFFF" />
									<Setter
										Property="Template">
										<Setter.Value>
											<ControlTemplate
												TargetType="{x:Type Button}">
												<Border
													Background="#FFFFFFFF"
													CornerRadius="{Binding Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.5+1, RelativeSource={RelativeSource Self}}">
													<ContentPresenter
														HorizontalAlignment="Center"
														VerticalAlignment="Center" />
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<Style.Triggers>
										<Trigger
											Property="UIElement.IsMouseOver"
											Value="True">
											<Setter
												Property="UIElement.Opacity"
												Value="0.7" />
										</Trigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
							<DockPanel>
								<Image
									Name="cubeImage"
									Source="/Images/cube.png"
									Stretch="Uniform"
									Margin="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.007+1}" />
								<TextBlock
									Name="MoreInfoTxt"
									ToolTip="Read Support Documents"
									ToolTipService.InitialShowDelay="0"
									VerticalAlignment="Center"
									FontSize="{DynamicResource FontSizeTextRegular}"
									Foreground="{DynamicResource AppUIColor}">Documents</TextBlock>
							</DockPanel>
						</Button>
						<Button
							Name="SupportButton"
							BorderThickness="0"
							Grid.Column="1"
							FontSize="20"
							Margin="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.003+1}"
							Click="SupportButton_Click">
							<UIElement.Effect>
								<DropShadowEffect
									Opacity="0.25"
									BlurRadius="20"
									ShadowDepth="10" />
							</UIElement.Effect>
							<FrameworkElement.Style>
								<Style
									TargetType="{x:Type Button}">
									<Setter
										Property="Background"
										Value="#FFFFFFFF" />
									<Setter
										Property="Template">
										<Setter.Value>
											<ControlTemplate
												TargetType="{x:Type Button}">
												<Border
													Background="#FFFFFFFF"
													CornerRadius="{Binding Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.5+1, RelativeSource={RelativeSource Self}}">
													<ContentPresenter
														HorizontalAlignment="Center"
														VerticalAlignment="Center" />
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<Style.Triggers>
										<Trigger
											Property="UIElement.IsMouseOver"
											Value="True">
											<Setter
												Property="UIElement.Opacity"
												Value="0.9" />
										</Trigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
							<DockPanel>
								<Image
									Name="speechImage"
									Source="/Images/SpeechBalloon.png"
									Stretch="Uniform"
									Margin="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.007+1}" />
								<TextBlock
									Name="supportTxt"
									ToolTip="Watch Youtube Video Tutorials!"
									ToolTipService.InitialShowDelay="0"
									VerticalAlignment="Center"
									FontSize="{DynamicResource FontSizeTextRegular}"
									Foreground="{DynamicResource AppUIColor}">Tutorials</TextBlock>
							</DockPanel>
						</Button>
					</Grid>
					<Grid
						Name="UpdateGrid"
						Row="6"
						Visibility="Hidden"
						Width="{Binding ElementName=LeftBottomPanelGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*1}">
						<Button
							Name="btnUpdate"
							BorderThickness="0"
							HorizontalAlignment="Left"
							Content="Update"
							Foreground="{DynamicResource AppUIColorLight}"
							FontFamily="{StaticResource PromptMedium}"
							FontSize="{DynamicResource FontSizeTextRegular}"
							Background="#FFFFFFFF"
							Width="{Binding ElementName=UpdateGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x}"
							Click="btnUpdate_Click">
							<UIElement.Effect>
								<DropShadowEffect
									Opacity="0.25"
									BlurRadius="20"
									ShadowDepth="10" />
							</UIElement.Effect>
							<FrameworkElement.Style>
								<Style
									TargetType="{x:Type Button}">
									<Setter
										Property="Template">
										<Setter.Value>
											<ControlTemplate
												TargetType="{x:Type Button}">
												<Border
													Background="{TemplateBinding Background}"
													BorderBrush="{DynamicResource AppUIColor}"
													BorderThickness="{Binding ElementName=btnUpdate, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.03}"
													CornerRadius="{Binding ElementName=btnUpdate, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.5}">
													<ContentPresenter
														HorizontalAlignment="Center"
														VerticalAlignment="Center" />
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<Style.Triggers>
										<Trigger
											Property="UIElement.IsMouseOver"
											Value="True">
											<Setter
												Property="UIElement.Opacity"
												Value="0.9" />
										</Trigger>
										<Trigger
											Property="IsEnabled"
											Value="False">
											<Setter
												Property="UIElement.Opacity"
												Value="0.7" />
										</Trigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
						</Button>
						<Image
							Source="/Images/update.png"
							HorizontalAlignment="Right"
							Stretch="Uniform"
							Margin="{Binding ElementName=UpdateGrid, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.1}" />
					</Grid>
				</Grid>
				<Grid
					Name="RightGroup"
					Column="1"
					Margin="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.016+1}">
					<Grid.RowDefinitions>
						<RowDefinition
							Height="1*" />
						<RowDefinition
							Height="8*" />
						<RowDefinition
							Height="9*" />
						<RowDefinition
							Height="14*" />
						<RowDefinition
							Height="2*" />
						<RowDefinition
							Height="7*" />
						<RowDefinition
							Height="2*" />
						<RowDefinition
							Height="9*" />
					</Grid.RowDefinitions>
					<Label
						Name="SignText"
						Content="Sign in"
						Grid.Row="1"
						VerticalAlignment="Center"
						HorizontalAlignment="Center"
						Foreground="{DynamicResource AppUIColorLight}"
						FontSize="{DynamicResource FontSizeHeading1}"
						FontFamily="{StaticResource PromptBold}" />
					<TextBlock
						Grid.Row="2"
						VerticalAlignment="Center"
						HorizontalAlignment="Center"
						TextWrapping="Wrap"
						TextAlignment="Center"
						Foreground="{StaticResource UIGrayDark}"
						FontWeight="SemiBold"
						FontSize="{DynamicResource FontSizeTextRegular}">
						<Span
							FontFamily="{StaticResource MontserratBold}"
							FontWeight="Bold">Welcome on board!</Span>
						<LineBreak />
						<Span
							FontFamily="{StaticResource MontserratSemiBold}">Please login with your credentials</Span>
					</TextBlock>
					<Grid
						Row="3">
						<Grid.RowDefinitions>
							<RowDefinition
								Height="1*" />
							<RowDefinition
								Height="1*" />
						</Grid.RowDefinitions>
						<Grid
							Name="gridInputField"
							Row="0"
							ClipToBounds="False"
							Height="{DynamicResource UIInputHeight}"
							Margin="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.005+1}">
							<Border
								Style="{DynamicResource BorderInputStyle}" />
							<TextBox
								Name="MailBox"
								x:Uid="2"
								HorizontalAlignment="Left"
								VerticalContentAlignment="Center"
								VerticalAlignment="Center"
								Foreground="{DynamicResource UIGrayDark}"
								TextAlignment="Left"
								FontFamily="{StaticResource MontserratRegular}"
								BorderThickness="0"
								FontSize="{DynamicResource FontSizeTextSmall}"
								Padding="10,0,0,0"
								Background="#00FFFFFF"
								Height="{Binding ElementName=gridInputField, Path=ActualHeight}"
								Width="{Binding ElementName=gridInputField, Path=ActualWidth}"
								TextChanged="MailBox_TextChanged"
								LostFocus="MailBox_LostFocus" />
							<Button
								Name="MailBoxPlaceholder"
								x:Uid="0"
								HorizontalAlignment="Left"
								VerticalAlignment="Center"
								Foreground="#FFCAC8C8"
								FontFamily="{StaticResource PromptExtraLight}"
								BorderThickness="0"
								FontSize="{DynamicResource FontSizeTextSmall}"
								Content="Mail Address"
								RenderTransformOrigin="0,0.5"
								Background="#00FFFFFF"
								Width="{Binding ElementName=gridInputField, Path=ActualWidth}"
								Click="Focus_Click">
								<FrameworkElement.Style>
									<Style
										TargetType="{x:Type Button}">
										<Setter
											Property="Background"
											Value="#00FFFFFF" />
										<Setter
											Property="Template">
											<Setter.Value>
												<ControlTemplate
													TargetType="{x:Type Button}">
													<Border
														Background="{TemplateBinding Background}">
														<ContentPresenter
															HorizontalAlignment="Left"
															Margin="10,0,0,0"
															VerticalAlignment="Center" />
													</Border>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
										<Style.Triggers>
											<Trigger
												Property="UIElement.IsMouseOver"
												Value="True">
												<Setter
													Property="Background"
													Value="#FFA0A0A0" />
											</Trigger>
										</Style.Triggers>
									</Style>
								</FrameworkElement.Style>
							</Button>
						</Grid>
						<Grid
							Name="gridCodeInput"
							Row="1"
							Height="{DynamicResource UIInputHeight}"
							Margin="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.005+1}">
							<Border
								Style="{DynamicResource BorderInputStyle}" />
							<TextBox
								Name="LicenceKeyBox"
								x:Uid="3"
								HorizontalAlignment="Left"
								VerticalAlignment="Center"
								VerticalContentAlignment="Center"
								Foreground="#FF707270"
								FontFamily="{StaticResource MontserratRegular}"
								BorderThickness="0"
								FontSize="{DynamicResource FontSizeTextSmall}"
								Padding="10,0,0,0"
								Background="#00FFFFFF"
								Height="{Binding ElementName=gridCodeInput, Path=ActualHeight}"
								Width="{Binding ElementName=gridCodeInput, Path=ActualWidth}"
								LostFocus="LicenceKeyBox_LostFocus"
								GotFocus="LicenceKeyBox_GotFocus"
								TextChanged="LicenceKeyBox_PasswordChanged" />
							<Button
								Name="LicenceKeyPlaceholder"
								x:Uid="1"
								Background="#00FFFFFF"
								Grid.Row="1"
								HorizontalAlignment="Left"
								VerticalAlignment="Center"
								Foreground="#FFCAC8C8"
								FontFamily="{StaticResource PromptExtraLight}"
								BorderThickness="0"
								FontSize="{DynamicResource FontSizeTextSmall}"
								Content="Code"
								Width="{Binding ElementName=gridInputField, Path=ActualWidth}"
								Height="{Binding ElementName=gridInputField, Path=ActualHeight}"
								Click="Focus_Click">
								<FrameworkElement.Style>
									<Style
										TargetType="{x:Type Button}">
										<Setter
											Property="Background"
											Value="#00FFFFFF" />
										<Setter
											Property="Template">
											<Setter.Value>
												<ControlTemplate
													TargetType="{x:Type Button}">
													<Border
														Background="{TemplateBinding Background}">
														<ContentPresenter
															HorizontalAlignment="Left"
															Margin="10,0,0,0"
															VerticalAlignment="Center" />
													</Border>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
										<Style.Triggers>
											<Trigger
												Property="UIElement.IsMouseOver"
												Value="True">
												<Setter
													Property="Background"
													Value="#FFA0A0A0" />
											</Trigger>
										</Style.Triggers>
									</Style>
								</FrameworkElement.Style>
							</Button>
						</Grid>
					</Grid>
					<Label
						Name="debugText"
						Grid.Row="4"
						Foreground="#FFFF0000"
						VerticalAlignment="Center"
						HorizontalAlignment="Center"
						FontSize="{DynamicResource FontSizeTextSmall}"
						Margin="-5" />
					<Grid
						Row="5">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="1*" />
								<ColumnDefinition
									Width="1*" />
							</Grid.ColumnDefinitions>
							<Button
								Name="SubscribeNowButton"
								Background="#FFFAEBD7"
								BorderThickness="0"
								Margin="5"
								Content="Subscribe Now"
								FontFamily="{StaticResource MontserratSemiBold}"
								FontSize="{DynamicResource FontSizeButtonSmall}"
								Foreground="#FF777777"
								Click="SubscribeNowButton_Click">
								<FrameworkElement.Style>
									<Style
										TargetType="{x:Type Button}">
										<Setter
											Property="Background"
											Value="#FFFFFFFF" />
										<Setter
											Property="Template">
											<Setter.Value>
												<ControlTemplate
													TargetType="{x:Type Button}">
													<Border
														Background="#FFFFFFFF"
														BorderBrush="{TemplateBinding Background}"
														BorderThickness="{Binding ElementName=CancelButtonTrial, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.05}"
														CornerRadius="{Binding ElementName=CancelButtonTrial, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.5}">
														<ContentPresenter
															HorizontalAlignment="Center"
															VerticalAlignment="Center" />
													</Border>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
										<Style.Triggers>
											<Trigger
												Property="UIElement.IsMouseOver"
												Value="True">
												<Setter
													Property="UIElement.Opacity"
													Value="0.7" />
											</Trigger>
										</Style.Triggers>
									</Style>
								</FrameworkElement.Style>
							</Button>
							<Button
								Name="SignButton"
								IsDefault="True"
								BorderThickness="0"
								Grid.Column="1"
								Content="Sign In"
								Foreground="#FFFFFFFF"
								FontFamily="{StaticResource PromptMedium}"
								FontSize="{DynamicResource FontSizeButtonPrimary}"
								Margin="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.0024+1}"
								Click="SignButton_Click">
								<UIElement.Effect>
									<DropShadowEffect
										Opacity="0.25"
										BlurRadius="20"
										ShadowDepth="10" />
								</UIElement.Effect>
								<FrameworkElement.Style>
									<Style
										TargetType="{x:Type Button}">
										<Setter
											Property="Template">
											<Setter.Value>
												<ControlTemplate
													TargetType="{x:Type Button}">
													<Border
														Name="borderCreateButton"
														Background="{TemplateBinding Background}"
														CornerRadius="{Binding Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.5+1, RelativeSource={RelativeSource Self}}">
														<ContentPresenter
															HorizontalAlignment="Center"
															VerticalAlignment="Center" />
													</Border>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
										<Style.Triggers>
											<Trigger
												Property="UIElement.IsMouseOver"
												Value="True">
												<Setter
													Property="UIElement.Opacity"
													Value="0.7" />
											</Trigger>
										</Style.Triggers>
									</Style>
								</FrameworkElement.Style>
							</Button>
						</Grid>
					</Grid>
					<Grid
						Row="6"
						Background="#c9c9c9"
						Margin="20,0,20,0"
						Height="1" />
					<Grid
						Row="7">
						<Grid.RowDefinitions>
							<RowDefinition
								Height="1*" />
							<RowDefinition
								Height="2*" />
						</Grid.RowDefinitions>
						<Button
							Name="ForgotButton"
							BorderThickness="0"
							FontFamily="{StaticResource MontserratSemiBold}"
							Click="ForgotButton_Click">
							<Control.Background>
								<ImageBrush
									ImageSource="/Images/Button.png"
									Stretch="Uniform" />
							</Control.Background>
							<FrameworkElement.Style>
								<Style
									TargetType="{x:Type Button}">
									<Setter
										Property="Background"
										Value="#FFFFFFFF" />
									<Setter
										Property="Template">
										<Setter.Value>
											<ControlTemplate
												TargetType="{x:Type Button}">
												<Border
													Background="{TemplateBinding Background}">
													<ContentPresenter
														HorizontalAlignment="Center"
														VerticalAlignment="Center" />
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<Style.Triggers>
										<Trigger
											Property="UIElement.IsMouseOver"
											Value="True">
											<Setter
												Property="UIElement.Opacity"
												Value="0.7" />
										</Trigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
							<TextBlock
								FontFamily="{StaticResource MontserratMedium}"
								FontSize="{DynamicResource FontSizeTextSmall}"
								Foreground="#FF777777">Forgot Code? <Span
									Name="SpanGetCode"
									Foreground="#000000">Get a New Code!</Span></TextBlock>
						</Button>
						<Button
							Name="TrialButton"
							Grid.Row="1"
							IsDefault="True"
							BorderThickness="0"
							Grid.Column="1"
							Content="Activate Free Trial"
							Foreground="#FFFFFFFF"
							FontFamily="{StaticResource PromptRegular}"
							FontSize="{DynamicResource FontSizeButtonPrimary}"
							Background="{DynamicResource UISuccessColor}"
							Margin="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.004}"
							Click="TrialButton_Click">
							<UIElement.Effect>
								<DropShadowEffect
									Opacity="0.25"
									BlurRadius="20"
									ShadowDepth="10" />
							</UIElement.Effect>
							<FrameworkElement.Style>
								<Style
									TargetType="{x:Type Button}">
									<Setter
										Property="Template">
										<Setter.Value>
											<ControlTemplate
												TargetType="{x:Type Button}">
												<Border
