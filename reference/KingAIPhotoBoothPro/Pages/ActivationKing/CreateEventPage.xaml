<Page
	x:Class="KingAIPhotoBoothPro.Pages.ActivationKing.CreateEventPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages.ActivationKing" xmlns:math="http://hexinnovation.com/math" xmlns:modals="clr-namespace:KingAIPhotoBoothPro.Modals" xmlns:class="clr-namespace:KingAIPhotoBoothPro.Class"
	Title="CreateEventPage"
	Loaded="Page_Loaded"
	Unloaded="Page_Unloaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<math:MathConverter
				x:Key="math" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="gridMain">
		<Border
			Grid.RowSpan="10"
			Grid.ColumnSpan="10"
			Background="#FFFFFFFF"
			CornerRadius="{DynamicResource SectionCornerRadius}"
			Opacity="1">
			<UIElement.Effect>
				<DropShadowEffect
					Opacity="0.25"
					BlurRadius="20"
					ShadowDepth="10" />
			</UIElement.Effect>
			<Border.BorderBrush>
				<LinearGradientBrush
					EndPoint="0.5,1"
					StartPoint="0.5,0">
					<GradientStop
						Color="White"
						Offset="0" />
					<GradientStop
						Color="#FFD5D5D5"
						Offset="1" />
				</LinearGradientBrush>
			</Border.BorderBrush>
		</Border>
		<Image
			Source="/Images/Templates/CreateEvent.png"
			Opacity="0" />
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.065+1}" />
				<RowDefinition
					Height="0*" />
				<RowDefinition
					Height="1*" />
				<RowDefinition
					Height="0*" />
				<RowDefinition
					Height="1*" />
				<RowDefinition
					Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.01}" />
				<RowDefinition
					Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.038}" />
				<RowDefinition
					Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.02}" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="88*" />
				<ColumnDefinition
					Width="2486*" />
				<ColumnDefinition
					Width="88*" />
			</Grid.ColumnDefinitions>
			<class:SectionTemplate
				Template="{StaticResource SectionTemplateKey}"
				Content="Create/Edit Event"
				Background="#FFFFFFFF"
				BorderBrush="#BABFC5"
				Grid.RowSpan="10"
				Grid.ColumnSpan="10" />
			<Grid
				Name="eventNameGrid"
				Row="2"
				Column="1"
				VerticalAlignment="Top">
				<Grid.RowDefinitions>
					<RowDefinition
						Height="54*" />
					<RowDefinition
						Height="12*" />
					<RowDefinition
						Height="80*" />
				</Grid.RowDefinitions>
				<TextBlock
					Name="txtEventName"
					Grid.Row="0"
					Foreground="{DynamicResource UIGrayDark}"
					VerticalAlignment="Center"
					FontFamily="{StaticResource PromptMedium}"
					FontSize="{DynamicResource FontSizeHeading3}"
					Text="Event Name" />
				<Grid
					Name="newEventGrid"
					Row="2"
					Column="0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="1165*" />
						<ColumnDefinition
							Width="48*" />
						<ColumnDefinition
							Width="56*" />
						<ColumnDefinition
							Width="24*" />
						<ColumnDefinition
							Width="1193*" />
					</Grid.ColumnDefinitions>
					<Grid
						Name="gridInputField"
						Column="0"
						Height="{DynamicResource UIInputHeight}">
						<Border
							Name="borderEventName"
							Style="{StaticResource BorderInputStyle}" />
						<TextBox
							Name="EventNameText"
							x:Uid="2"
							HorizontalAlignment="Left"
							VerticalAlignment="Center"
							Foreground="{DynamicResource UIGrayDark}"
							VerticalContentAlignment="Center"
							TextAlignment="Left"
							FontFamily="{StaticResource MontserratMedium}"
							BorderThickness="0"
							FontSize="{DynamicResource FontSizeTextSmall}"
							Text=""
							Padding="10,0,0,0"
							Grid.ColumnSpan="2"
							Background="#00FFFFFF"
							Height="{Binding ElementName=gridInputField, Path=ActualHeight}"
							Width="{Binding ElementName=gridInputField, Path=ActualWidth}"
							TextChanged="EventNameText_TextChanged"
							LostFocus="EventNameText_LostFocus" />
						<Button
							Name="EventNamePlaceholder"
							x:Uid="0"
							HorizontalAlignment="Left"
							VerticalAlignment="Center"
							Foreground="#FFCAC8C8"
							FontFamily="{StaticResource MontserratMedium}"
							BorderThickness="0"
							FontSize="{DynamicResource FontSizeTextSmall}"
							Content="New Event"
							RenderTransformOrigin="0,0.5"
							Background="#00FFFFFF"
							BorderBrush="#00707070"
							Grid.ColumnSpan="2"
							Width="{Binding ElementName=gridInputField, Path=ActualWidth}"
							Height="{Binding ElementName=gridInputField, Path=ActualHeight}"
							Click="Placeholder_Click">
							<FrameworkElement.Style>
								<Style
									TargetType="{x:Type Button}">
									<Setter
										Property="Background"
										Value="#00FFFFFF" />
									<Setter
										Property="Template">
										<Setter.Value>
											<ControlTemplate
												TargetType="{x:Type Button}">
												<Border
													Background="{TemplateBinding Background}">
													<ContentPresenter
														HorizontalAlignment="Left"
														Margin="10,0,0,0"
														VerticalAlignment="Center" />
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<Style.Triggers>
										<Trigger
											Property="UIElement.IsMouseOver"
											Value="True">
											<Setter
												Property="Background"
												Value="#FFA0A0A0" />
										</Trigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
						</Button>
					</Grid>
					<Path
						Name="infoIcon"
						Grid.Column="2"
						Stretch="Uniform"
						Fill="#82868C">
						<Path.Data>
							<GeometryGroup>
								<Geometry>M0.5 30C0.5 13.7072 13.7072 0.5 30 0.5C46.2928 0.5 59.5 13.7072 59.5 30C59.5 46.292 46.294 59.4987 30.0023 59.5C25.0095 59.5075 20.1005 58.2424 15.7372 55.8283L3.67461 58.0746C3.18849 58.1651 2.68899 58.0103 2.33934 57.6606C1.98969 57.311 1.83482 56.8115 1.92535 56.3254L4.17163 44.263C1.83138 40.0361 0.5 35.169 0.5 30ZM30 3.5C15.364 3.5 3.5 15.3641 3.5 30C3.5 34.8283 4.79063 39.3551 7.04456 43.2485C7.22402 43.5585 7.28662 43.9224 7.22105 44.2746L5.27494 54.725L15.7254 52.7789C16.0774 52.7134 16.4412 52.7759 16.7511 52.9552C20.7769 55.2841 25.3469 56.507 29.9977 56.5L30 56.5C44.6359 56.5 56.5 44.6359 56.5 30C56.5 15.3641 44.6359 3.5 30 3.5Z</Geometry>
								<Geometry>M30 13.5C31.3807 13.5 32.5 14.6193 32.5 16L32.5 17C32.5 18.3807 31.3807 19.5 30 19.5C28.6193 19.5 27.5 18.3807 27.5 17L27.5 16C27.5 14.6193 28.6193 13.5 30 13.5Z</Geometry>
								<Geometry>M30 23.5C31.3807 23.5 32.5 24.6193 32.5 26L32.5 43C32.5 44.3807 31.3807 45.5 30 45.5C28.6193 45.5 27.5 44.3807 27.5 43L27.5 26C27.5 24.6193 28.6193 23.5 30 23.5Z</Geometry>
							</GeometryGroup>
						</Path.Data>
					</Path>
					<TextBlock
						Grid.Column="4"
						Foreground="#FF707270"
						FontFamily="{StaticResource PromptRegular}"
						VerticalAlignment="Center"
						HorizontalAlignment="Left"
						FontSize="{DynamicResource FontSizeTextSmall}">Event Name will be shown in the main display area. <Span
							Foreground="{DynamicResource UIErrorColor}">(required)</Span></TextBlock>
				</Grid>
			</Grid>
			<Grid
				Name="eventMottoGrid"
				Row="4"
				Column="1"
				VerticalAlignment="Top">
				<Grid.RowDefinitions>
					<RowDefinition
						Height="54*" />
					<RowDefinition
						Height="12*" />
					<RowDefinition
						Height="80*" />
				</Grid.RowDefinitions>
				<TextBlock
					Name="txtEventMotto"
					Grid.Row="0"
					Grid.Column="0"
					Foreground="{DynamicResource UIGrayDark}"
					FontFamily="{StaticResource PromptMedium}"
					VerticalAlignment="Center"
					FontSize="{DynamicResource FontSizeHeading3}"
					Text="Event Motto" />
				<Grid
					Name="newEventMottoGrid"
					Row="2"
					Column="0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="1165*" />
						<ColumnDefinition
							Width="48*" />
						<ColumnDefinition
							Width="56*" />
						<ColumnDefinition
							Width="24*" />
						<ColumnDefinition
							Width="1193*" />
					</Grid.ColumnDefinitions>
					<Grid
						Name="gridInputFieldMotto"
						Column="0"
						Height="{DynamicResource UIInputHeight}">
						<Border
							Style="{StaticResource BorderInputStyle}" />
						<TextBox
							Name="EventMottoText"
							x:Uid="4"
							HorizontalAlignment="Left"
							VerticalAlignment="Center"
							Foreground="#FF707270"
							TextAlignment="Left"
							FontFamily="{StaticResource MontserratMedium}"
							BorderThickness="0"
							FontSize="{DynamicResource FontSizeTextSmall}"
							VerticalContentAlignment="Center"
							Text=""
							Padding="10,0,0,0"
							Background="#00FFFFFF"
							Height="{Binding ElementName=gridInputFieldMotto, Path=ActualHeight}"
							Width="{Binding ElementName=gridInputFieldMotto, Path=ActualWidth}"
							TextChanged="EventMottoText_TextChanged"
							LostFocus="EventMottoText_LostFocus" />
						<Button
							Name="EventMottoPlaceholder"
							x:Uid="1"
							HorizontalAlignment="Left"
							VerticalAlignment="Center"
							Foreground="#FFCAC8C8"
							FontFamily="{StaticResource MontserratMedium}"
							BorderThickness="0"
							FontSize="{DynamicResource FontSizeTextSmall}"
							Content="New Event Motto"
							RenderTransformOrigin="0,0.5"
							Background="#00FFFFFF"
							Width="{Binding ElementName=gridInputField, Path=ActualWidth}"
							Height="{Binding ElementName=gridInputField, Path=ActualHeight}"
							Click="Placeholder_Click">
							<FrameworkElement.Style>
								<Style
									TargetType="{x:Type Button}">
									<Setter
										Property="Background"
										Value="#00FFFFFF" />
									<Setter
										Property="Template">
										<Setter.Value>
											<ControlTemplate
												TargetType="{x:Type Button}">
												<Border
													Background="{TemplateBinding Background}">
													<ContentPresenter
														HorizontalAlignment="Left"
														Margin="10,0,0,0"
														VerticalAlignment="Center" />
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<Style.Triggers>
										<Trigger
											Property="UIElement.IsMouseOver"
											Value="True">
											<Setter
												Property="Background"
												Value="#FFA0A0A0" />
										</Trigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
						</Button>
					</Grid>
					<Path
						Name="infoIcon2"
						Grid.Column="2"
						Stretch="Uniform"
						Fill="#82868C">
						<Path.Data>
							<GeometryGroup>
								<Geometry>M0.5 30C0.5 13.7072 13.7072 0.5 30 0.5C46.2928 0.5 59.5 13.7072 59.5 30C59.5 46.292 46.294 59.4987 30.0023 59.5C25.0095 59.5075 20.1005 58.2424 15.7372 55.8283L3.67461 58.0746C3.18849 58.1651 2.68899 58.0103 2.33934 57.6606C1.98969 57.311 1.83482 56.8115 1.92535 56.3254L4.17163 44.263C1.83138 40.0361 0.5 35.169 0.5 30ZM30 3.5C15.364 3.5 3.5 15.3641 3.5 30C3.5 34.8283 4.79063 39.3551 7.04456 43.2485C7.22402 43.5585 7.28662 43.9224 7.22105 44.2746L5.27494 54.725L15.7254 52.7789C16.0774 52.7134 16.4412 52.7759 16.7511 52.9552C20.7769 55.2841 25.3469 56.507 29.9977 56.5L30 56.5C44.6359 56.5 56.5 44.6359 56.5 30C56.5 15.3641 44.6359 3.5 30 3.5Z</Geometry>
								<Geometry>M30 13.5C31.3807 13.5 32.5 14.6193 32.5 16L32.5 17C32.5 18.3807 31.3807 19.5 30 19.5C28.6193 19.5 27.5 18.3807 27.5 17L27.5 16C27.5 14.6193 28.6193 13.5 30 13.5Z</Geometry>
								<Geometry>M30 23.5C31.3807 23.5 32.5 24.6193 32.5 26L32.5 43C32.5 44.3807 31.3807 45.5 30 45.5C28.6193 45.5 27.5 44.3807 27.5 43L27.5 26C27.5 24.6193 28.6193 23.5 30 23.5Z</Geometry>
							</GeometryGroup>
						</Path.Data>
					</Path>
					<Label
						Grid.Column="4"
						Foreground="#FF707270"
						FontFamily="{StaticResource PromptRegular}"
						VerticalAlignment="Center"
						FontSize="{DynamicResource FontSizeTextSmall}">Event Motto will be shown under the Event Name.</Label>
				</Grid>
			</Grid>
			<Grid
				Row="6"
				Column="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="16*" />
					<ColumnDefinition
						Width="18*" />
				</Grid.ColumnDefinitions>
				<Grid
					Column="0"
					MaxHeight="{DynamicResource UIInputHeight}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="10*" />
						<ColumnDefinition
							Width="1*" />
						<ColumnDefinition
							Width="10*" />
						<ColumnDefinition
							Width="10*" />
					</Grid.ColumnDefinitions>
					<Button
						Name="btnCreate"
						Grid.Column="0"
						BorderThickness="0"
						Content="Create Event"
						Foreground="#FFFFFFFF"
						FontFamily="{StaticResource MontserratSemiBold}"
						FontSize="{DynamicResource FontSizeButtonPrimary}">
						<FrameworkElement.Style>
							<Style
								TargetType="{x:Type Button}">
								<Setter
									Property="Template">
									<Setter.Value>
										<ControlTemplate
											TargetType="{x:Type Button}">
											<Border
												Name="borderCreateButton"
												BorderThickness="{TemplateBinding BorderThickness}"
												BorderBrush="{TemplateBinding BorderBrush}"
												Background="{TemplateBinding Background}"
												CornerRadius="{Binding ElementName=borderCreateButton, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.5+1}">
												<ContentPresenter
													HorizontalAlignment="Center"
													VerticalAlignment="Center" />
											</Border>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
								<Style.Triggers>
									<Trigger
										Property="UIElement.IsMouseOver"
										Value="True">
										<Setter
											Property="UIElement.Opacity"
											Value="0.7" />
									</Trigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
					</Button>
					<Button
						Name="btnEdit"
						Grid.Column="0"
						BorderThickness="0"
						Content="Save Event"
						Foreground="#FFFFFFFF"
						FontFamily="{StaticResource MontserratSemiBold}"
						FontSize="{DynamicResource FontSizeTextTitle}"
						Click="EditClicked">
						<FrameworkElement.Style>
							<Style
								TargetType="{x:Type Button}">
								<Setter
									Property="Template">
									<Setter.Value>
										<ControlTemplate
											TargetType="{x:Type Button}">
											<Border
												Name="borderCreateButton"
												Background="{TemplateBinding Background}"
												CornerRadius="{Binding ElementName=borderCreateButton, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.5+1}">
												<ContentPresenter
													HorizontalAlignment="Center"
													VerticalAlignment="Center" />
											</Border>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
								<Style.Triggers>
									<Trigger
										Property="UIElement.IsMouseOver"
										Value="True">
										<Setter
											Property="UIElement.Opacity"
											Value="0.7" />
									</Trigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
					</Button>
					<Button
						Name="btnCancel"
						Grid.Column="2"
						BorderThickness="0"
						Content="Cancel"
						Foreground="#FFFFFFFF"
						FontFamily="{StaticResource MontserratSemiBold}"
						FontSize="{DynamicResource FontSizeTextTitle}"
						Click="CancelClicked">
						<FrameworkElement.Style>
							<Style
								TargetType="{x:Type Button}">
								<Setter
									Property="Background"
									Value="#FFFFFFFF" />
								<Setter
									Property="Template">
									<Setter.Value>
										<ControlTemplate
											TargetType="{x:Type Button}">
											<Border
												Name="borderCreateButton"
												Background="#F64C4C"
												CornerRadius="{Binding ElementName=borderCreateButton, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.5+1}">
												<ContentPresenter
													HorizontalAlignment="Center"
													VerticalAlignment="Center" />
											</Border>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
								<Style.Triggers>
									<Trigger
										Property="UIElement.IsMouseOver"
										Value="True">
										<Setter
											Property="UIElement.Opacity"
											Value="0.7" />
									</Trigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
					</Button>
				</Grid>
			</Grid>
		</Grid>
	</Grid>
</Page>
