<Window
	x:Class="KingAIPhotoBoothPro.Pages.ActivationKing.FontWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages.ActivationKing"
	WindowStyle="None"
	AllowsTransparency="True"
	Background="#FFFFFFFF"
	Topmost="True"
	Title="FontWindow"
	Height="500"
	Width="800"
	Loaded="Window_Loaded">
	<Grid
		Name="FontSettingsGrid"
		Background="#FFFFFFFF">
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="1*" />
			<ColumnDefinition
				Width="10*" />
			<ColumnDefinition
				Width="8*" />
			<ColumnDefinition
				Width="1*" />
		</Grid.ColumnDefinitions>
		<Grid
			ColumnSpan="2"
			Background="#FFFFFFFF"
			MouseDown="FontSettingsGrid_MouseDown">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="1*" />
				<RowDefinition
					Height="2*" />
				<RowDefinition
					Height="2*" />
				<RowDefinition
					Height="2*" />
				<RowDefinition
					Height="2*" />
				<RowDefinition
					Height="1*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="1*" />
				<ColumnDefinition
					Width="10*" />
			</Grid.ColumnDefinitions>
			<Frame
				Name="FontComboboxFrame"
				Grid.Row="1"
				Grid.Column="1" />
			<Frame
				Name="FontSizeFrame"
				Grid.Row="4"
				Grid.Column="1" />
			<Frame
				Name="FontExampleTextFrame"
				Grid.ColumnSpan="2"
				Grid.Column="1"
				Grid.Row="2" />
			<Frame
				Name="FontPlaceholderTextFrame"
				Grid.Row="3"
				Grid.Column="1" />
		</Grid>
		<Grid
			Column="2"
			ColumnSpan="2">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="1*" />
				<RowDefinition
					Height="2*" />
				<RowDefinition
					Height="2*" />
				<RowDefinition
					Height="3*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="8*" />
				<ColumnDefinition
					Width="1*" />
			</Grid.ColumnDefinitions>
			<Frame
				Name="FontColorFrame"
				Grid.Row="1"
				Margin="-5"
				Grid.RowSpan="4" />
			<Button
				Name="DeleteButton"
				Grid.Column="5"
				Background="#00FFFFFF"
				Click="DeleteButton_Click">
				<FrameworkElement.Style>
					<Style
						TargetType="{x:Type Button}">
						<Setter
							Property="Template">
							<Setter.Value>
								<ControlTemplate
									TargetType="{x:Type Button}">
									<Border
										Background="{TemplateBinding Background}">
										<ContentPresenter
											HorizontalAlignment="Center"
											VerticalAlignment="Center" />
									</Border>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
						<Style.Triggers>
							<Trigger
								Property="UIElement.IsMouseOver"
								Value="True">
								<Setter
									Property="UIElement.Opacity"
									Value="0.9" />
							</Trigger>
						</Style.Triggers>
					</Style>
				</FrameworkElement.Style>
				<Grid
					Name="DeleteButtonInsideGrid"
					Margin="{Binding ElementName=DeleteButton, Path=ActualWidth, Converter={StaticResource SpecificMarginConverter}, ConverterParameter=right,0.}">
					<Grid>
						<Path
							Name="Circle"
							Data="{StaticResource CircleIcon}"
							Stretch="Uniform"
							Fill="#FFFF0000">
							<UIElement.Effect>
								<DropShadowEffect
									Color="Black"
									Opacity="0.2"
									BlurRadius="20"
									ShadowDepth="5"
									Direction="200" />
							</UIElement.Effect>
						</Path>
					</Grid>
					<Grid>
						<Path
							Data="{StaticResource XIcon}"
							Stretch="Uniform"
							Fill="#FFFFFFFF"
							Margin="{Binding ElementName=DeleteButtonInsideGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.25}" />
					</Grid>
				</Grid>
			</Button>
		</Grid>
	</Grid>
</Window>
