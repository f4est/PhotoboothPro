<local:SettingsSubPage
	x:Class="KingAIPhotoBoothPro.Pages.ActivationKing.FaceSwap" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages.ActivationKing" xmlns:class="clr-namespace:KingAIPhotoBoothPro.Class" xmlns:localUI="clr-namespace:KingAIPhotoBoothPro.Class.UI" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:math="http://hexinnovation.com/math" xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
	Loaded="Page_Loaded"
	Unloaded="Page_Unloaded"
	Title="FaceSwap">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<math:MathConverter
				x:Key="math" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="gridMain">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="0" />
			<RowDefinition
				Height="1*" />
			<RowDefinition
				Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.02+1}" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="150*" />
			<ColumnDefinition
				Width="2662*" />
			<ColumnDefinition
				Width="128*" />
		</Grid.ColumnDefinitions>
		<Grid
			Row="1"
			Column="1">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.06}" />
				<RowDefinition
					Height="1*" />
				<RowDefinition
					Height="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.02+1}" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="1*" />
				<ColumnDefinition
					Width="26*" />
				<ColumnDefinition
					Width="1*" />
			</Grid.ColumnDefinitions>
			<class:SectionTemplate
				Template="{StaticResource SectionTemplateKey}"
				Content=""
				Background="#FFFFFFFF"
				BorderBrush="#BABFC5"
				Grid.RowSpan="10"
				Grid.ColumnSpan="10" />
			<Grid
				Name="InfoTextGrid"
				RowSpan="1"
				ColumnSpan="2">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="1*" />
					<ColumnDefinition
						Width="95*" />
				</Grid.ColumnDefinitions>
				<TextBlock
					Grid.Column="1"
					Grid.Row="1"
					TextAlignment="Left"
					VerticalAlignment="Center"
					FontFamily="{StaticResource MontserratMedium}"
					FontSize="{DynamicResource FontSizeTextSmall}"
					Foreground="#82868C">You can <Span
						FontWeight="Bold">enable</Span> or <Span
						FontWeight="Bold">disable</Span> Face Swap for<LineBreak />dedected faces by clicking on frames.</TextBlock>
			</Grid>
			<Grid
				Column="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="9*" />
					<ColumnDefinition
						Width="0*" />
					<ColumnDefinition
						Width="13*" />
					<ColumnDefinition
						Width="0*" />
					<ColumnDefinition
						Width="0*" />
					<ColumnDefinition
						Width="8*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="1*" />
					<RowDefinition
						Height="2*" />
					<RowDefinition
						Height="1*" />
				</Grid.RowDefinitions>
				<Grid
					Name="InfoGrid"
					Column="2"
					RowSpan="3"
					Margin="5">
					<StackPanel
						Orientation="Horizontal"
						VerticalAlignment="Center">
						<Image
							Source="/Images/TemplatePAge/frame_enabled.png"
							Stretch="Uniform"
							Margin="0,0,5,0"
							Height="{Binding ElementName=InfoGrid, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.9}" />
						<TextBlock
							Grid.Column="1"
							TextAlignment="Left"
							VerticalAlignment="Center"
							Margin="0,0,5,0"
							FontFamily="{StaticResource MontserratMedium}"
							FontSize="{DynamicResource FontSizeTextSmall}"
							Foreground="#82868C">Face Swap<LineBreak /><Span
								FontWeight="Bold">Enabled</Span></TextBlock>
						<Image
							Source="/Images/TemplatePAge/disabled_frame.png"
							Grid.Column="2"
							Stretch="Uniform"
							Margin="0,0,5,0"
							Height="{Binding ElementName=InfoGrid, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.9}" />
						<TextBlock
							Grid.Column="3"
							TextAlignment="Left"
							VerticalAlignment="Center"
							Margin="0,0,5,0"
							FontFamily="{StaticResource MontserratBold}"
							FontSize="{DynamicResource FontSizeTextSmall}"
							Foreground="#82868C">Face Swap<LineBreak /><Span
								FontWeight="Bold">Disabled</Span></TextBlock>
					</StackPanel>
				</Grid>
				<Button
					Name="BuyNewAssetButton"
					Grid.Row="1"
					Grid.Column="5"
					BorderThickness="0"
					Content="Buy Face Swap Asset"
					Foreground="#FFFFFFFF"
					FontFamily="{StaticResource MontserratSemiBold}"
					FontSize="{DynamicResource FontSizeButtonPrimary}"
					Background="#FE632F"
					Click="BuyNewAssetButton_Click">
					<FrameworkElement.Style>
						<Style
							TargetType="{x:Type Button}">
							<Setter
								Property="Template">
								<Setter.Value>
									<ControlTemplate
										TargetType="{x:Type Button}">
										<Border
											Name="borderCreateButton"
											Background="{DynamicResource UIPurpleColor}"
											CornerRadius="{Binding ElementName=borderCreateButton, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.5+1}">
											<ContentPresenter
												HorizontalAlignment="Center"
												VerticalAlignment="Center" />
										</Border>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
							<Style.Triggers>
								<Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
									<Setter
										Property="UIElement.Opacity"
										Value="0.7" />
								</Trigger>
							</Style.Triggers>
						</Style>
					</FrameworkElement.Style>
				</Button>
			</Grid>
			<class:ButtonIcon
				Name="AddImageButton"
				Click="AddEmptyPrefab"
				Loaded="AddImageButton_Loaded"
				Unloaded="AddImageButton_Unloaded"
				Grid.Column="1"
				Visibility="Hidden"
				Style="{DynamicResource ButtonIconKey}"
				Icon="{StaticResource ChoosePromptIcon}"
				IconMargin="5"
				BlackCoverVisibility="Hidden"
				LoadingAnimationVisibility="Hidden"
				Background="#FF5F9EA0"
				Content="Add"
				VerticalAlignment="Center"
				HorizontalAlignment="Right"
				Width="{Binding ActualWidth, ConverterParameter=x*0.2, Converter={StaticResource math}, ElementName=gridMain}"
				MaxWidth="{Binding ActualWidth, ConverterParameter=x*0.6, Converter={StaticResource math}, ElementName=gridMain}"
				Height="{Binding ActualWidth, ConverterParameter=x*0.05, Converter={StaticResource math}, ElementName=gridMain}" />
			<ScrollViewer
				Name="scroll"
				Grid.Row="1"
				Grid.Column="1"
				VerticalScrollBarVisibility="Auto">
				<i:Interaction.Behaviors>
					<localUI:ScrollViewerDragBehavior />
				</i:Interaction.Behaviors>
				<WrapPanel
					Name="FaceSwapImagesStackPanel"
					Orientation="Horizontal"
					ItemWidth="{Binding ElementName=scroll, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.31}" />
			</ScrollViewer>
			<Grid
				Name="loadingGifGrid"
				Column="1"
				Row="1"
				Visibility="Visible">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="1*" />
					<ColumnDefinition
						Width="1*" />
					<ColumnDefinition
						Width="1*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="1*" />
					<RowDefinition
						Height="1*" />
					<RowDefinition
						Height="1*" />
				</Grid.RowDefinitions>
				<Grid
					RowSpan="3"
					ColumnSpan="3">
					<UIElement.Effect>
						<DropShadowEffect
							Color="Black"
							Opacity="0.82"
							BlurRadius="40"
							ShadowDepth="12"
							Direction="250" />
					</UIElement.Effect>
					<TextBlock
						Name="loadingText"
						Grid.Row="1"
						FontFamily="{StaticResource MontserratBold}"
						Text=""
						Foreground="#FFFFFFFF"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						FontSize="{Binding ActualWidth, ConverterParameter=x*0.05, Converter={StaticResource math}, ElementName=loadingGifGrid}">Loading</TextBlock>
				</Grid>
			</Grid>
		</Grid>
	</Grid>
</local:SettingsSubPage>
