<Page
	x:Class="KingAIPhotoBoothPro.Pages.ActivationKing.Prefab.SliderPrefab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas .microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages.ActivationKing.Prefab"
	Title="SliderPrefab"
	Loaded="Page_Loaded">
	<Grid>
		<Slider
			Name="thisSlider"
			VerticalAlignment="Center" />
		<TextBox
			Name="thisText"
			VerticalAlignment="Center"
			TextAlignment="Center"
			FontFamily="{DynamicResource PromptExtraLight}"
			FontSize="{DynamicResource FontSizeTextTitle}"
			HorizontalAlignment="Center"
			MinWidth="{Binding ElementName=thisText, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*2}"
			Text="{Binding ElementName=thisSlider, Path=Value, Mode=TwoWay, StringFormat={}{0:F2}}"
			TextChanged="txtInput_TextChanged" />
	</Grid>
</Page>
