<Page
	x:Class="KingAIPhotoBoothPro.Pages.ActivationKing.Prefab.PhotoPrefab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages.ActivationKing.Prefab" xmlns:converter="clr-namespace:KingAIPhotoBoothPro.Class" xmlns:math="http://hexinnovation.com/math"
	Title="PhotoPrefab"
	Loaded="Page_Loaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<math:MathConverter
				x:Key="math" />
			<converter:SpecificMarginConverter
				x:Key="SpecificMarginConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="photoGrid"
		Visibility="Visible">
		<Image
			Name="photoImage"
			Grid.ColumnSpan="10"
			Source="pack://application:,,,/Images/PhotoBGProfile.png"
			Grid.RowSpan="10"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Stretch="UniformToFill"
			ImageFailed="Image_ImageFailed" />
		<TextBlock
			Name="photoText"
			Text="1"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			FontSize="{DynamicResource FontSizeHeading3}"
			Foreground="#707270"
			Margin="0,0,0,10" />
		<Grid
			Name="butonsGrid"
			Row="3"
			Column="2">
			<Button
				Name="decreaseButton"
				Padding="0"
				Background="#00FFFFFF"
				MinWidth="30"
				MinHeight="30"
				VerticalAlignment="Center"
				Margin="{Binding ElementName=photoGrid, Path=ActualWidth, Converter={StaticResource SpecificMarginConverter}, ConverterParameter=right,0.1,50}"
				Width="{Binding ElementName=photoGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.05+1}"
				Height="{Binding ElementName=photoGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.05+1}"
				Click="DecreaseButton_Click">
				<FrameworkElement.Style>
					<Style
						TargetType="{x:Type Button}">
						<Setter
							Property="Template">
							<Setter.Value>
								<ControlTemplate
									TargetType="{x:Type Button}">
									<Border
										Background="#FFFFFFFF"
										CornerRadius="5000"
										BorderThickness="2"
										BorderBrush="#00ABB6">
										<Path
											Data="{StaticResource MinusIcon}"
											Stroke="#00ABB6"
											Stretch="Uniform"
											StrokeThickness="4"
											VerticalAlignment="Center"
											HorizontalAlignment="Center"
											Width="{Binding ElementName=PrintNumberAdd, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.3+1}" />
									</Border>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
						<Style.Triggers>
							<Trigger
								Property="UIElement.IsMouseOver"
								Value="True">
								<Setter
									Property="UIElement.Opacity"
									Value="0.9" />
							</Trigger>
						</Style.Triggers>
					</Style>
				</FrameworkElement.Style>
			</Button>
			<Button
				Name="increaseButton"
				Padding="0"
				Background="#00FFFFFF"
				MinHeight="30"
				MinWidth="30"
				VerticalAlignment="Center"
				Margin="{Binding ElementName=photoGrid, Path=ActualWidth, Converter={StaticResource SpecificMarginConverter}, ConverterParameter=left,0.1,50}"
				Width="{Binding ElementName=photoGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.05+1}"
				Height="{Binding ElementName=photoGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.05+1}"
				Click="IncreaseButton_Click">
				<FrameworkElement.Style>
					<Style
						TargetType="{x:Type Button}">
						<Setter
							Property="Template">
							<Setter.Value>
								<ControlTemplate
									TargetType="{x:Type Button}">
									<Border
										Background="#FFFFFFFF"
										CornerRadius="5000"
										BorderThickness="2"
										BorderBrush="#00ABB6">
										<Path
											Data="{StaticResource PlusIcon}"
											Stroke="#00ABB6"
											Stretch="Uniform"
											StrokeThickness="4"
											VerticalAlignment="Center"
											HorizontalAlignment="Center"
											Width="{Binding ElementName=PrintNumberAdd, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.3+1}" />
									</Border>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
						<Style.Triggers>
							<Trigger
								Property="UIElement.IsMouseOver"
								Value="True">
								<Setter
									Property="UIElement.Opacity"
									Value="0.9" />
							</Trigger>
						</Style.Triggers>
					</Style>
				</FrameworkElement.Style>
			</Button>
		</Grid>
		<Rectangle
			Name="border"
			Stroke="#3B82F6"
			StrokeDashArray="5,2"
			StrokeThickness="5"
			Grid.ColumnSpan="5"
			Grid.RowSpan="5"
			Visibility="Hidden" />
		<Button
			Name="buttonTopLeft"
			Grid.Column="0"
			Grid.Row="0"
			MinWidth="15"
			MinHeight="15"
			Background="#3B82F6"
			Opacity="0.7"
			HorizontalAlignment="Left"
			Visibility="Hidden"
			VerticalAlignment="Top"
			Width="{Binding ElementName=photoGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.05+1}"
			Height="{Binding ElementName=photoGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.05+1}"
			Margin="{Binding ElementName=buttonTopLeft, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=-x*1}" />
		<Button
			Name="buttonTopRight"
			Grid.Column="4"
			Grid.Row="0"
			MinWidth="15"
			MinHeight="15"
			Background="#3B82F6"
			Opacity="0.7"
			HorizontalAlignment="Right"
			Visibility="Hidden"
			VerticalAlignment="Top"
			Width="{Binding ElementName=photoGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.05+1}"
			Height="{Binding ElementName=photoGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.05+1}"
			Margin="{Binding ElementName=buttonTopRight, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=-x*1}" />
		<Button
			Name="buttonBottomRight"
			Grid.Column="4"
			Grid.Row="4"
			MinWidth="15"
			MinHeight="15"
			Background="#3B82F6"
			Opacity="0.7"
			HorizontalAlignment="Right"
			Visibility="Hidden"
			VerticalAlignment="Bottom"
			Width="{Binding ElementName=photoGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.05+1}"
			Height="{Binding ElementName=photoGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.05+1}"
			Margin="{Binding ElementName=buttonBottomRight, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=-x*1}" />
		<Button
			Name="buttonBottomLeft"
			Grid.Column="0"
			Grid.Row="4"
			MinWidth="15"
			MinHeight="15"
			Background="#3B82F6"
			Opacity="0.7"
			HorizontalAlignment="Left"
			Visibility="Hidden"
			VerticalAlignment="Bottom"
			Width="{Binding ElementName=photoGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.05+1}"
			Height="{Binding ElementName=photoGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.05+1}"
			Margin="{Binding ElementName=buttonBottomLeft, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=-x*1}" />
	</Grid>
</Page>
