<Page
	x:Class="KingAIPhotoBoothPro.Pages.ActivationKing.Prefab.ColorPickerPrefab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages.ActivationKing.Prefab" xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker" xmlns:math="http://hexinnovation.com/math"
	Title="ColorPickerPrefab"
	ShowsNavigationUI="False"
	Loaded="Page_Loaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<math:MathConverter
				x:Key="math" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="gridColorPicker">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="{Binding ElementName=gridColorPicker, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.12+1}" />
			<RowDefinition
				Height="1*" />
		</Grid.RowDefinitions>
		<TextBlock
			Name="txtName"
			Visibility="Visible"
			HorizontalAlignment="Center"
			Style="{DynamicResource TextStylePropertyTitle}">Select Color</TextBlock>
		<Grid
			Row="1">
			<FrameworkElement.LayoutTransform>
				<ScaleTransform
					x:Name="scaleTransform"
					ScaleX="{Binding ElementName=gridColorPicker, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.002}"
					ScaleY="{Binding ElementName=gridColorPicker, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.002}" />
			</FrameworkElement.LayoutTransform>
			<colorpicker:StandardColorPicker
				Name="colorPickElement"
				Grid.Column="1"
				MinHeight="0"
				MinWidth="0"
				MouseDown="colorPickElement_MouseDown"
				ColorChanged="colorPickElement_ColorChanged"
				LostKeyboardFocus="colorPickElement_LostKeyboardFocus"
				MouseUp="colorPickElement_MouseUp" />
		</Grid>
	</Grid>
</Page>
