<Page
	x:Class="KingAIPhotoBoothPro.Pages.ActivationKing.Prefab.FaceSwapImagePickerPrefab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages.ActivationKing.Prefab" xmlns:math="http://hexinnovation.com/math" xmlns:mrgn="clr-namespace:KingAIPhotoBoothPro.Class" xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
	Title="FaceSwapImagePickerPrefab"
	Loaded="Page_Loaded"
	Unloaded="Page_Unloaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<math:MathConverter
				x:Key="math" />
			<mrgn:MarginLeftConverter
				x:Key="marginLeftConverter" />
			<mrgn:SpecificMarginConverter
				x:Key="specificMarginConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="GridMain"
		ClipToBounds="False"
		Height="{Binding ElementName=GridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*1.5}">
		<Grid
			Name="InsideGrid"
			Column="0"
			Row="1"
			ClipToBounds="False"
			Margin="5">
			<UIElement.Effect>
				<DropShadowEffect
					Color="Black"
					Opacity="0.12"
					BlurRadius="40"
					ShadowDepth="12"
					Direction="340" />
			</UIElement.Effect>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="22*" />
				<RowDefinition
					Height="471*" />
				<RowDefinition
					Height="50*" />
				<RowDefinition
					Height="100*" />
				<RowDefinition
					Height="0*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="22*" />
				<ColumnDefinition
					Width="709*" />
				<ColumnDefinition
					Width="22*" />
			</Grid.ColumnDefinitions>
			<Grid
				RowSpan="10"
				ColumnSpan="10"
				ClipToBounds="False">
				<Border
					Background="#FAFBFB"
					CornerRadius="{DynamicResource UICornerRadius}"
					BorderThickness="1"
					BorderBrush="{DynamicResource AppUIColorLight}" />
			</Grid>
			<Grid
				Name="imageGrid"
				Row="1"
				Column="1"
				ClipToBounds="False">
				<Border
					Name="BackgroundImageBorder"
					Background="#D9D9D9">
					<TextBlock
						Name="BackgroundImageText"
						Text="Add Your New Background Image"
						TextWrapping="Wrap"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						TextAlignment="Center"
						Margin="10"
						FontFamily="{StaticResource MontserratBold}"
						FontSize="{DynamicResource FontSizeTextSmall}"
						Foreground="#82868C" />
				</Border>
				<Image
					Name="prefabImage"
					Stretch="UniformToFill" />
				<Canvas
					Name="imageCanvas"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch" />
				<Button
					Name="AddButton"
					Background="#00FFFFFF"
					BorderBrush="#00FFFFFF"
					Margin="10"
					HorizontalAlignment="Right"
					VerticalAlignment="Bottom"
					Width="{Binding ElementName=imageGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*240/609+1}"
					Height="{Binding ElementName=AddButton, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*92/240+1}"
					Click="Button_Click">
					<FrameworkElement.Style>
						<Style
							TargetType="{x:Type Button}">
							<Setter
								Property="Template">
								<Setter.Value>
									<ControlTemplate
										TargetType="{x:Type Button}">
										<Border
											Name="AddButtonBorder"
											CornerRadius="{DynamicResource UICornerRadius}"
											Background="{DynamicResource UIBlueButton}">
											<ContentPresenter
												HorizontalAlignment="Center"
												VerticalAlignment="Center" />
										</Border>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
							<Style.Triggers>
								<Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
									<Setter
										Property="UIElement.Opacity"
										Value="0.9" />
								</Trigger>
							</Style.Triggers>
						</Style>
					</FrameworkElement.Style>
					<StackPanel
						Orientation="Horizontal"
						HorizontalAlignment="Center"
						VerticalAlignment="Center">
						<TextBlock
							Text="Change"
							Foreground="#FFFFFFFF"
							FontSize="{DynamicResource FontSizeTextSmall}"
							FontFamily="{StaticResource MontserratBold}"
							VerticalAlignment="Center" />
					</StackPanel>
				</Button>
			</Grid>
			<Grid
				Name="TitleHeaderGrid"
				Row="2"
				Column="1">
				<TextBlock
					Text="Title"
					FontFamily="{StaticResource PromptBold}"
					VerticalAlignment="Bottom"
					FontSize="{DynamicResource FontSizeTextRegular}"
					Foreground="#707270" />
			</Grid>
			<Grid
				Name="TitleTextBoxGrid"
				Row="3"
				Column="1">
				<Border
					BorderBrush="#BABFC5"
					BorderThickness="2"
					CornerRadius="4"
					Style="{DynamicResource BorderInputStyle}">
					<TextBox
						Name="txtFaceSwapTitle"
						Grid.Column="1"
						Margin="5,0,0,0"
						BorderBrush="#00FFFFFF"
						Background="#00FFFFFF"
						BorderThickness="0"
						Text="Write Title"
						TextAlignment="Left"
						FontFamily="{StaticResource PromptMedium}"
						Foreground="#82868C"
						FontSize="{DynamicResource FontSizeTextSmall}"
						VerticalContentAlignment="Center"
						HorizontalContentAlignment="Center"
						TextChanged="txtFaceSwapTitle_TextChanged" />
				</Border>
			</Grid>
		</Grid>
		<Button
			Name="DeleteButton"
			Visibility="Visible"
			VerticalAlignment="Top"
			HorizontalAlignment="Right"
			Grid.Column="3"
			Background="#00FFFFFF"
			BorderBrush="#00FFFFFF"
			Margin="3"
			Height="{Binding ElementName=GridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.11}"
			Width="{Binding ElementName=DeleteButton, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*1}"
			Click="DeleteButton_Click">
			<FrameworkElement.Style>
				<Style
					TargetType="{x:Type Button}">
					<Setter
						Property="Template">
						<Setter.Value>
							<ControlTemplate
								TargetType="{x:Type Button}">
								<Border
									Background="{TemplateBinding Background}">
									<ContentPresenter
										HorizontalAlignment="Center"
										VerticalAlignment="Center" />
								</Border>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
					<Style.Triggers>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								Property="UIElement.Opacity"
								Value="0.9" />
						</Trigger>
					</Style.Triggers>
				</Style>
			</FrameworkElement.Style>
			<Grid
				Name="DeleteButtonInsideGrid"
				Margin="{Binding ElementName=DeleteButton, Path=ActualWidth, Converter={StaticResource SpecificMarginConverter}, ConverterParameter=right,0.}">
				<Grid>
					<Path
						Name="Circle"
						Data="{StaticResource CircleIcon}"
						Stretch="Uniform"
						Fill="#FFFF0000">
						<UIElement.Effect>
							<DropShadowEffect
								Color="Black"
								Opacity="0.2"
								BlurRadius="20"
								ShadowDepth="5"
								Direction="200" />
						</UIElement.Effect>
					</Path>
				</Grid>
				<Grid>
					<Path
						Data="{StaticResource XIcon}"
						Stretch="Uniform"
						Fill="#FFFFFFFF"
						Margin="{Binding ElementName=DeleteButtonInsideGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.25}" />
				</Grid>
			</Grid>
		</Button>
		<Grid
			Name="NewPrefabGrid"
			ColumnSpan="10"
			RowSpan="10"
			ClipToBounds="False"
			Visibility="Visible">
			<Border
				Background="{DynamicResource UIGreenButton}"
				CornerRadius="8"
				Visibility="Visible" />
			<Button
				Name="AddNewButton"
				Background="{DynamicResource UIGreenButton}"
				BorderBrush="{DynamicResource AppUIColorLight}"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Height="450"
				Width="450"
				Click="AddNewButton_Click">
				<FrameworkElement.Style>
					<Style
						TargetType="{x:Type Button}">
						<Setter
							Property="Template">
							<Setter.Value>
								<ControlTemplate
									TargetType="{x:Type Button}">
									<Border
										Name="AddButtonBorder"
										BorderBrush="{TemplateBinding BorderBrush}"
										CornerRadius="{DynamicResource BannerCornerRadius}"
										Background="{TemplateBinding Background}">
										<ContentPresenter
											HorizontalAlignment="Center"
											VerticalAlignment="Center" />
									</Border>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
						<Style.Triggers>
							<Trigger
								Property="UIElement.IsMouseOver"
								Value="True">
								<Setter
									Property="UIElement.Opacity"
									Value="0.9" />
							</Trigger>
						</Style.Triggers>
					</Style>
				</FrameworkElement.Style>
				<StackPanel
					Orientation="Horizontal"
					HorizontalAlignment="Center"
					VerticalAlignment="Center">
					<Path
						Data="{StaticResource PlusIcon}"
						Stroke="#FFFFFFFF"
						Stretch="Uniform"
						StrokeThickness="3"
						Fill="#FFFFFFFF"
						Width="{Binding ElementName=AddNewButton, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*44/240+1}" />
				</StackPanel>
			</Button>
			<Grid
				Name="LoadingContainer"
				ColumnSpan="10"
				RowSpan="10"
				Visibility="Visible"
				Background="#CC000000">
				<lottie:LottieAnimationView
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					AutoPlay="True"
					FileName="Animations/LoadingPill.json"
					RepeatCount="-1"
					Width="{Binding ElementName=LoadingContainer, Path=ActualWidth}"
					Height="{Binding ElementName=LoadingContainer, Path=ActualHeight}" />
			</Grid>
		</Grid>
	</Grid>
</Page>
