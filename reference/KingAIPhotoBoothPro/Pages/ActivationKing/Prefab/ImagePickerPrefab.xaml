<Page
	x:Class="KingAIPhotoBoothPro.Pages.ActivationKing.Prefab.ImagePickerPrefab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages.ActivationKing.Prefab" xmlns:math="http://hexinnovation.com/math"
	Title="ImagePickerPrefab"
	Loaded="Page_Loaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<math:MathConverter
				x:Key="math" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="760*" />
			<RowDefinition
				Height="24*" />
			<RowDefinition
				Height="80*" />
			<RowDefinition
				Height="80*" />
		</Grid.RowDefinitions>
		<Grid
			Row="0">
			<Image
				Name="prefabImage" />
			<Button
				Background="#00FFFFFF"
				Opacity="0.1"
				Click="Button_Click" />
			<Grid
				Name="gridMain">
				<Grid
					Name="UploadButtonGrid"
					Width="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.8}"
					Height="{Binding ElementName=gridMain, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*92/760+1}">
					<Button
						Name="Button"
						Grid.RowSpan="5"
						Grid.ColumnSpan="5"
						Content="Upload Background Image"
						Foreground="#FFFFFFFF"
						FontFamily="{StaticResource MontserratBold}"
						Click="Button_Click">
						<UIElement.Effect>
							<DropShadowEffect
								Opacity="0.25"
								BlurRadius="20"
								ShadowDepth="10" />
						</UIElement.Effect>
						<FrameworkElement.Style>
							<Style
								TargetType="{x:Type Button}">
								<Setter
									Property="Background"
									Value="#FFFFFFFF" />
								<Setter
									Property="Template">
									<Setter.Value>
										<ControlTemplate
											TargetType="{x:Type Button}">
											<Border
												Background="#3B82F6"
												CornerRadius="{DynamicResource BannerCornerRadius}">
												<Grid>
													<Grid>
														<Grid.ColumnDefinitions>
															<ColumnDefinition
																Width="116*" />
															<ColumnDefinition
																Width="442*" />
															<ColumnDefinition
																Width="48*" />
														</Grid.ColumnDefinitions>
														<Grid
															Column="1">
															<Viewbox>
																<ContentPresenter />
															</Viewbox>
														</Grid>
													</Grid>
												</Grid>
											</Border>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
								<Style.Triggers>
									<Trigger
										Property="UIElement.IsMouseOver"
										Value="True">
										<Setter
											Property="UIElement.Opacity"
											Value="0.7" />
									</Trigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
					</Button>
					<Path
						Name="UploadIconPath"
						Data="{StaticResource UploadIcon}"
						Fill="#FFFFFF"
						Stroke="#00FFFFFF"
						Stretch="Uniform"
						StrokeThickness="0"
						VerticalAlignment="Center"
						HorizontalAlignment="Left"
						Margin="{Binding ElementName=Button, Path=ActualWidth, Converter={StaticResource SpecificMarginConverter}, ConverterParameter=left,0.08}"
						Width="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*44/1120+1}" />
				</Grid>
			</Grid>
		</Grid>
		<TextBlock
			Name="txtFileName"
			Grid.Row="2"
			Foreground="#707270"
			FontFamily="{StaticResource PromptBold}"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			FontSize="{DynamicResource FontSizeTextSmall}">File Name</TextBlock>
	</Grid>
</Page>
