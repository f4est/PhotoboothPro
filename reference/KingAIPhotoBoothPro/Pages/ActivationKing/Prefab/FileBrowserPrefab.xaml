<Page
	x:Class="KingAIPhotoBoothPro.Pages.ActivationKing.Prefab.FileBrowserPrefab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages.ActivationKing.Prefab"
	Title="FileBrowserPrefab"
	Loaded="Page_Loaded">
	<Grid>
		<StackPanel
			VerticalAlignment="Top"
			Width="auto">
			<TextBlock
				Name="txtFile"
				Style="{DynamicResource TextStylePropertyTitle}"
				Margin="0,0,0,5">Select File</TextBlock>
			<Grid
				Row="2"
				Height="{DynamicResource UIInputHeight}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="1165*" />
					<ColumnDefinition
						Width="48*" />
					<ColumnDefinition
						Width="300*" />
					<ColumnDefinition
						Width="48*" />
					<ColumnDefinition
						Width="56*" />
					<ColumnDefinition
						Width="48*" />
					<ColumnDefinition
						Width="900*" />
				</Grid.ColumnDefinitions>
				<Border
					Style="{StaticResource BorderInputStyle}" />
				<Button
					Name="GetFolderButton"
					Foreground="#FFFFFF"
					Content="Browse"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					FontFamily="{StaticResource MontserratSemiBold}"
					FontSize="{DynamicResource FontSizeTextSmall}"
					Grid.Column="2"
					Background="{DynamicResource UIBlueButton}"
					Click="GetFolderButton_Click">
					<FrameworkElement.Style>
						<Style
							TargetType="{x:Type Button}">
							<Setter
								Property="Template">
								<Setter.Value>
									<ControlTemplate
										TargetType="{x:Type Button}">
										<Border
											Background="{TemplateBinding Background}"
											HorizontalAlignment="Stretch"
											VerticalAlignment="Stretch"
											CornerRadius="4">
											<ContentPresenter
												HorizontalAlignment="Center"
												VerticalAlignment="Center" />
										</Border>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
							<Style.Triggers>
								<Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
									<Setter
										Property="UIElement.Opacity"
										Value="0.7" />
								</Trigger>
							</Style.Triggers>
						</Style>
					</FrameworkElement.Style>
				</Button>
				<Label
					Name="txtCapturedFolder"
					x:Uid="2"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					Foreground="#FF708090"
					FontFamily="{StaticResource MontserratRegular}"
					BorderThickness="0"
					FontSize="{DynamicResource FontSizeTextSmall}" />
				<Path
					Name="infoIcon"
					Grid.Column="4"
					Stretch="Uniform"
					Fill="#82868C">
					<Path.Data>
						<GeometryGroup>
							<Geometry>M0.5 30C0.5 13.7072 13.7072 0.5 30 0.5C46.2928 0.5 59.5 13.7072 59.5 30C59.5 46.292 46.294 59.4987 30.0023 59.5C25.0095 59.5075 20.1005 58.2424 15.7372 55.8283L3.67461 58.0746C3.18849 58.1651 2.68899 58.0103 2.33934 57.6606C1.98969 57.311 1.83482 56.8115 1.92535 56.3254L4.17163 44.263C1.83138 40.0361 0.5 35.169 0.5 30ZM30 3.5C15.364 3.5 3.5 15.3641 3.5 30C3.5 34.8283 4.79063 39.3551 7.04456 43.2485C7.22402 43.5585 7.28662 43.9224 7.22105 44.2746L5.27494 54.725L15.7254 52.7789C16.0774 52.7134 16.4412 52.7759 16.7511 52.9552C20.7769 55.2841 25.3469 56.507 29.9977 56.5L30 56.5C44.6359 56.5 56.5 44.6359 56.5 30C56.5 15.3641 44.6359 3.5 30 3.5Z</Geometry>
							<Geometry>M30 13.5C31.3807 13.5 32.5 14.6193 32.5 16L32.5 17C32.5 18.3807 31.3807 19.5 30 19.5C28.6193 19.5 27.5 18.3807 27.5 17L27.5 16C27.5 14.6193 28.6193 13.5 30 13.5Z</Geometry>
							<Geometry>M30 23.5C31.3807 23.5 32.5 24.6193 32.5 26L32.5 43C32.5 44.3807 31.3807 45.5 30 45.5C28.6193 45.5 27.5 44.3807 27.5 43L27.5 26C27.5 24.6193 28.6193 23.5 30 23.5Z</Geometry>
						</GeometryGroup>
					</Path.Data>
				</Path>
				<Label
					Name="txtDesc"
					Grid.Column="5"
					Foreground="#FF708090"
					FontFamily="{StaticResource MontserratRegular}"
					VerticalAlignment="Center"
					FontSize="{DynamicResource FontSizeTextSmall}">Event Name will be shown in the main display area.</Label>
			</Grid>
		</StackPanel>
	</Grid>
</Page>
