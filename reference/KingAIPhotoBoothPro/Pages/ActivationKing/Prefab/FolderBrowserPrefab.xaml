<Page
	x:Class="KingAIPhotoBoothPro.Pages.ActivationKing.Prefab.FolderBrowserPrefab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages.ActivationKing.Prefab"
	Title="FolderBrowserPrefab"
	Loaded="Page_Loaded">
	<Grid>
		<Grid
			Margin="0,0,0,0">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="1*" />
				<RowDefinition
					Height="1*" />
			</Grid.RowDefinitions>
			<Label
				Name="txtFile"
				Foreground="#707270"
				FontFamily="{StaticResource PromptExtraLight}"
				VerticalAlignment="Center"
				FontSize="{DynamicResource FontSizeHeading3}">Folder to Save Captured</Label>
			<Grid
				Row="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="400*" />
					<ColumnDefinition
						Width="120*" />
					<ColumnDefinition
						Width="73*" />
					<ColumnDefinition
						Width="641*" />
				</Grid.ColumnDefinitions>
				<Image
					Source="/Images/InputTextBG.png"
					HorizontalAlignment="Left"
					Stretch="Fill"
					Margin="0,0,0,0" />
				<Button
					Name="GetFolderButton"
					Foreground="#707270"
					BorderThickness="0"
					Margin="0,0,0,0"
					Content="Browse"
					HorizontalAlignment="Left"
					FontFamily="{StaticResource MontserratSemiBold}"
					FontSize="{DynamicResource FontSizeHeading3}"
					Width="101"
					Grid.Column="1"
					Click="GetFolderButton_Click">
					<Control.Background>
						<ImageBrush
							x:Name="BrowseButtonBrush"
							ImageSource="/Images/BrowseButton.png" />
					</Control.Background>
					<FrameworkElement.Style>
						<Style
							TargetType="{x:Type Button}">
							<Setter
								Property="Background"
								Value="#FFFFFFFF" />
							<Setter
								Property="Template">
								<Setter.Value>
									<ControlTemplate
										TargetType="{x:Type Button}">
										<Border
											Background="{TemplateBinding Background}">
											<ContentPresenter
												HorizontalAlignment="Center"
												VerticalAlignment="Center" />
										</Border>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
							<Style.Triggers>
								<Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
									<Setter
										Property="UIElement.Opacity"
										Value="0.7" />
								</Trigger>
							</Style.Triggers>
						</Style>
					</FrameworkElement.Style>
				</Button>
				<Label
					Name="txtCapturedFolder"
					x:Uid="2"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					Foreground="#FF708090"
					FontFamily="{StaticResource MontserratRegular}"
					BorderThickness="0"
					FontSize="{DynamicResource FontSizeHeading3}" />
				<Image
					Grid.Column="2"
					Source="/Images/info_icon.png"
					Margin="5,5,5,5" />
				<Label
					Name="txtDesc"
					Grid.Column="3"
					Foreground="#FF708090"
					FontFamily="{StaticResource MontserratRegular}"
					VerticalAlignment="Center"
					FontSize="{DynamicResource FontSizeTextSmall}">Event Name will be shown in the main display area.</Label>
			</Grid>
		</Grid>
	</Grid>
</Page>
