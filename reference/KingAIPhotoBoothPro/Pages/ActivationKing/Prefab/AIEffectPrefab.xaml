<Page
	x:Class="KingAIPhotoBoothPro.Pages.ActivationKing.Prefab.AIEffectPrefab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages.ActivationKing.Prefab" xmlns:math="http://hexinnovation.com/math" xmlns:mrgn="clr-namespace:KingAIPhotoBoothPro.Class" xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
	Title="AIEffectPrefab"
	Loaded="Page_Loaded"
	Unloaded="Page_Unloaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<math:MathConverter
				x:Key="math" />
			<mrgn:MarginLeftConverter
				x:Key="marginLeftConverter" />
			<mrgn:SpecificMarginConverter
				x:Key="specificMarginConverter" />
			<Style
				TargetType="{x:Type CheckBox}"
				x:Key="{x:Type CheckBox}">
				<Setter
					Property="Foreground"
					Value="#3B82F6" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type CheckBox}">
							<Grid
								Background="#00FFFFFF">
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="48*" />
									<ColumnDefinition
										Width="15*" />
									<ColumnDefinition
										Width="Auto" />
								</Grid.ColumnDefinitions>
								<Border
									Name="checkBoxBorder"
									BorderBrush="#BABFC5"
									BorderThickness="2"
									Background="#FFFFFFFF"
									CornerRadius="2"
									Width="{DynamicResource CheckBoxHeight}"
									Height="{DynamicResource CheckBoxHeight}"
									Margin="0"
									Visibility="Visible" />
								<Path
									Name="checkedImage"
									StrokeThickness="0"
									Stretch="Uniform"
									Fill="#3B82F6"
									Visibility="Hidden"
									Width="{DynamicResource CheckBoxHeight}"
									Height="{DynamicResource CheckBoxHeight}">
									<Path.Data>
										<GeometryGroup>
											<RectangleGeometry
												Rect="0,0,36,36"
												RadiusX="6"
												RadiusY="6" />
											<Geometry>M26.7783 11.7968C27.3641 12.3825 27.3641 13.3323 26.7783 13.9181L16.4926 24.2038C15.9068 24.7896 14.957 24.7896 14.3713 24.2038L9.2284 19.0609C8.64262 18.4752 8.64262 17.5254 9.2284 16.9396C9.81419 16.3538 10.7639 16.3538 11.3497 16.9396L15.4319 21.0218L24.657 11.7968C25.2428 11.211 26.1925 11.211 26.7783 11.7968Z</Geometry>
										</GeometryGroup>
									</Path.Data>
								</Path>
								<Grid
									Column="1"
									Width="{Binding ElementName=checkedImage, Path=ActualWidth, ConverterParameter=x*15/48, Converter={StaticResource math}}" />
								<Grid
									Name="contentGrid"
									Column="2"
									Margin="10,0,0,0">
									<ContentPresenter
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										SnapsToDevicePixels="True"
										RecognizesAccessKey="True"
										TextBlock.Foreground="{DynamicResource UIGrayDark}"
										TextBlock.FontSize="{DynamicResource FontSizeTextRegular}"
										TextBlock.FontFamily="{DynamicResource PromptSemiBold}" />
								</Grid>
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger
									Property="ToggleButton.IsChecked"
									Value="True">
									<Setter
										TargetName="checkedImage"
										Property="Visibility"
										Value="Visible" />
								</Trigger>
								<Trigger
									Property="ToggleButton.IsChecked"
									Value="{x:Null}">
									<Setter
										TargetName="checkedImage"
										Property="Visibility"
										Value="Hidden" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="GridMain"
		ClipToBounds="False"
		VerticalAlignment="Stretch">
		<Grid
			Name="InsideGrid"
			Column="0"
			Row="1"
			ClipToBounds="True"
			Margin="5">
			<UIElement.Effect>
				<DropShadowEffect
					Color="Black"
					Opacity="0.12"
					BlurRadius="40"
					ShadowDepth="12"
					Direction="340" />
			</UIElement.Effect>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="22*" />
				<RowDefinition
					Height="50*" />
				<RowDefinition
					Height="421*" />
				<RowDefinition
					Height="10*" />
				<RowDefinition
					Height="50*" />
				<RowDefinition
					Height="10*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="22*" />
				<ColumnDefinition
					Width="709*" />
				<ColumnDefinition
					Width="22*" />
			</Grid.ColumnDefinitions>
			<Grid
				RowSpan="10"
				ColumnSpan="10"
				ClipToBounds="False">
				<Border
					Background="#FAFBFB"
					CornerRadius="{DynamicResource UICornerRadius}"
					BorderThickness="1"
					BorderBrush="{DynamicResource AppUIColorLight}" />
			</Grid>
			<Grid
				Name="imageGrid"
				Row="2"
				Column="1"
				ClipToBounds="False">
				<Border
					Name="BackgroundImageBorder"
					Background="#D9D9D9" />
				<Image
					Name="prefabImage"
					Stretch="UniformToFill" />
				<Canvas
					Name="imageCanvas"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch" />
			</Grid>
			<Grid
				Name="TitleHeaderGrid"
				Row="1"
				Column="1">
				<TextBlock
					Name="titleText"
					Text="Title"
					FontFamily="{StaticResource PromptBold}"
					VerticalAlignment="Bottom"
					FontSize="{DynamicResource FontSizeTextRegular}"
					Foreground="#707270" />
			</Grid>
			<Grid
				HorizontalAlignment="Center"
				Row="4"
				Column="1"
				VerticalAlignment="Center">
				<CheckBox
					Name="CheckElement"
					VerticalAlignment="Center"
					HorizontalAlignment="Center"
					Content="Enabled"
					HorizontalContentAlignment="Center"
					VerticalContentAlignment="Center"
					FontFamily="{StaticResource PromptRegular}"
					Foreground="{DynamicResource UIGrayDark}"
					FontSize="{DynamicResource FontSizeTextSmall}"
					Checked="CheckElement_Checked"
					Unchecked="CheckElement_Unchecked" />
			</Grid>
		</Grid>
		<Grid
			Name="NewPrefabGrid"
			ColumnSpan="10"
			RowSpan="10"
			ClipToBounds="False"
			Visibility="Hidden">
			<Border
				Background="{DynamicResource UIGreenButton}"
				CornerRadius="8"
				Visibility="Visible" />
			<Grid
				Name="LoadingContainer"
				ColumnSpan="10"
				RowSpan="10"
				Visibility="Visible"
				Background="#AA000000">
				<lottie:LottieAnimationView
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					AutoPlay="True"
					FileName="Animations/LoadingPill.json"
					RepeatCount="-1"
					Width="{Binding ElementName=LoadingContainer, Path=ActualWidth}"
					Height="{Binding ElementName=LoadingContainer, Path=ActualHeight}" />
			</Grid>
		</Grid>
	</Grid>
</Page>
