<Page
	x:Class="KingAIPhotoBoothPro.Pages.Gallery" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local2="clr-namespace:KingAIPhotoBoothPro.Class.UI" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages" xmlns:math="http://hexinnovation.com/math"
	Name="Galleri"
	Title="Gallery"
	Loaded="Page_Loaded"
	Unloaded="Page_Unloaded"
	SizeChanged="Galleri_SizeChanged">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<math:MathConverter
				x:Key="math" />
			<SolidColorBrush
				Color="#ff7474"
				x:Key="DeleteButtonHoverColor" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="mainGrid"
		Background="#00FFFFFF">
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="12*" />
			<ColumnDefinition
				Width="365*" />
			<ColumnDefinition
				Width="7*" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="7*" />
			<RowDefinition
				Height="50*" />
		</Grid.RowDefinitions>
		<Grid
			Column="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="1*" />
				<ColumnDefinition
					Width="11*" />
				<ColumnDefinition
					Width="1*" />
				<ColumnDefinition
					Width="1*" />
				<ColumnDefinition
					Width="1*" />
				<ColumnDefinition
					Width="2*" />
			</Grid.ColumnDefinitions>
			<Button
				Name="BackButton"
				BorderThickness="0"
				Margin="-5,30,0,0"
				Click="BackButton_Click">
				<Control.Background>
					<ImageBrush
						x:Name="PhotoButtonBrush"
						ImageSource="/Images/Back Icon.png"
						Stretch="Uniform">
						<Brush.Transform>
							<TransformGroup>
								<ScaleTransform />
								<SkewTransform />
								<RotateTransform />
								<TranslateTransform
									X="0" />
							</TransformGroup>
						</Brush.Transform>
						<Brush.RelativeTransform>
							<TransformGroup>
								<ScaleTransform
									CenterY="0.5"
									CenterX="0.5" />
								<SkewTransform
									CenterX="0.5"
									CenterY="0.5" />
								<RotateTransform
									CenterX="0.5"
									CenterY="0.5" />
								<TranslateTransform
									X="0" />
							</TransformGroup>
						</Brush.RelativeTransform>
					</ImageBrush>
				</Control.Background>
				<FrameworkElement.Style>
					<Style
						TargetType="{x:Type Button}">
						<Setter
							Property="Background"
							Value="#FFFFFFFF" />
						<Setter
							Property="Template">
							<Setter.Value>
								<ControlTemplate
									TargetType="{x:Type Button}">
									<Border
										Background="{TemplateBinding Background}">
										<ContentPresenter
											HorizontalAlignment="Center"
											VerticalAlignment="Center" />
									</Border>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
						<Style.Triggers>
							<Trigger
								Property="UIElement.IsMouseOver"
								Value="True">
								<Setter
									Property="UIElement.Opacity"
									Value="0.7" />
							</Trigger>
						</Style.Triggers>
					</Style>
				</FrameworkElement.Style>
			</Button>
			<Button
				Name="GalleryNextButton"
				Grid.Column="4"
				BorderThickness="0"
				Margin="-5,30,0,0"
				Click="NextGalleryButton_Click">
				<Control.Background>
					<ImageBrush
						x:Name="GalleryNextButtonBrush"
						ImageSource="/Images/Next.png"
						Stretch="Uniform">
						<Brush.Transform>
							<TransformGroup>
								<ScaleTransform />
								<SkewTransform />
								<RotateTransform />
								<TranslateTransform
									X="0" />
							</TransformGroup>
						</Brush.Transform>
						<Brush.RelativeTransform>
							<TransformGroup>
								<ScaleTransform
									CenterY="0.5"
									CenterX="0.5" />
								<SkewTransform
									CenterX="0.5"
									CenterY="0.5" />
								<RotateTransform
									CenterX="0.5"
									CenterY="0.5" />
								<TranslateTransform
									X="0" />
							</TransformGroup>
						</Brush.RelativeTransform>
					</ImageBrush>
				</Control.Background>
				<FrameworkElement.Style>
					<Style
						TargetType="{x:Type Button}">
						<Setter
							Property="Background"
							Value="#FFFFFFFF" />
						<Setter
							Property="Template">
							<Setter.Value>
								<ControlTemplate
									TargetType="{x:Type Button}">
									<Border
										Background="{TemplateBinding Background}">
										<ContentPresenter
											HorizontalAlignment="Center"
											VerticalAlignment="Center" />
									</Border>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
						<Style.Triggers>
							<Trigger
								Property="UIElement.IsMouseOver"
								Value="True">
								<Setter
									Property="UIElement.Opacity"
									Value="0.7" />
							</Trigger>
						</Style.Triggers>
					</Style>
				</FrameworkElement.Style>
			</Button>
			<Button
				Name="GalleryPreviousButton"
				Grid.Column="2"
				BorderThickness="0"
				Margin="-5,30,0,0"
				Click="PreviousGalleryButton_Click">
				<Control.Background>
					<ImageBrush
						x:Name="GalleryPreviousButtonBrush"
						ImageSource="/Images/Back Icon.png"
						Stretch="Uniform">
						<Brush.Transform>
							<TransformGroup>
								<ScaleTransform />
								<SkewTransform />
								<RotateTransform />
								<TranslateTransform
									X="0" />
							</TransformGroup>
						</Brush.Transform>
						<Brush.RelativeTransform>
							<TransformGroup>
								<ScaleTransform
									CenterY="0.5"
									CenterX="0.5" />
								<SkewTransform
									CenterX="0.5"
									CenterY="0.5" />
								<RotateTransform
									CenterX="0.5"
									CenterY="0.5" />
								<TranslateTransform
									X="0" />
							</TransformGroup>
						</Brush.RelativeTransform>
					</ImageBrush>
				</Control.Background>
				<FrameworkElement.Style>
					<Style
						TargetType="{x:Type Button}">
						<Setter
							Property="Background"
							Value="#FFFFFFFF" />
						<Setter
							Property="Template">
							<Setter.Value>
								<ControlTemplate
									TargetType="{x:Type Button}">
									<Border
										Background="{TemplateBinding Background}">
										<ContentPresenter
											HorizontalAlignment="Center"
											VerticalAlignment="Center" />
									</Border>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
						<Style.Triggers>
							<Trigger
								Property="UIElement.IsMouseOver"
								Value="True">
								<Setter
									Property="UIElement.Opacity"
									Value="0.7" />
							</Trigger>
						</Style.Triggers>
					</Style>
				</FrameworkElement.Style>
			</Button>
			<Label
				x:XmlAttributeProperties.XmlSpace="preserve"
				Name="EventNameText"
				Grid.Column="1"
				Foreground="#FFFFFFFF"
				Margin="0,30,0,0"
				HorizontalContentAlignment="Left"
				VerticalAlignment="Center"
				FontFamily="{StaticResource MontserratSemiBold}"
				FontSize="{DynamicResource FontSizeDisplay2}"
				HorizontalAlignment="Left">Event Name - Motto</Label>
			<Label
				x:XmlAttributeProperties.XmlSpace="preserve"
				Name="PageNumberText"
				Grid.Column="3"
				Foreground="#FFFFFFFF"
				Margin="0,30,0,0"
				HorizontalContentAlignment="Center"
				VerticalAlignment="Center"
				FontFamily="{StaticResource MontserratSemiBold}"
				FontSize="{DynamicResource FontSizeDisplay2}"
				HorizontalAlignment="Center">1</Label>
		</Grid>
		<Grid
			Column="1"
			Row="1">
			<ScrollViewer
				Margin="5,5,5,80"
				VerticalScrollBarVisibility="Auto"
				HorizontalScrollBarVisibility="Disabled">
				<i:Interaction.Behaviors>
					<local2:ScrollViewerDragBehavior />
				</i:Interaction.Behaviors>
				<ItemsControl
					Name="UniformGridContext"
					ItemsSource="{Binding Items, ElementName=Galleri}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<UniformGrid
								Columns="4"
								VerticalAlignment="Top" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
				</ItemsControl>
			</ScrollViewer>
			<Button
				Name="DeleteButton"
				Content="DELETE"
				Foreground="#FFFFFFFF"
				FontFamily="{StaticResource MontserratSemiBold}"
				FontSize="{DynamicResource FontSizeButtonPrimary}"
				HorizontalAlignment="Right"
				VerticalAlignment="Bottom"
				Margin="20"
				Width="{Binding ElementName=mainGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.1}"
				Height="{Binding ElementName=mainGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.025}"
				Click="DeleteButton_Click">
				<UIElement.Effect>
					<DropShadowEffect
						Opacity="0.25"
						BlurRadius="20"
						ShadowDepth="10" />
				</UIElement.Effect>
				<FrameworkElement.Style>
					<Style
						TargetType="{x:Type Button}">
						<Setter
							Property="Background"
							Value="#FFFFFFFF" />
						<Setter
							Property="UIElement.Opacity"
							Value="1" />
						<Setter
							Property="Template">
							<Setter.Value>
								<ControlTemplate
									TargetType="{x:Type Button}">
									<Border
										Background="#EC2D30"
										CornerRadius="{Binding Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.5+1, RelativeSource={RelativeSource Self}}">
										<ContentPresenter
											HorizontalAlignment="Center"
											VerticalAlignment="Center" />
									</Border>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
						<Style.Triggers>
							<Trigger
								Property="UIElement.IsMouseOver"
								Value="True">
								<Setter
									Property="UIElement.Opacity"
									Value="0.7" />
							</Trigger>
							<Trigger
								Property="IsPressed"
								Value="True">
								<Setter
									Property="UIElement.Opacity"
									Value="0.7" />
							</Trigger>
						</Style.Triggers>
					</Style>
				</FrameworkElement.Style>
			</Button>
		</Grid>
		<Grid
			Name="previewGrid"
			Visibility="Hidden"
			Row="1"
			Column="1"
			Margin="5,5,5,50"
			Unloaded="previewGrid_Unloaded">
			<Image
				Source="/Images/loadingBlack2.png"
				Stretch="Fill"
				Opacity="0.5" />
			<Border
				BorderThickness="10"
				CornerRadius="25"
				Margin="-10">
				<Border.BorderBrush>
					<LinearGradientBrush
						EndPoint="0.5,1"
						StartPoint="0.5,0">
						<GradientStop
							Color="#FFCFCFCF"
							Offset="1" />
						<GradientStop
							Color="White" />
					</LinearGradientBrush>
				</Border.BorderBrush>
			</Border>
			<Grid
				Name="gridPreview">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="1*" />
					<ColumnDefinition
						Width="8*" />
					<ColumnDefinition
						Width="1*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="1*" />
					<RowDefinition
						Height="2*" />
					<RowDefinition
						Height="4*" />
				</Grid.RowDefinitions>
				<Grid
					Row="1"
					Column="1">
					<Image
						Source="/Images/PreviewScreen/PhotoResultShadow.png"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						Stretch="Fill"
						Margin="{Binding ElementName=gridPreview, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=-x/38.4+1}" />
					<Image
						Name="photoPanel"
						Source="/Images/WhiteOpacityBackground.png"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						Stretch="Fill">
						<UIElement.OpacityMask>
							<ImageBrush
								ImageSource="/Images/PreviewScreen/PhotoResultMask.png" />
						</UIElement.OpacityMask>
					</Image>
					<Border
						Name="borderLoginSmooth"
						Margin="-5"
						BorderThickness="10"
						CornerRadius="{Binding ElementName=gridPreview, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.0130+1}">
						<Border.BorderBrush>
							<LinearGradientBrush
								EndPoint="0.5,1"
								StartPoint="0.5,0">
								<GradientStop
									Color="White"
									Offset="0" />
								<GradientStop
									Color="#FFD5D5D5"
									Offset="1" />
							</LinearGradientBrush>
						</Border.BorderBrush>
					</Border>
					<MediaElement
						Name="videoPlayer"
						Visibility="Hidden">
						<UIElement.OpacityMask>
							<VisualBrush
								Visual="{Binding ElementName=borderLoginSmooth}" />
						</UIElement.OpacityMask>
					</MediaElement>
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition
								Height="3*" />
							<RowDefinition
								Height="20*" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="20*" />
							<ColumnDefinition
								Width="2*" />
						</Grid.ColumnDefinitions>
						<Button
							Name="CancelButton"
							Grid.Column="1"
							BorderThickness="0"
							Margin="10,0,-10,0"
							Foreground="#FFFFFFFF"
							FontFamily="{StaticResource MontserratBold}"
							FontSize="30"
							Click="CancelButton_Click">
							<UIElement.OpacityMask>
								<ImageBrush
									ImageSource="/Images/Close.png" />
							</UIElement.OpacityMask>
							<Control.Background>
								<ImageBrush
									x:Name="CancelBrush"
									Stretch="Uniform"
									ImageSource="/Images/Close.png" />
							</Control.Background>
							<FrameworkElement.Style>
								<Style
									TargetType="{x:Type Button}">
									<Setter
										Property="Background"
										Value="#FFFFFFFF" />
									<Setter
										Property="Template">
										<Setter.Value>
											<ControlTemplate
												TargetType="{x:Type Button}">
												<Border
													Background="{TemplateBinding Background}">
													<ContentPresenter
														HorizontalAlignment="Center"
														VerticalAlignment="Center" />
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<Style.Triggers>
										<Trigger
											Property="UIElement.IsMouseOver"
											Value="True">
											<Setter
												Property="UIElement.Opacity"
												Value="0.7" />
										</Trigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
						</Button>
					</Grid>
				</Grid>
			</Grid>
		</Grid>
	</Grid>
</Page>
