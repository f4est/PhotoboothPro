<Window
	x:Class="KingAIPhotoBoothPro.CameraSettingsWindows" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages.ActivationKing"
	WindowStyle="None"
	AllowsTransparency="True"
	Background="#FFFFFFFF"
	Topmost="True"
	Title="CameraSettingsWindows"
	Height="630"
	Width="800" xmlns:kingaiphotoboothpro="clr-namespace:KingAIPhotoBoothPro"
	PreviewMouseUp="Window_PreviewMouseUp"
	Loaded="Window_Loaded"
	Unloaded="Window_Unloaded">
	<Grid
		Name="GridMain">
		<StackPanel>
			<Grid
				Height="30" />
			<Grid
				Height="240"
				Width="800"
				MouseDown="cameraSettingsGrid_MouseDown">
				<GroupBox
					Name="cameraSettingsGrid"
					Margin="5">
					<HeaderedContentControl.Header>
						<TextBlock
							FontWeight="Bold">
							<TextBlock>Camera Settings [</TextBlock> <TextBlock
								Text="{Binding Path=DisplayName}" /> <TextBlock>]</TextBlock></TextBlock>
					</HeaderedContentControl.Header>
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="28*" />
							<ColumnDefinition
								Width="97*" />
							<ColumnDefinition
								Width="125*" />
							<ColumnDefinition
								Width="5" />
							<ColumnDefinition
								Width="125*" />
							<ColumnDefinition
								Width="125*" />
						</Grid.ColumnDefinitions>
						<Label
							Grid.Column="1"
							Style="{StaticResource DataEntryLabel}"
							HorizontalAlignment="Left"
							Margin="51,0,0,0">F Stop:</Label>
						<ComboBox
							Name="FNumberBox"
							Grid.Row="0"
							Grid.Column="2"
							Margin="5,5,5,5"
							IsEnabled="{Binding Path=FNumber.IsEnabled}"
							ItemsSource="{Binding Path=FNumber.Values}"
							SelectedValue="{Binding Path=FNumber.Value}" />
						<Label
							Grid.Column="4"
							Style="{StaticResource DataEntryLabel}"
							HorizontalAlignment="Left"
							Margin="94,0,0,0">ISO:</Label>
						<ComboBox
							Name="IsoNumberBox"
							Grid.Row="0"
							Grid.Column="5"
							Margin="5,5,5,5"
							IsEnabled="{Binding Path=IsoNumber.IsEnabled}"
							ItemsSource="{Binding Path=IsoNumber.Values}"
							SelectedValue="{Binding Path=IsoNumber.Value}" />
						<Label
							Grid.Row="1"
							Grid.Column="1"
							Style="{StaticResource DataEntryLabel}"
							HorizontalAlignment="Left"
							Margin="46,0,0,0">Shutter:</Label>
						<ComboBox
							Name="ShutterBox"
							Grid.Row="1"
							Grid.Column="2"
							Margin="5,5,5,5"
							IsEnabled="{Binding Path=ShutterSpeed.IsEnabled}"
							ItemsSource="{Binding Path=ShutterSpeed.Values}"
							SelectedValue="{Binding Path=ShutterSpeed.Value}" />
						<Label
							Grid.Row="2"
							Grid.Column="1"
							Style="{StaticResource DataEntryLabel}"
							HorizontalAlignment="Left"
							Margin="15,0,0,0">Compression:</Label>
						<ComboBox
							Name="CompressionSettingsComboBox"
							Grid.Row="2"
							Grid.Column="2"
							Margin="5,5,5,5"
							IsEnabled="{Binding Path=CompressionSetting.IsEnabled}"
							ItemsSource="{Binding Path=CompressionSetting.Values}"
							SelectedValue="{Binding Path=CompressionSetting.Value}" />
						<Label
							Grid.Row="1"
							Grid.Column="4"
							Style="{StaticResource DataEntryLabel}"
							HorizontalAlignment="Left"
							Margin="37,0,0,0">White Balance:</Label>
						<ComboBox
							Grid.Row="1"
							Grid.Column="5"
							Margin="5,5,5,5"
							IsEnabled="{Binding Path=WhiteBalance.IsEnabled}"
							ItemsSource="{Binding Path=WhiteBalance.Values}"
							SelectedValue="{Binding Path=WhiteBalance.Value}" />
						<Grid
							Row="3"
							Column="1"
							ColumnSpan="5">
							<Label
								Name="BrightnessLabel"
								HorizontalAlignment="Center"
								FontFamily="{Binding ElementName=IsoNumberBox}">Brightness</Label>
						</Grid>
						<Grid
							Row="4"
							RowSpan="2"
							Column="1"
							ColumnSpan="5">
							<Slider
								Name="brightnessSlider"
								Minimum="0"
								Maximum="100"
								Value="50"
								TickFrequency="1"
								TickPlacement="BottomRight"
								IsSnapToTickEnabled="True"
								Margin="0,10"
								ValueChanged="brightnessSlider_ValueChanged" />
						</Grid>
						<Grid
							Row="5"
							Column="1"
							ColumnSpan="5">
							<Label
								Name="BrightnessValueLabel"
								HorizontalAlignment="Center"
								FontFamily="{Binding ElementName=IsoNumberBox}" />
						</Grid>
					</Grid>
				</GroupBox>
			</Grid>
			<Grid>
				<Image
					Name="gridPreviewBackgroundImage"
					Stretch="UniformToFill" />
			</Grid>
		</StackPanel>
		<Grid
			Height="60"
			VerticalAlignment="Top"
			HorizontalAlignment="Right">
			<Button
				Name="DeleteButton"
				VerticalAlignment="Top"
				HorizontalAlignment="Right"
				Background="#00FFFFFF"
				BorderBrush="#00FFFFFF"
				Margin="3"
				Height="{Binding ElementName=GridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.04}"
				Width="{Binding ElementName=DeleteButton, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*1}"
				Click="DeleteButton_Click">
				<FrameworkElement.Style>
					<Style
						TargetType="{x:Type Button}">
						<Setter
							Property="Template">
							<Setter.Value>
								<ControlTemplate
									TargetType="{x:Type Button}">
									<Border
										Background="{TemplateBinding Background}">
										<ContentPresenter
											HorizontalAlignment="Center"
											VerticalAlignment="Center" />
									</Border>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
						<Style.Triggers>
							<Trigger
								Property="UIElement.IsMouseOver"
								Value="True">
								<Setter
									Property="UIElement.Opacity"
									Value="0.9" />
							</Trigger>
						</Style.Triggers>
					</Style>
				</FrameworkElement.Style>
				<Grid
					Name="DeleteButtonInsideGrid"
					Margin="{Binding ElementName=DeleteButton, Path=ActualWidth, Converter={StaticResource SpecificMarginConverter}, ConverterParameter=right,0.}">
					<Grid>
						<Path
							Name="Circle"
							Data="{StaticResource CircleIcon}"
							Stretch="Uniform"
							Fill="#FFFF0000">
							<UIElement.Effect>
								<DropShadowEffect
									Color="Black"
									Opacity="0.2"
									BlurRadius="20"
									ShadowDepth="5"
									Direction="200" />
							</UIElement.Effect>
						</Path>
					</Grid>
					<Grid>
						<Path
							Data="{StaticResource XIcon}"
							Stretch="Uniform"
							Fill="#FFFFFFFF"
							Margin="{Binding ElementName=DeleteButtonInsideGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.25}" />
					</Grid>
				</Grid>
			</Button>
		</Grid>
	</Grid>
</Window>
