<Page
	x:Class="KingAIPhotoBoothPro.Pages.DSLRGif" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages" xmlns:class="clr-namespace:KingAIPhotoBoothPro.Class" xmlns:math="http://hexinnovation.com/math"
	Name="pageGif"
	Title="DSLRGif"
	Loaded="Page_Loaded"
	Unloaded="Page_Unloaded"
	SizeChanged="pageGif_SizeChanged">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<math:MathConverter
				x:Key="math" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="gridMain"
		Background="#00FFFFFF">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="8*" />
			<RowDefinition
				Height="140*" />
			<RowDefinition
				Height="4*" />
			<RowDefinition
				Height="40*" />
			<RowDefinition
				Height="8*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="16*" />
			<ColumnDefinition
				Width="50*" />
			<ColumnDefinition
				Width="16*" />
		</Grid.ColumnDefinitions>
		<Grid
			Name="gridLeftButtton"
			Row="1"
			RowSpan="1">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="2*" />
				<RowDefinition
					Height="8*" />
			</Grid.RowDefinitions>
			<Button
				Name="CancelButton"
				IsDefault="True"
				Content="CANCEL"
				Foreground="#FFFFFFFF"
				FontFamily="{StaticResource MontserratBold}"
				FontWeight="Bold"
				FontSize="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.015+1}"
				Click="CancelButton_Click">
				<Control.Background>
					<ImageBrush
						x:Name="CancelBrush"
						Stretch="Uniform"
						ImageSource="/Images/CancelButton.png" />
				</Control.Background>
				<FrameworkElement.Style>
					<Style
						TargetType="{x:Type Button}">
						<Setter
							Property="Background"
							Value="#FFFFFFFF" />
						<Setter
							Property="Template">
							<Setter.Value>
								<ControlTemplate
									TargetType="{x:Type Button}">
									<Border
										Background="{TemplateBinding Background}">
										<ContentPresenter
											HorizontalAlignment="Center"
											VerticalAlignment="Center" />
									</Border>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
						<Style.Triggers>
							<Trigger
								Property="UIElement.IsMouseOver"
								Value="True">
								<Setter
									Property="UIElement.Opacity"
									Value="0.7" />
							</Trigger>
						</Style.Triggers>
					</Style>
				</FrameworkElement.Style>
			</Button>
		</Grid>
		<Grid
			Name="PhotoPanel"
			Row="1"
			Column="1"
			Visibility="Visible"
			Margin="0,10,0,0">
			<Image
				Source="/Images/PreviewScreen/PhotoResultShadow.png"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				Stretch="Fill"
				Margin="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=-x/38.4+1}" />
			<Image
				Name="LiveViewImage"
				Source="/Images/WhiteOpacityBackground.png"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				Stretch="Fill">
				<UIElement.OpacityMask>
					<ImageBrush
						ImageSource="/Images/PreviewScreen/PhotoResultMask.png" />
				</UIElement.OpacityMask>
			</Image>
			<Border
				Name="borderLoginSmooth"
				Margin="-5"
				BorderThickness="10"
				CornerRadius="{Binding ElementName=pageGif, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.0130+1}">
				<Border.BorderBrush>
					<LinearGradientBrush
						EndPoint="0.5,1"
						StartPoint="0.5,0">
						<GradientStop
							Color="White"
							Offset="0" />
						<GradientStop
							Color="#FFD5D5D5"
							Offset="1" />
					</LinearGradientBrush>
				</Border.BorderBrush>
			</Border>
			<Grid
				Visibility="Visible"
				Row="1"
				Column="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="139*" />
					<ColumnDefinition
						Width="117*" />
					<ColumnDefinition
						Width="139*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="117*" />
					<RowDefinition
						Height="139*" />
					<RowDefinition
						Height="117*" />
				</Grid.RowDefinitions>
			</Grid>
		</Grid>
		<Grid
			Row="3"
			Column="1"
			Margin="0,20,0,20">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="10*" />
				<ColumnDefinition
					Width="1*" />
				<ColumnDefinition
					Width="10*" />
				<ColumnDefinition
					Width="1*" />
				<ColumnDefinition
					Width="10*" />
				<ColumnDefinition
					Width="1*" />
				<ColumnDefinition
					Width="10*" />
			</Grid.ColumnDefinitions>
			<Grid
				Name="Photo1">
				<Image
					Source="/Images/PreviewScreen/PhotoGifShadow.png"
					Stretch="Fill"
					Margin="{Binding ElementName=pageGif, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=-x/38.4+1}" />
				<TextBlock
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Foreground="#FFFFFFFF"
					FontSize="{Binding ElementName=pageGif, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.034+1}">1</TextBlock>
				<Image
					Name="Photo1Image"
					Source="/Images/WhiteOpacityBackground.png"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					Stretch="Fill">
					<UIElement.OpacityMask>
						<ImageBrush
							ImageSource="/Images/PhotoGifMask.png" />
					</UIElement.OpacityMask>
				</Image>
				<Border
					Name="borderPhoto1"
					Margin="-5"
					BorderThickness="10"
					CornerRadius="{Binding ElementName=pageGif, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.0130+1}">
					<Border.BorderBrush>
						<LinearGradientBrush
							EndPoint="0.5,1"
							StartPoint="0.5,0">
							<GradientStop
								Color="White"
								Offset="0" />
							<GradientStop
								Color="#FFD5D5D5"
								Offset="1" />
						</LinearGradientBrush>
					</Border.BorderBrush>
				</Border>
			</Grid>
			<Grid
				Name="Photo2"
				Column="2">
				<Image
					Source="/Images/PreviewScreen/PhotoGifShadow.png"
					Stretch="Fill"
					Margin="{Binding ElementName=pageGif, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=-x/38.4+1}" />
				<TextBlock
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Foreground="#FFFFFFFF"
					FontSize="{Binding ElementName=pageGif, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.034+1}">2</TextBlock>
				<Image
					Name="Photo2Image"
					Source="/Images/WhiteOpacityBackground.png"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					Stretch="Fill">
					<UIElement.OpacityMask>
						<ImageBrush
							ImageSource="/Images/PhotoGifMask.png" />
					</UIElement.OpacityMask>
				</Image>
				<Border
					Name="borderPhoto2"
					Margin="-5"
					BorderThickness="10"
					CornerRadius="{Binding ElementName=pageGif, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.0130+1}">
					<Border.BorderBrush>
						<LinearGradientBrush
							EndPoint="0.5,1"
							StartPoint="0.5,0">
							<GradientStop
								Color="White"
								Offset="0" />
							<GradientStop
								Color="#FFD5D5D5"
								Offset="1" />
						</LinearGradientBrush>
					</Border.BorderBrush>
				</Border>
			</Grid>
			<Grid
				Name="Photo3"
				Column="4">
				<Image
					Source="/Images/PreviewScreen/PhotoGifShadow.png"
					Stretch="Fill"
					Margin="{Binding ElementName=pageGif, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=-x/38.4+1}" />
				<TextBlock
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Foreground="#FFFFFFFF"
					FontSize="{Binding ElementName=pageGif, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.034+1}">3</TextBlock>
				<Image
					Name="Photo3Image"
					Source="/Images/WhiteOpacityBackground.png"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					Stretch="Fill">
					<UIElement.OpacityMask>
						<ImageBrush
							ImageSource="/Images/PhotoGifMask.png" />
					</UIElement.OpacityMask>
				</Image>
				<Border
					Name="borderPhoto3"
					Margin="-5"
					BorderThickness="10"
					CornerRadius="{Binding ElementName=pageGif, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.0130+1}">
					<Border.BorderBrush>
						<LinearGradientBrush
							EndPoint="0.5,1"
							StartPoint="0.5,0">
							<GradientStop
								Color="White"
								Offset="0" />
							<GradientStop
								Color="#FFD5D5D5"
								Offset="1" />
						</LinearGradientBrush>
					</Border.BorderBrush>
				</Border>
			</Grid>
			<Grid
				Name="Photo4"
				Column="6">
				<Image
					Source="/Images/PreviewScreen/PhotoGifShadow.png"
					Stretch="Fill"
					Margin="{Binding ElementName=pageGif, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=-x/38.4+1}" />
				<TextBlock
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Foreground="#FFFFFFFF"
					FontSize="{Binding ElementName=pageGif, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.034+1}">4</TextBlock>
				<Image
					Name="Photo4Image"
					Source="/Images/WhiteOpacityBackground.png"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					Stretch="Fill">
					<UIElement.OpacityMask>
						<ImageBrush
							ImageSource="/Images/PhotoGifMask.png" />
					</UIElement.OpacityMask>
				</Image>
				<Border
					Name="borderPhoto4"
					Margin="-5"
					BorderThickness="10"
					CornerRadius="{Binding ElementName=pageGif, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.0130+1}">
					<Border.BorderBrush>
						<LinearGradientBrush
							EndPoint="0.5,1"
							StartPoint="0.5,0">
							<GradientStop
								Color="White"
								Offset="0" />
							<GradientStop
								Color="#FFD5D5D5"
								Offset="1" />
						</LinearGradientBrush>
					</Border.BorderBrush>
				</Border>
			</Grid>
		</Grid>
	</Grid>
</Page>
