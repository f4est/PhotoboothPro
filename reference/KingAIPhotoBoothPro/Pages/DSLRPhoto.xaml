<Page
	x:Class="KingAIPhotoBoothPro.Pages.DSLRPhoto" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:class="clr-namespace:KingAIPhotoBoothPro.Class" xmlns:math="http://hexinnovation.com/math" xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
	Title="DSLRPhoto" xmlns:pages="clr-namespace:KingAIPhotoBoothPro.Pages"
	Loaded="Page_LoadedAsync"
	Unloaded="Page_Unloaded"
	SizeChanged="Page_SizeChanged">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<math:MathConverter
				x:Key="math" />
			<Style
				TargetType="{x:Type CheckBox}"
				x:Key="{x:Type CheckBox}">
				<Setter
					Property="Foreground"
					Value="#002C3A" />
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type CheckBox}">
							<Grid
								Background="#00FFFFFF">
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="10*" />
									<ColumnDefinition
										Width="5*" />
									<ColumnDefinition
										Width="Auto" />
								</Grid.ColumnDefinitions>
								<Border
									Name="checkBoxBorder"
									BorderBrush="#002C3A"
									BorderThickness="2"
									Background="#00FFFFFF"
									CornerRadius="2"
									Width="35"
									Height="35"
									Margin="0"
									Visibility="Visible" />
								<Path
									Name="checkedImage"
									StrokeThickness="0"
									Stretch="Uniform"
									Fill="#002C3A"
									Visibility="Hidden"
									Width="35"
									Height="35">
									<Path.Data>
										<GeometryGroup>
											<RectangleGeometry
												Rect="0,0,36,36"
												RadiusX="2"
												RadiusY="2" />
											<Geometry>M26.7783 11.7968C27.3641 12.3825 27.3641 13.3323 26.7783 13.9181L16.4926 24.2038C15.9068 24.7896 14.957 24.7896 14.3713 24.2038L9.2284 19.0609C8.64262 18.4752 8.64262 17.5254 9.2284 16.9396C9.81419 16.3538 10.7639 16.3538 11.3497 16.9396L15.4319 21.0218L24.657 11.7968C25.2428 11.211 26.1925 11.211 26.7783 11.7968Z</Geometry>
										</GeometryGroup>
									</Path.Data>
								</Path>
								<Grid
									Column="1"
									Width="{Binding ElementName=checkedImage, Path=ActualWidth, ConverterParameter=x*15/48, Converter={StaticResource math}}" />
								<Grid
									Name="contentGrid"
									Column="2">
									<ContentPresenter
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										SnapsToDevicePixels="True"
										Margin="0,0,0,0"
										RecognizesAccessKey="True"
										TextBlock.Foreground="#002C3A"
										TextBlock.FontSize="{DynamicResource FontSizeHeading1}"
										TextBlock.FontFamily="{StaticResource MontserratBold}" />
								</Grid>
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger
									Property="ToggleButton.IsChecked"
									Value="True">
									<Setter
										TargetName="checkedImage"
										Property="Visibility"
										Value="Visible" />
								</Trigger>
								<Trigger
									Property="ToggleButton.IsChecked"
									Value="{x:Null}">
									<Setter
										TargetName="checkedImage"
										Property="Visibility"
										Value="Hidden" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Name="gridMain"
		Background="#AA000000">
		<Grid
			Name="PhotoPanelContainer"
			Margin="0">
			<Grid
				Name="PhotoPanel"
				Row="1"
				Column="1"
				Visibility="Visible">
				<Border
					Name="photoMaskFullscreen"
					Background="#FF000000"
					Visibility="Hidden"
					CornerRadius="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.016+1}" />
				<Image
					Name="LiveViewImage"
					Source="/Images/LoginPage/ActivationKingBG.jpg"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					RenderTransformOrigin="0.5, 0.5"
					Stretch="Uniform">
					<UIElement.RenderTransform>
						<ScaleTransform
							x:Name="LiveViewScaleTransform"
							ScaleX="-1" />
					</UIElement.RenderTransform>
				</Image>
				<Grid
					Name="LoadingGrid"
					Visibility="Visible">
					<Border
						Margin="0"
						Background="#FF000000"
						Opacity="0.9"
						CornerRadius="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.012+1}">
						<Border.BorderBrush>
							<LinearGradientBrush
								EndPoint="0.5,1"
								StartPoint="0.5,0">
								<GradientStop
									Color="Black"
									Offset="0" />
								<GradientStop
									Color="Black"
									Offset="1" />
							</LinearGradientBrush>
						</Border.BorderBrush>
					</Border>
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition
								Height="1*" />
							<RowDefinition
								Height="1*" />
							<RowDefinition
								Height="1*" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="1*" />
							<ColumnDefinition
								Width="1*" />
							<ColumnDefinition
								Width="1*" />
						</Grid.ColumnDefinitions>
						<Grid
							Name="LoadingContainer"
							Row="1"
							Column="1">
							<lottie:LottieAnimationView
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								AutoPlay="True"
								FileName="Animations/LoadingPill.json"
								RepeatCount="-1"
								Width="{Binding ElementName=LoadingContainer, Path=ActualWidth}"
								Height="{Binding ElementName=LoadingContainer, Path=ActualHeight}" />
						</Grid>
						<Grid
							Row="2"
							Column="1">
							<Grid.RowDefinitions>
								<RowDefinition
									Height="1*" />
								<RowDefinition
									Height="1*" />
							</Grid.RowDefinitions>
							<TextBlock
								Name="loadingCountDown"
								Grid.Row="1"
								Foreground="#FFFFFFFF"
								TextAlignment="Center"
								FontSize="{DynamicResource FontSizeHeading3}"
								FontFamily="{StaticResource PromptBold}"
								TextWrapping="Wrap"
								Visibility="Visible" />
						</Grid>
					</Grid>
				</Grid>
				<Grid
					Name="CountdownGrid"
					Visibility="Visible"
					Row="1"
					Column="1">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="139*" />
						<ColumnDefinition
							Width="117*" />
						<ColumnDefinition
							Width="139*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="117*" />
						<RowDefinition
							Height="139*" />
						<RowDefinition
							Height="117*" />
					</Grid.RowDefinitions>
					<Grid
						Name="countdownContainer"
						Row="1"
						Column="1">
						<lottie:LottieAnimationView
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							AutoPlay="True"
							FileName="Animations/Countdown.json"
							RepeatCount="-1"
							Width="{Binding ElementName=countdownContainer, Path=ActualWidth}"
							Height="{Binding ElementName=countdownContainer, Path=ActualHeight}" />
					</Grid>
					<TextBlock
						Name="countDownText"
						Grid.Row="1"
						Grid.Column="1"
						Foreground="#FFFFFFFF"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Text="10"
						FontSize="{Binding ElementName=CountdownGrid, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.18+1}" />
				</Grid>
				<class:ButtonIcon
					Name="CloseFullscreenButton"
					Click="CancelButton_Click"
					Style="{DynamicResource ButtonIconKey}"
					Icon="{StaticResource DoneIcon}"
					IconMargin="0"
					BlackCoverVisibility="Hidden"
					LoadingAnimationVisibility="Hidden"
					Background="#33000000"
					Content="Close"
					VerticalAlignment="Top"
					Height="auto"
					HorizontalAlignment="Left"
					Width="250"
					Margin="40" />
			</Grid>
		</Grid>
		<Grid
			Name="adsVideoGrid"
			ColumnSpan="3"
			RowSpan="5"
			Visibility="Collapsed">
			<MediaElement
				Name="videoPlayer"
				Visibility="Visible" />
			<Grid
				Name="SkipVideoButton"
				Background="#00000000"
				MouseDown="SkipVideoButton_Click" />
		</Grid>
		<TextBlock
			Name="txtDebug"
			Text=""
			VerticalAlignment="Bottom"
			Foreground="#FFFFFFFF"
			FontSize="70"
			Visibility="Hidden" />
	</Grid>
</Page>
