							Width="5*" />
						<ColumnDefinition
							Width="1*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="1*" />
						<RowDefinition
							Height="4*" />
						<RowDefinition
							Height="18*" />
					</Grid.RowDefinitions>
					<Button
						Name="MainPaymentBackButton"
						Style="{StaticResource ButtonWithoutStyle}"
						Grid.Row="1"
						Grid.Column="1"
						Click="MainPaymentBackButton_Click">
						<Grid
							Width="{Binding ElementName=MainPaymentBackButton, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*1}"
							Height="{Binding ElementName=MainPaymentBackButton, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*1}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="18*" />
								<ColumnDefinition
									Width="67*" />
								<ColumnDefinition
									Width="14*" />
								<ColumnDefinition
									Width="175*" />
								<ColumnDefinition
									Width="21*" />
							</Grid.ColumnDefinitions>
							<Border
								Name="BackgroundBorder"
								Background="#FFFFFFFF"
								Grid.ColumnSpan="5"
								CornerRadius="{DynamicResource UICornerRadius}" />
							<Border
								Name="BuyNowIconPathBorder"
								Background="#FFFFFFFF"
								Grid.Column="1"
								Margin="3" />
							<Path
								Name="BuyNowIconPath"
								Grid.Column="1"
								Data="{StaticResource BackIcon}"
								Fill="#FCA49A"
								Stroke="#00FFFFFF"
								Stretch="Uniform"
								StrokeThickness="2"
								VerticalAlignment="Center"
								HorizontalAlignment="Center" />
							<Viewbox
								Stretch="Uniform"
								Grid.Column="3">
								<TextBlock
									Text="GO BACK"
									Foreground="#FF000000"
									FontFamily="{StaticResource MontserratBold}"
									FontSize="{DynamicResource FontSizeTextTitle}"
									VerticalAlignment="Center"
									HorizontalAlignment="Center" />
							</Viewbox>
						</Grid>
					</Button>
				</Grid>
			</Grid>
			<Grid
				Name="loadingPaymentGrid"
				ColumnSpan="5"
				RowSpan="5"
				Visibility="Collapsed">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="1*" />
					<ColumnDefinition
						Width="1*" />
					<ColumnDefinition
						Width="1*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="10*" />
					<RowDefinition
						Height="5*" />
					<RowDefinition
						Height="25*" />
					<RowDefinition
						Height="10*" />
					<RowDefinition
						Height="10*" />
				</Grid.RowDefinitions>
				<TextBlock
					Name="PaymentLoadingPageTitle"
					Grid.ColumnSpan="3"
					Text="Almost There!"
					Background="#00FFFFFF"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Foreground="#FFFFFFFF"
					TextAlignment="Center"
					Margin="0,40,0,0"
					FontFamily="{StaticResource MontserratRegular}"
					FontSize="{DynamicResource FontSizeDisplay1}" />
				<TextBlock
					Name="PaymentLoadingPageText"
					Grid.Column="1"
					Grid.Row="1"
					Text="Complete your paymen to keep the fun going"
					Background="#00FFFFFF"
					HorizontalAlignment="Center"
					VerticalAlignment="Top"
					Foreground="#FFFFFFFF"
					TextAlignment="Center"
					Margin="25,0,0,0"
					FontFamily="{StaticResource MontserratRegular}"
					FontSize="{DynamicResource FontSizeTextTitle}" />
				<Grid
					Column="1"
					Row="2">
					<Image
						Name="PaymentUrlImage" />
				</Grid>
				<TextBlock
					Name="PaymentLoadingPageScanQRText"
					Grid.Column="1"
					Grid.Row="3"
					Text="Scan the QR code with &#xA;your phone to pay"
					Background="#00FFFFFF"
					HorizontalAlignment="Center"
					TextWrapping="Wrap"
					VerticalAlignment="Center"
					Foreground="#FFFFFFFF"
					TextAlignment="Center"
					Margin="25,0,0,0"
					FontFamily="{StaticResource MontserratRegular}"
					FontSize="{DynamicResource FontSizeTextTitle}" />
				<TextBlock
					Name="PaymentTimeText"
					Grid.Column="1"
					Grid.Row="4"
					Text="120"
					Background="#00FFFFFF"
					HorizontalAlignment="Center"
					TextWrapping="Wrap"
					VerticalAlignment="Top"
					Foreground="#FFFFFFFF"
					TextAlignment="Center"
					Margin="25,0,0,0"
					FontFamily="{StaticResource MontserratRegular}"
					FontSize="{DynamicResource FontSizeHeading1}" />
				<Grid
					RowSpan="10"
					ColumnSpan="10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="1*" />
						<ColumnDefinition
							Width="3*" />
						<ColumnDefinition
							Width="1*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="1*" />
						<RowDefinition
							Height="2*" />
					</Grid.RowDefinitions>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="2*" />
							<ColumnDefinition
								Width="17*" />
							<ColumnDefinition
								Width="8*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition
								Height="1*" />
							<RowDefinition
								Height="4*" />
							<RowDefinition
								Height="18*" />
						</Grid.RowDefinitions>
						<Button
							Name="DeleteButton"
							Grid.Row="1"
							Grid.Column="1"
							BorderThickness="0"
							Content="Go Back"
							Foreground="#FFFFFFFF"
							FontFamily="{StaticResource MontserratSemiBold}"
							FontSize="{DynamicResource FontSizeButtonPrimary}"
							Background="{StaticResource UIRedButton}"
							Margin="0,0,10,0"
							Width="{Binding ElementName=buttons, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.3}"
							Click="DeleteButton_Click">
							<FrameworkElement.Style>
								<Style
									TargetType="{x:Type Button}">
									<Setter
										Property="Template">
										<Setter.Value>
											<ControlTemplate
												TargetType="{x:Type Button}">
												<Border
													Name="borderCreateButton"
													Background="{TemplateBinding Background}"
													CornerRadius="{Binding ElementName=borderCreateButton, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.5+1}">
													<ContentPresenter
														HorizontalAlignment="Center"
														VerticalAlignment="Center" />
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<Style.Triggers>
										<Trigger
											Property="UIElement.IsMouseOver"
											Value="True">
											<Setter
												Property="UIElement.Opacity"
												Value="0.7" />
										</Trigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
						</Button>
					</Grid>
				</Grid>
			</Grid>
			<Grid
				Name="SuccessPaymentGrid"
				ColumnSpan="5"
				RowSpan="5"
				Visibility="Visible">
				<Grid.RowDefinitions>
					<RowDefinition
						Height="1*" />
					<RowDefinition
						Height="2*" />
					<RowDefinition
						Height="3*" />
					<RowDefinition
						Height="2*" />
					<RowDefinition
						Height="1*" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="1*" />
					<ColumnDefinition
						Width="3*" />
					<ColumnDefinition
						Width="1*" />
				</Grid.ColumnDefinitions>
				<TextBlock
					Grid.Row="1"
					Grid.Column="1"
					Text="You're All Set!"
					Background="#00FFFFFF"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Foreground="#FFFFFFFF"
					TextAlignment="Center"
					Margin="0,0,0,0"
					FontFamily="{StaticResource MontserratRegular}"
					FontSize="{DynamicResource FontSizeDisplay1}" />
				<TextBlock
					Name="PaymentSessionInfoText"
					Grid.Row="2"
					Grid.Column="1"
					Text="You've unlocked"
					Background="#00FFFFFF"
					HorizontalAlignment="Center"
					VerticalAlignment="Top"
					Foreground="#FFFFFFFF"
					TextAlignment="Center"
					Margin="0,0,0,0"
					FontFamily="{StaticResource MontserratRegular}"
					FontSize="{DynamicResource FontSizeHeading2}" />
				<Grid
					Row="2"
					Column="1">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="1*" />
						<ColumnDefinition
							Width="3*" />
						<ColumnDefinition
							Width="3*" />
						<ColumnDefinition
							Width="1*" />
					</Grid.ColumnDefinitions>
					<Button
						Name="PayingPhotoButton"
						Grid.Column="1"
						Click="PayingPhotoButton_Click">
						<Control.Background>
							<ImageBrush
								x:Name="PayingPhotoButtonBrush"
								ImageSource="/Images/printer.png"
								Stretch="Uniform">
								<Brush.Transform>
									<TransformGroup>
										<ScaleTransform />
										<SkewTransform />
										<RotateTransform />
										<TranslateTransform
											X="0" />
									</TransformGroup>
								</Brush.Transform>
								<Brush.RelativeTransform>
									<TransformGroup>
										<ScaleTransform
											CenterY="0.5"
											CenterX="0.5" />
										<SkewTransform
											CenterX="0.5"
											CenterY="0.5" />
										<RotateTransform
											CenterX="0.5"
											CenterY="0.5" />
										<TranslateTransform
											X="0" />
									</TransformGroup>
								</Brush.RelativeTransform>
							</ImageBrush>
						</Control.Background>
						<FrameworkElement.Style>
							<Style
								TargetType="{x:Type Button}">
								<Setter
									Property="Background"
									Value="#FFFFFFFF" />
								<Setter
									Property="Template">
									<Setter.Value>
										<ControlTemplate
											TargetType="{x:Type Button}">
											<Border
												Background="{TemplateBinding Background}">
												<ContentPresenter
													HorizontalAlignment="Center"
													VerticalAlignment="Center" />
											</Border>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
								<Style.Triggers>
									<Trigger
										Property="UIElement.IsMouseOver"
										Value="True">
										<Setter
											Property="UIElement.Opacity"
											Value="0.7" />
									</Trigger>
									<Trigger
										Property="IsEnabled"
										Value="False">
										<Setter
											Property="Background"
											Value="#FF808080" />
									</Trigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
					</Button>
					<TextBlock
						Grid.Column="1"
						Text="Start Print   "
						Background="#00FFFFFF"
						HorizontalAlignment="Center"
						VerticalAlignment="Bottom"
						Foreground="#FFFFFFFF"
						TextAlignment="Center"
						Margin="25,0,0,0"
						FontFamily="{StaticResource MontserratRegular}"
						FontSize="{DynamicResource FontSizeHeading2}" />
					<Button
						Name="PayingDigitalPhotoButton"
						Grid.Column="2"
						Click="PayingDigitalPhotoButton_Click">
						<Control.Background>
							<ImageBrush
								ImageSource="/Images/ImportIcon.png"
								Stretch="Uniform">
								<Brush.Transform>
									<TransformGroup>
										<ScaleTransform />
										<SkewTransform />
										<RotateTransform />
										<TranslateTransform
											X="0" />
									</TransformGroup>
								</Brush.Transform>
								<Brush.RelativeTransform>
									<TransformGroup>
										<ScaleTransform
											CenterY="0.5"
											CenterX="0.5" />
										<SkewTransform
											CenterX="0.5"
											CenterY="0.5" />
										<RotateTransform
											CenterX="0.5"
											CenterY="0.5" />
										<TranslateTransform
											X="0" />
									</TransformGroup>
								</Brush.RelativeTransform>
							</ImageBrush>
						</Control.Background>
						<FrameworkElement.Style>
							<Style
								TargetType="{x:Type Button}">
								<Setter
									Property="Background"
									Value="#FFFFFFFF" />
								<Setter
									Property="Template">
									<Setter.Value>
										<ControlTemplate
											TargetType="{x:Type Button}">
											<Border
												Background="{TemplateBinding Background}">
												<ContentPresenter
													HorizontalAlignment="Center"
													VerticalAlignment="Center" />
											</Border>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
								<Style.Triggers>
									<Trigger
										Property="UIElement.IsMouseOver"
										Value="True">
										<Setter
											Property="UIElement.Opacity"
											Value="0.7" />
									</Trigger>
									<Trigger
										Property="IsEnabled"
										Value="False">
										<Setter
											Property="Background"
											Value="#FF808080" />
									</Trigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
					</Button>
					<TextBlock
						Grid.Column="2"
						Text="Start Digital Download"
						Background="#00FFFFFF"
						HorizontalAlignment="Center"
						VerticalAlignment="Bottom"
						Foreground="#FFFFFFFF"
						TextAlignment="Center"
						Margin="25,0,0,0"
						FontFamily="{StaticResource MontserratRegular}"
						FontSize="{DynamicResource FontSizeHeading2}" />
				</Grid>
			</Grid>
		</Grid>
		<Grid
			Name="adsVideoGrid"
			ColumnSpan="3"
			RowSpan="5"
			Visibility="Collapsed">
			<MediaElement
				Name="videoPlayerAds"
				Visibility="Visible" />
			<Grid
				Name="SkipVideoButton"
				Background="#00000000"
				MouseDown="SkipVideoButton_Click" />
		</Grid>
	</Grid>
</Page>
