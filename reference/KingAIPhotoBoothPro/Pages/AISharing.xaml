													<Image
														Name="galleryIcon"
														Margin="5"
														Source="/Images/Samples/PartyOldManMask.jpg"
														Stretch="Fill"
														HorizontalAlignment="Stretch"
														Height="{Binding ElementName=galleryIcon, Path=ActualWidth}">
														<UIElement.OpacityMask>
															<VisualBrush
																Visual="{Binding ElementName=Mask}" />
														</UIElement.OpacityMask>
													</Image>
												</Grid>
											</Grid>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
								<Style.Triggers>
									<Trigger
										Property="UIElement.IsMouseOver"
										Value="True">
										<Setter
											Property="UIElement.Opacity"
											Value="0.9" />
									</Trigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
					</Button>
					<Grid
						Height="{Binding ElementName=gridMain, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.006+1}" />
