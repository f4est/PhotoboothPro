<Page
	x:Class="KingAIPhotoBoothPro.Pages.AISharing" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local2="clr-namespace:KingAIPhotoBoothPro.Class.UI" xmlns:local="clr-namespace:KingAIPhotoBoothPro.Pages" xmlns:class="clr-namespace:KingAIPhotoBoothPro.Class" xmlns:TermControls="clr-namespace:TermControls;assembly=TermControls" xmlns:math="http://hexinnovation.com/math" xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
	Name="AISharingXAML"
	Focusable="True"
	Title="AISharing"
	Loaded="Page_Loaded"
	Unloaded="Page_Unloaded"
	SizeChanged="pageSharing_SizeChanged"
	PreviewKeyDown="AISharingXAML_KeyDown"
	LostFocus="AISharingXAML_LostFocus">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<math:MathConverter
				x:Key="math" />
			<Storyboard
				x:Key="ExpandQR">
				<DoubleAnimation
					Storyboard.TargetName="scaleGrid"
					Storyboard.TargetProperty="ScaleX"
					To="1.4"
					Duration="0:0:0.4" />
				<DoubleAnimation
					Storyboard.TargetName="scaleGrid"
					Storyboard.TargetProperty="ScaleY"
					To="1.4"
					Duration="0:0:0.4" />
				<DoubleAnimation
					Storyboard.TargetName="moveGrid"
					Storyboard.TargetProperty="Y"
					To="-200"
					Duration="0:0:0.4" />
			</Storyboard>
			<Storyboard
				x:Key="ShrinkQR">
				<DoubleAnimation
					Storyboard.TargetName="scaleGrid"
					Storyboard.TargetProperty="ScaleX"
					To="1"
					Duration="0:0:0.4" />
				<DoubleAnimation
					Storyboard.TargetName="scaleGrid"
					Storyboard.TargetProperty="ScaleY"
					To="1"
					Duration="0:0:0.4" />
				<DoubleAnimation
					Storyboard.TargetName="moveGrid"
					Storyboard.TargetProperty="Y"
					To="0"
					Duration="0:0:0.4" />
			</Storyboard>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Background="#00FFFFFF">
		<Grid
			Name="gridMain">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="24*" />
				<RowDefinition
					Height="200*" />
				<RowDefinition
					Height="15*" />
				<RowDefinition
					Height="5*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="15*" />
				<ColumnDefinition
					Width="50*" />
				<ColumnDefinition
					Width="15*" />
			</Grid.ColumnDefinitions>
			<Grid
				Name="LeftSideGrid"
				Row="1"
				RowSpan="2">
				<ListView
					Name="listboxLeftButtons"
					HorizontalAlignment="Center"
					VerticalAlignment="Top"
					Background="#00FFFFFF"
					BorderBrush="#00FFFFFF"
					ClipToBounds="False"
					Height="auto"
					Width="{Binding ElementName=gridRightColumn, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel
								HorizontalAlignment="Center" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemContainerStyle>
						<Style
							TargetType="{x:Type ListBoxItem}">
							<Setter
								Property="Template">
								<Setter.Value>
									<ControlTemplate
										TargetType="{x:Type ListBoxItem}">
										<ContentPresenter />
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</ItemsControl.ItemContainerStyle>
					<Control.Template>
						<ControlTemplate
							TargetType="{x:Type ListBox}">
							<Border
								Name="Bd"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								Background="{TemplateBinding Background}"
								Padding="1"
								SnapsToDevicePixels="True">
								<ItemsPresenter
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger
									Property="IsEnabled"
									Value="False">
									<Setter
										TargetName="Bd"
										Value="{DynamicResource SystemColors.ControlBrushKey}"
										Property="Background" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Control.Template>
