						BlackCoverVisibility="Hidden"
						LoadingAnimationVisibility="Hidden"
						Background="#A946F7"
						Content="Ai Prompt"
						VerticalAlignment="Top"
						Height="{Binding ElementName=AIImageButton, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.275}"
						Width="{Binding ActualWidth, ConverterParameter=x*0.75, Converter={StaticResource math}, ElementName=listboxButtons}" />
					<class:ButtonIcon
						Name="FaceSwapButton"
						Click="FaceSwapButton_Click"
