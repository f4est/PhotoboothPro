						Name="GalleryButton"
						BorderThickness="0"
						Content="Gallery"
						Foreground="#FFFFFFFF"
						FontFamily="{StaticResource MontserratBold}"
						FontSize="{DynamicResource FontSizeHeading3}"
						VerticalAlignment="Top"
						FontWeight="Bold"
						Width="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.15+1}"
						Height="{Binding ElementName=GalleryButton, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.27}"
						Click="GalleryButton_Click">
						<FrameworkElement.Style>
							<Style
								TargetType="{x:Type Button}">
								<Setter
									Property="Template">
									<Setter.Value>
										<ControlTemplate
											TargetType="{x:Type Button}">
											<Grid>
												<Border
													Background="#80000000"
													CornerRadius="{Binding ElementName=GalleryButton, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x*0.5}">
													<ContentPresenter
														Margin="25,0,0,0"
														HorizontalAlignment="Center"
														VerticalAlignment="Center" />
													<UIElement.Effect>
														<DropShadowEffect
															ShadowDepth="0"
															Color="DarkOliveGreen"
															BlurRadius="200"
															Direction="0"
															Opacity="0.99"
															FrameworkElement.FlowDirection="RightToLeft" />
													</UIElement.Effect>
												</Border>
												<Grid
													Name="photosIconMask"
													Margin="0"
													HorizontalAlignment="Left"
													Width="{Binding ElementName=photosIconMask, Path=ActualHeight, Converter={StaticResource math}, ConverterParameter=x}">
													<Border
														Name="Mask"
														Background="#FFFFFFFF"
														BorderThickness="5"
														BorderBrush="#00FFFFFF"
														CornerRadius="{Binding ElementName=Mask, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.5}" />
