<Window
	x:Class="KingAIPhotoBoothPro.ActivationKingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:TermControls="clr-namespace:TermControls;assembly=TermControls" xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp" xmlns:local="clr-namespace:KingAIPhotoBoothPro" xmlns:class="clr-namespace:KingAIPhotoBoothPro.Class.ActivationKing" xmlns:math="http://hexinnovation.com/math"
	Name="m"
	WindowStyle="None"
	WindowState="Maximized"
	WindowStartupLocation="CenterScreen"
	ResizeMode="NoResize"
	Topmost="False"
	Title="ActivationKingWindow"
	Height="1080"
	Width="1920"
	KeyDown="Window_KeyDown"
	Closed="m_Closed"
	Loaded="Window_Loaded"
	PreviewTouchDown="Window_PreviewTouchDown"
	TouchMove="Window_PreviewTouchDown"
	MouseMove="m_MouseMove"
	MouseDown="m_MouseDown"
	SizeChanged="m_SizeChanged">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<math:MathConverter
				x:Key="math" />
			<Style
				TargetType="{x:Type FrameworkElement}"
				x:Key="{x:Type FrameworkElement}">
				<Setter
					Property="RenderOptions.BitmapScalingMode"
					Value="LowQuality" />
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<UIElement.InputBindings>
		<KeyBinding
			Key="F5"
			Command="{x:Static ApplicationCommands.NotACommand}" />
	</UIElement.InputBindings>
	<Grid
		Name="gridMain"
		Background="#FF000000">
		<Grid
			Name="imgLoadingBack">
			<Image
				Source="/Images/LoginPage/ActivationKingBG.jpg"
				Stretch="UniformToFill"
				HorizontalAlignment="Center" />
			<Image
				Source="/Images/Logo.png"
				Width="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.25}" />
		</Grid>
		<Frame
			Name="MainRoute"
			NavigationUIVisibility="Hidden" />
		<Grid
			Name="trailGrid"
			Visibility="Collapsed"
			IsHitTestVisible="False">
			<TextBlock
				Name="rotatedTextBlock"
				Text="ActivationKing Trial. Purchase to remove the watermark!"
				Foreground="#aaffffff"
				VerticalAlignment="Center"
				HorizontalAlignment="Center"
				FontSize="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.035}">
				<UIElement.RenderTransform>
					<TransformGroup>
						<RotateTransform
							Angle="-33" />
					</TransformGroup>
				</UIElement.RenderTransform>
				<UIElement.RenderTransformOrigin>
					<Point
						X="0.5"
						Y="0.5" />
				</UIElement.RenderTransformOrigin>
			</TextBlock>
			<TextBlock
				Text="ActivationKing Trial. Purchase to remove the watermark!"
				Margin="0,200,0,0"
				Foreground="#77000000"
				VerticalAlignment="Center"
				HorizontalAlignment="Center"
				FontSize="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.035}">
				<UIElement.RenderTransform>
					<TransformGroup>
						<RotateTransform
							x:Name="rotateTransformAngle2"
							Angle="-33" />
					</TransformGroup>
				</UIElement.RenderTransform>
				<UIElement.RenderTransformOrigin>
					<Point
						X="0.5"
						Y="0.5" />
				</UIElement.RenderTransformOrigin>
			</TextBlock>
			<TextBlock
				Text="ActivationKing Trial. Purchase to remove the watermark!"
				Margin="0,-200,0,0"
				Foreground="#77000000"
				VerticalAlignment="Center"
				HorizontalAlignment="Center"
				FontSize="{Binding ElementName=gridMain, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.035}">
				<UIElement.RenderTransform>
					<TransformGroup>
						<RotateTransform
							Angle="-33" />
					</TransformGroup>
				</UIElement.RenderTransform>
				<UIElement.RenderTransformOrigin>
					<Point
						X="0.5"
						Y="0.5" />
				</UIElement.RenderTransformOrigin>
			</TextBlock>
		</Grid>
		<Grid
			Name="ReturnEventMenuGrid"
			Visibility="Hidden"
			Background="{StaticResource UIDarkOverlay}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="10*" />
				<ColumnDefinition
					Width="13*" />
				<ColumnDefinition
					Width="10*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="1*" />
				<RowDefinition
					Height="1*" />
				<RowDefinition
					Height="1*" />
			</Grid.RowDefinitions>
			<Grid
				Name="MiddleGrid"
				Row="1"
				Column="1"
				MaxHeight="{Binding ElementName=MiddleGrid, Path=ActualWidth, Converter={StaticResource math}, ConverterParameter=x*0.45}">
				<Border
					Name="borderSmooth"
					Background="#FFFFFF"
					Margin="15"
					CornerRadius="{DynamicResource BannerCornerRadius}">
					<UIElement.Effect>
						<DropShadowEffect
							Opacity="0.25"
							BlurRadius="20"
							ShadowDepth="10" />
					</UIElement.Effect>
				</Border>
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="2*" />
						<RowDefinition
							Height="2*" />
						<RowDefinition
							Height="13*" />
						<RowDefinition
							Height="2*" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="1*" />
						<ColumnDefinition
							Width="10*" />
						<ColumnDefinition
							Width="1*" />
					</Grid.ColumnDefinitions>
					<TextBlock
						Grid.Row="1"
						Grid.ColumnSpan="4"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Foreground="{DynamicResource UIBlueButton}"
						FontWeight="Bold"
						TextAlignment="Center"
						FontSize="{DynamicResource FontSizeHeading2}">Unlock Dashboard</TextBlock>
					<Button
						Name="CloseButton"
						Grid.Column="1"
						Grid.Row="0"
						Grid.RowSpan="3"
						Grid.ColumnSpan="2"
						VerticalAlignment="Top"
						HorizontalAlignment="Right"
						Width="{DynamicResource UIInputHeight}"
						Height="{DynamicResource UIInputHeight}"
						Margin="10"
						BorderBrush="{DynamicResource UIWarningColor}"
						Click="CloseButton_Click">
						<Control.Background>
							<ImageBrush
								x:Name="ExitButtonBrush"
								ImageSource="/Images/errorIcon.png"
								Stretch="Uniform" />
						</Control.Background>
						<FrameworkElement.Style>
							<Style
								TargetType="{x:Type Button}">
								<Setter
									Property="Background"
									Value="#FFFFFFFF" />
								<Setter
									Property="Template">
									<Setter.Value>
										<ControlTemplate
											TargetType="{x:Type Button}">
											<Border
												Background="{TemplateBinding Background}">
												<ContentPresenter
													HorizontalAlignment="Center"
													VerticalAlignment="Center" />
											</Border>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
								<Style.Triggers>
									<Trigger
										Property="UIElement.IsMouseOver"
										Value="True">
										<Setter
											Property="UIElement.Opacity"
											Value="1" />
									</Trigger>
								</Style.Triggers>
							</Style>
						</FrameworkElement.Style>
					</Button>
					<Grid
						Column="1"
						Row="2">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="2*" />
							<ColumnDefinition
								Width="1*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition
								Height="1*" />
							<RowDefinition
								Height="3*" />
							<RowDefinition
								Height="2*" />
						</Grid.RowDefinitions>
						<TextBlock
							Name="debugPassText"
							Grid.Row="2"
							FontFamily="{DynamicResource PromptBold}"
							Foreground="{DynamicResource UIRedButton}"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							TextAlignment="Center"
							FontSize="{DynamicResource FontSizeTextTitle}" />
						<PasswordBox
							Name="passwordBox"
							Grid.Row="1"
							FontFamily="{DynamicResource PromptBold}"
							FontWeight="Bold"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Center"
							FontSize="{DynamicResource FontSizeHeading1}" />
						<Button
							Name="btnOk"
							x:Uid="0"
							Grid.Row="1"
							Grid.Column="1"
							BorderThickness="0"
							VerticalAlignment="Stretch"
							FontSize="{DynamicResource FontSizeHeading2}"
							Content="Verify"
							Foreground="#FFFFFFFF"
							FontFamily="{StaticResource MontserratRegular}"
							Background="{DynamicResource UIBlueButton}"
							Margin="10"
							Click="btnOk_Click">
							<UIElement.Effect>
								<DropShadowEffect
									Opacity="0.25"
									BlurRadius="20"
									ShadowDepth="10" />
							</UIElement.Effect>
							<FrameworkElement.Style>
								<Style
									TargetType="{x:Type Button}">
									<Setter
										Property="Background"
										Value="#FFFFFFFF" />
									<Setter
										Property="Template">
										<Setter.Value>
											<ControlTemplate
												TargetType="{x:Type Button}">
												<Border
													Background="{TemplateBinding Background}"
													CornerRadius="{DynamicResource BannerCornerRadius}">
													<ContentPresenter
														HorizontalAlignment="Center"
														VerticalAlignment="Center" />
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<Style.Triggers>
										<Trigger
											Property="UIElement.IsMouseOver"
											Value="True">
											<Setter
												Property="UIElement.Opacity"
												Value="0.7" />
										</Trigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
						</Button>
						<Button
							Name="ForgotPassButton"
							Grid.Row="2"
							Grid.Column="1"
							BorderThickness="0"
							Margin="0,0,0,0"
							FontFamily="{StaticResource MontserratSemiBold}"
							Click="ForgotPassButton_Click">
							<Control.Background>
								<ImageBrush
									ImageSource="/Images/Button.png"
									Stretch="Uniform" />
							</Control.Background>
							<FrameworkElement.Style>
								<Style
									TargetType="{x:Type Button}">
									<Setter
										Property="Background"
										Value="#FFFFFFFF" />
									<Setter
										Property="Template">
										<Setter.Value>
											<ControlTemplate
												TargetType="{x:Type Button}">
												<Border
													Background="{TemplateBinding Background}">
													<ContentPresenter
														HorizontalAlignment="Center"
														VerticalAlignment="Center" />
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<Style.Triggers>
										<Trigger
											Property="UIElement.IsMouseOver"
											Value="True">
											<Setter
												Property="UIElement.Opacity"
												Value="0.7" />
										</Trigger>
									</Style.Triggers>
								</Style>
							</FrameworkElement.Style>
							<TextBlock
								FontFamily="{StaticResource MontserratMedium}"
								FontSize="{DynamicResource FontSizeHeading3}"
								FontWeight="Bold"
								Foreground="{DynamicResource UIBlueButton}">Forgot Code?</TextBlock>
						</Button>
					</Grid>
				</Grid>
			</Grid>
		</Grid>
		<Grid
			Name="gridDebugConsole"
			Background="#AA000000"
			Visibility="Hidden">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="70" />
				<RowDefinition
					Height="*" />
			</Grid.RowDefinitions>
			<Border
				BorderThickness="10"
				BorderBrush="#FF008000" />
			<Border
				Grid.RowSpan="2"
				BorderThickness="10"
				BorderBrush="#FF008000" />
			<TextBlock
				Text="Developer Debug Console"
				TextAlignment="Center"
				Margin="15"
				VerticalAlignment="Center"
				Foreground="#FFFFFFFF"
				FontSize="{DynamicResource FontSizeHeading3}" />
			<TextBox
				Name="txtDebugConsole"
				Grid.Row="1"
				Margin="15"
				Background="#00FFFFFF"
				Foreground="#FFFFFFFF"
				FontSize="{DynamicResource FontSizeHeading3}"
				Text="Admin - Line:155 (10:30 10/12/2023) : Hello World"
				IsEnabled="True"
				TextChanged="txtDebugConsole_TextChanged"
				KeyDown="txtDebugConsole_KeyDown" />
		</Grid>
		<Grid
			Name="NoInternetGrid"
			Width="150"
			Height="150"
			HorizontalAlignment="Right"
			VerticalAlignment="Top"
			Visibility="Hidden">
			<Image
				Source="/Images/no-internet.png" />
		</Grid>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="19*" />
				<ColumnDefinition
					Width="1*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="1*" />
				<RowDefinition
					Height="9*" />
			</Grid.RowDefinitions>
			<Grid
				Name="GridReturn"
				Column="1"
				Background="#00000000"
				Visibility="Visible"
				MouseDown="GridReturn_MouseDown" />
		</Grid>
		<Grid
			Name="gridKeyboard"
			Visibility="Hidden">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="3*" />
				<RowDefinition
					Height="2*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="1*" />
				<ColumnDefinition
					Width="3*" />
				<ColumnDefinition
					Width="1*" />
			</Grid.ColumnDefinitions>
			<Grid
				Row="1"
				Column="1"
				Visibility="Visible">
				<Grid
					Background="#A6A6A6">
					<Button
						HorizontalAlignment="Right"
						VerticalAlignment="Top"
						Margin="5"
						Width="50"
						Height="50"
						Content="X"
						Foreground="#FFFA8072"
						FontWeight="Bold"
						FontSize="{DynamicResource FontSizeTextRegular}"
						Click="CloseKeyboardButton_Click" />
				</Grid>
				<TermControls:OnScreenKeyboard
					Name="onScreenKeyboard"
					Visibility="Visible"
					Margin="20,40,20,60" />
			</Grid>
		</Grid>
		<Grid
			Name="gridOverlay"
			Background="{DynamicResource UIDarkOverlay}"
			Visibility="Collapsed">
			<lottie:LottieAnimationView
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				AutoPlay="True"
				FileName="Animations/LoadingPill.json"
				RepeatCount="-1" />
		</Grid>
	</Grid>
</Window>
